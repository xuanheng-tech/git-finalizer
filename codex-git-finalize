#!/usr/bin/env bash

set -Eeuo pipefail

readonly VERSION="0.1"
readonly MAX_BINARY_BYTES=$((5 * 1024 * 1024))

usage() {
    cat <<'EOF'
Usage:
  codex-git-finalize --repo <absolute-repo> --message <commit-message> [--dry-run]
    [--allow-test-fixture <repo-relative-path>]... -- <file>...
  codex-git-finalize --initial-publish --remote <remote-name>
    --repo <absolute-repo> --message <commit-message> [--dry-run]
    [--allow-test-fixture <repo-relative-path>]... -- <file>...
  codex-git-finalize --resume-initial-publish <full-head-oid>
    --remote <remote-name> --repo <absolute-repo>

Options:
  --repo <path>                  Absolute path to the Git worktree root.
  --message <text>               Non-empty commit message.
  --initial-publish              Publish one root commit from an unborn branch.
  --resume-initial-publish <oid> Resume publication of one exact root commit.
  --remote <name>                Required by initial and resume modes.
  --allow-test-fixture <path>    Ignore content secret signatures for this exact tests/ file.
  --dry-run                      Report scope and risks without add, commit, fetch, or push.
  -h, --help                     Show this help.
EOF
}

fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

fail_after_commit() {
    printf 'ERROR: %s\n' "$*" >&2
    printf '本地提交 %s 已创建，但未完成 push；未执行 pull、rebase、merge 或 reset。\n' "$commit_hash" >&2
    exit 1
}

fail_initial_after_commit() {
    printf 'ERROR: %s\n' "$*" >&2
    printf '本地 root commit %s 已保留；不得重跑 --initial-publish。\n' "$commit_hash" >&2
    printf '恢复入口:\n' >&2
    printf '  codex-git-finalize --resume-initial-publish %s --remote %q --repo %q\n' \
        "$commit_hash" "$initial_remote" "$repo" >&2
    exit 1
}

fail_resume_retryable() {
    printf 'ERROR: %s\n' "$*" >&2
    printf '本地 HEAD %s 保持不变；可安全再次运行同一恢复命令:\n' \
        "$resume_expected_oid" >&2
    printf '  codex-git-finalize --resume-initial-publish %s --remote %q --repo %q\n' \
        "$resume_expected_oid" "$resume_remote" "$repo" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "缺少必需命令: $1"
}

print_value_or() {
    local value=$1
    local empty_value=$2

    if [[ -n "$value" ]]; then
        printf '%s\n' "$value"
    else
        printf '%s\n' "$empty_value"
    fi
}

print_path() {
    printf '  - %q\n' "$1"
}

redact_stream() {
    sed -E \
        -e 's#(https?://)[^/@[:space:]]+@#\1[redacted]@#g' \
        -e 's#([?&](access_token|auth|credential|password|secret|token)=)[^&[:space:]]+#\1[redacted]#gI' \
        -e 's#(github_pat_|gh[pousr]_|sk-(proj-)?|xox[baprs]-)[A-Za-z0-9_.-]{8,}#\1[redacted]#g'
}

run_git_mutation() {
    local display=$1
    shift
    local output
    local status

    printf '$ %s\n' "$display"
    if output=$("$@" 2>&1); then
        if [[ -n "$output" ]]; then
            printf '%s\n' "$output" | redact_stream
        fi
        return 0
    else
        status=$?
        if [[ -n "$output" ]]; then
            printf '%s\n' "$output" | redact_stream >&2
        fi
        return "$status"
    fi
}

run_git_remote_command() {
    local display=$1
    shift
    local status

    printf '$ %s\n' "$display"
    if "$@" >/dev/null 2>&1; then
        printf '(completed)\n'
        return 0
    else
        status=$?
        printf 'remote check failed (exit %s)\n' "$status" >&2
        return "$status"
    fi
}

sensitive_path_reason() {
    local path=${1,,}
    local env_re='(^|/)\.env($|[._-])'
    local marker_re='(^|[/._ -])(credentials?|secrets?|tokens?)([/._ -]|$)'
    local key_re='(^|[/._ -])(private|ssh)[._ -]?key([/._ -]|$)'
    local ssh_name_re='(^|/)(id_rsa|id_dsa|id_ecdsa|id_ed25519)(\.pub)?$'

    if [[ $path =~ $env_re ]]; then
        printf '.env 路径'
        return 0
    fi
    if [[ $path =~ $marker_re ]]; then
        printf 'credential/secret/token 路径标记'
        return 0
    fi
    if [[ $path =~ $key_re ]] || [[ $path =~ $ssh_name_re ]]; then
        printf 'private key/SSH key 路径标记'
        return 0
    fi
    return 1
}

working_content_reason() {
    local path=$1
    local private_key_re='-----BEGIN ([A-Z0-9]+[[:space:]]+)*PRIVATE KEY-----'
    local known_token_re='(AKIA[0-9A-Z]{16}|github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9_]{20,}|sk-(proj-)?[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{16,})'
    local ssh_key_re='(^|[[:space:]])ssh-(rsa|dss|ecdsa|ed25519)[[:space:]]+[A-Za-z0-9+/]{40,}'
    local assignment_re="(credential|password|passwd|secret|token|api[_-]?key|client[_-]?secret|access[_-]?token|refresh[_-]?token)[[:space:]]*[:=][[:space:]]*['\"][^'\"]{12,}['\"]"

    if LC_ALL=C grep -aEiq -- "$private_key_re" "$path"; then
        printf 'private key 内容签名'
        return 0
    fi
    if LC_ALL=C grep -aEiq -- "$known_token_re" "$path"; then
        printf '高置信度 token/credential 内容签名'
        return 0
    fi
    if LC_ALL=C grep -aEiq -- "$ssh_key_re" "$path"; then
        printf 'SSH key 内容签名'
        return 0
    fi
    if LC_ALL=C grep -aEiq -- "$assignment_re" "$path"; then
        printf '疑似硬编码 credential/secret/token'
        return 0
    fi
    return 1
}

staged_content_reason() {
    local oid=$1
    local private_key_re='-----BEGIN ([A-Z0-9]+[[:space:]]+)*PRIVATE KEY-----'
    local known_token_re='(AKIA[0-9A-Z]{16}|github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9_]{20,}|sk-(proj-)?[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{16,})'
    local ssh_key_re='(^|[[:space:]])ssh-(rsa|dss|ecdsa|ed25519)[[:space:]]+[A-Za-z0-9+/]{40,}'
    local assignment_re="(credential|password|passwd|secret|token|api[_-]?key|client[_-]?secret|access[_-]?token|refresh[_-]?token)[[:space:]]*[:=][[:space:]]*['\"][^'\"]{12,}['\"]"

    if LC_ALL=C grep -aEiq -- "$private_key_re" < <(git -C "$repo" cat-file blob "$oid" 2>/dev/null); then
        printf 'private key 内容签名'
        return 0
    fi
    if LC_ALL=C grep -aEiq -- "$known_token_re" < <(git -C "$repo" cat-file blob "$oid" 2>/dev/null); then
        printf '高置信度 token/credential 内容签名'
        return 0
    fi
    if LC_ALL=C grep -aEiq -- "$ssh_key_re" < <(git -C "$repo" cat-file blob "$oid" 2>/dev/null); then
        printf 'SSH key 内容签名'
        return 0
    fi
    if LC_ALL=C grep -aEiq -- "$assignment_re" < <(git -C "$repo" cat-file blob "$oid" 2>/dev/null); then
        printf '疑似硬编码 credential/secret/token'
        return 0
    fi
    return 1
}

is_working_large_binary() {
    local path=$1
    local size

    [[ -f "$path" && ! -L "$path" ]] || return 1
    size=$(stat -c '%s' -- "$path") || return 1
    ((size > MAX_BINARY_BYTES)) || return 1
    if LC_ALL=C grep -Iq -- . "$path"; then
        return 1
    fi
    return 0
}

get_index_entry() {
    local path=$1
    local entry
    local metadata

    entry=$(git -C "$repo" --literal-pathspecs ls-files -s -- "$path") || return 1
    [[ -n "$entry" && "$entry" == *$'\t'* ]] || return 1
    metadata=${entry%%$'\t'*}
    read -r index_mode index_oid index_stage <<<"$metadata"
    [[ "$index_stage" == "0" ]]
}

is_staged_large_binary() {
    local path=$1
    local size
    local numstat

    get_index_entry "$path" || return 1
    [[ $(git -C "$repo" cat-file -t "$index_oid" 2>/dev/null) == "blob" ]] || return 1
    size=$(git -C "$repo" cat-file -s "$index_oid") || return 1
    ((size > MAX_BINARY_BYTES)) || return 1
    numstat=$(git -C "$repo" --literal-pathspecs diff --cached --numstat --no-renames -- "$path")
    [[ "$numstat" == $'-\t-\t'* ]]
}

collect_staged_paths() {
    mapfile -d '' -t staged_paths < <(
        git -C "$repo" --literal-pathspecs diff --cached --name-only --no-renames -z
    )
}

check_staged_scope() {
    local path

    collect_staged_paths
    for path in "${staged_paths[@]}"; do
        if [[ -z ${allowed_paths[$path]+present} ]]; then
            fail "staged 文件超出显式范围: $(printf '%q' "$path")"
        fi
    done
}

check_test_fixture_staged_scope() {
    local path
    declare -A current_staged_paths=()

    ((${#test_fixture_paths[@]} > 0)) || return 0
    for path in "${staged_paths[@]}"; do
        current_staged_paths["$path"]=1
    done
    for path in "${paths[@]}"; do
        [[ -n ${current_staged_paths[$path]+present} ]] ||
            fail "test fixture 例外要求 staged 范围精确等于显式文件范围: $(printf '%q' "$path")"
    done
    for path in "${test_fixture_paths[@]}"; do
        get_index_entry "$path" ||
            fail "test fixture 必须作为普通文件出现在 staged 范围: $(printf '%q' "$path")"
        [[ "$index_mode" == '100644' || "$index_mode" == '100755' ]] ||
            fail "test fixture staged 条目必须是普通文件: $(printf '%q' "$path")"
    done
}

print_snapshot() {
    local head
    local status
    local remotes

    current_branch=$(git -C "$repo" branch --show-current)
    if ! head=$(git -C "$repo" rev-parse HEAD 2>/dev/null); then
        head='(unborn HEAD)'
    fi
    status=$(git -C "$repo" status --short)
    remotes=$(git -C "$repo" remote)
    if ! current_upstream=$(
        git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null
    ); then
        current_upstream=''
    fi

    printf '\n== Git Finalizer v%s: 提交前状态 ==\n' "$VERSION"
    printf '$ git branch --show-current\n'
    print_value_or "$current_branch" '(detached)'
    printf '$ git rev-parse HEAD\n%s\n' "$head"
    printf '$ git status --short\n'
    print_value_or "$status" '(clean)'
    printf '$ git remote\n'
    if [[ -n "$remotes" ]]; then
        printf '%s\n' "$remotes"
    else
        printf '(none)\n'
    fi
    printf '$ git rev-parse --abbrev-ref --symbolic-full-name @{upstream}\n'
    print_value_or "$current_upstream" '(none)'
}

resolve_normal_target() {
    local head_ref
    local show_ref_status
    local upstream_details
    local branch_remote_values
    local branch_merge_values
    local branch_push_remote
    local default_push_remote
    local effective_push_remote
    local fetch_urls
    local push_urls

    normal_target_error=''
    [[ -n "$current_branch" ]] || {
        normal_target_error='当前为 detached HEAD，拒绝 commit'
        return 1
    }

    if ! head_ref=$(git -C "$repo" symbolic-ref --quiet HEAD 2>/dev/null); then
        normal_target_error='当前 HEAD 不是 symbolic attached branch，拒绝 commit'
        return 1
    fi
    [[ "$head_ref" == "refs/heads/$current_branch" ]] || {
        normal_target_error='当前 symbolic HEAD 与 branch 名不一致，拒绝 commit'
        return 1
    }

    if ! git -C "$repo" rev-parse --verify 'HEAD^{commit}' >/dev/null 2>&1; then
        if git -C "$repo" show-ref --verify --quiet "$head_ref"; then
            normal_target_error='当前 HEAD 无法解析为 commit，拒绝 commit'
        else
            show_ref_status=$?
            if ((show_ref_status == 1)); then
                normal_target_error='当前为 unborn HEAD；正常模式拒绝 commit'
            else
                normal_target_error='当前 branch ref 无效，拒绝 commit'
            fi
        fi
        return 1
    fi

    if ! upstream_details=$(
        git -C "$repo" for-each-ref \
            --format='%(upstream:short)%09%(upstream:remotename)%09%(upstream:remoteref)' \
            "$head_ref"
    ); then
        normal_target_error='无法解析当前分支 upstream'
        return 1
    fi
    if [[ -z "$upstream_details" || "$upstream_details" == *$'\n'* ]]; then
        normal_target_error='当前分支不存在唯一可解析的 upstream'
        return 1
    fi
    IFS=$'\t' read -r upstream_name upstream_remote upstream_branch_ref <<<"$upstream_details"
    if [[ -z "$upstream_name" || -z "$upstream_remote" ||
        "$upstream_remote" == '.' || "$upstream_branch_ref" != refs/heads/* ]]; then
        normal_target_error='upstream 不是可验证的远端 branch'
        return 1
    fi

    branch_remote_values=$(
        git -C "$repo" config --get-all "branch.$current_branch.remote" 2>/dev/null || true
    )
    branch_merge_values=$(
        git -C "$repo" config --get-all "branch.$current_branch.merge" 2>/dev/null || true
    )
    if [[ -z "$branch_remote_values" || "$branch_remote_values" == *$'\n'* ||
        "$branch_remote_values" != "$upstream_remote" || -z "$branch_merge_values" ||
        "$branch_merge_values" == *$'\n'* || "$branch_merge_values" != "$upstream_branch_ref" ]]; then
        normal_target_error='upstream 配置缺失、含糊或与远端 branch 不一致'
        return 1
    fi

    branch_push_remote=$(
        git -C "$repo" config --get-all "branch.$current_branch.pushRemote" 2>/dev/null || true
    )
    default_push_remote=$(git -C "$repo" config --get-all remote.pushDefault 2>/dev/null || true)
    if [[ "$branch_push_remote" == *$'\n'* || "$default_push_remote" == *$'\n'* ]]; then
        normal_target_error='push remote 配置含糊，无法证明唯一 push 目标'
        return 1
    fi
    effective_push_remote=${branch_push_remote:-${default_push_remote:-$upstream_remote}}
    [[ "$effective_push_remote" == "$upstream_remote" ]] || {
        normal_target_error='实际 push remote 与 upstream remote 不一致'
        return 1
    }

    if ! fetch_urls=$(git -C "$repo" remote get-url --all "$upstream_remote" 2>/dev/null) ||
        [[ -z "$fetch_urls" || "$fetch_urls" == *$'\n'* ]]; then
        normal_target_error='upstream remote 缺失或配置了多个 fetch endpoint'
        return 1
    fi
    if ! push_urls=$(git -C "$repo" remote get-url --push --all "$upstream_remote" 2>/dev/null) ||
        [[ -z "$push_urls" || "$push_urls" == *$'\n'* ]]; then
        normal_target_error='upstream remote 缺失或配置了多个 push endpoint'
        return 1
    fi
    [[ "$fetch_urls" == "$push_urls" ]] || {
        normal_target_error='upstream 的 fetch 与 push endpoint 不一致'
        return 1
    }
}

query_remote_branch() {
    local output
    local status
    local ref_name
    local extra

    remote_query_error=''
    if output=$(
        git -C "$repo" ls-remote --quiet --refs "$upstream_remote" \
            "$upstream_branch_ref" 2>/dev/null
    ); then
        :
    else
        status=$?
        remote_query_error="远端 branch 查询失败（exit $status）"
        return 1
    fi
    if [[ -z "$output" ]]; then
        remote_query_error="远端 branch 不存在: $upstream_branch_ref"
        return 1
    fi
    if [[ "$output" == *$'\n'* ]]; then
        remote_query_error="远端 branch 查询返回含糊结果: $upstream_branch_ref"
        return 1
    fi

    IFS=$'\t' read -r remote_branch_oid ref_name extra <<<"$output"
    if [[ ! "$remote_branch_oid" =~ ^[0-9a-f]+$ ||
        "$ref_name" != "$upstream_branch_ref" || -n "$extra" ]]; then
        remote_query_error="远端 branch 查询结果无效: $upstream_branch_ref"
        return 1
    fi
}

check_normal_remote_state() {
    local phase=$1
    local local_hash
    local upstream_hash
    local counts
    local ahead
    local behind

    normal_remote_error=''
    if ! run_git_remote_command 'git fetch <upstream remote>' \
        git -C "$repo" fetch --no-tags --no-recurse-submodules "$upstream_remote"; then
        normal_remote_error="$phase git fetch 失败"
        return 1
    fi
    if ! query_remote_branch; then
        normal_remote_error="$phase $remote_query_error"
        return 1
    fi
    if ! upstream_hash=$(git -C "$repo" rev-parse --verify '@{upstream}^{commit}' 2>/dev/null); then
        normal_remote_error="$phase upstream 无法解析为 commit: $upstream_name"
        return 1
    fi
    if [[ "$upstream_hash" != "$remote_branch_oid" ]]; then
        normal_remote_error="$phase fetch 后 upstream 与远端 branch OID 不一致"
        return 1
    fi
    if ! local_hash=$(git -C "$repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null); then
        normal_remote_error="$phase HEAD 无法解析为 commit"
        return 1
    fi
    if ! counts=$(
        git -C "$repo" rev-list --left-right --count "$local_hash...$upstream_hash" 2>/dev/null
    ); then
        normal_remote_error="$phase 无法计算 HEAD 与 upstream 的 ahead/behind"
        return 1
    fi
    read -r ahead behind <<<"$counts"
    if [[ ! "$ahead" =~ ^[0-9]+$ || ! "$behind" =~ ^[0-9]+$ ]]; then
        normal_remote_error="$phase ahead/behind 输出无效"
        return 1
    fi
    if ((behind > 0)); then
        if ((ahead > 0)); then
            normal_remote_error="$phase 本地已与 upstream 分叉（HEAD...upstream ahead/behind: $ahead/$behind）"
        else
            normal_remote_error="$phase 本地落后 upstream（HEAD...upstream ahead/behind: $ahead/$behind）"
        fi
        return 1
    fi

    printf 'upstream: %s\n' "$upstream_name"
    printf 'remote branch: %s\n' "$upstream_branch_ref"
    printf 'ahead/behind: %s/%s\n' "$ahead" "$behind"
    printf 'fast-forward check: passed\n'
}

resolve_initial_target() {
    local symbolic_head
    local show_ref_status
    local existing_commit
    local branch_remote_values
    local branch_merge_values
    local configured_remotes
    local fetch_urls
    local push_urls

    initial_target_error=''
    if ! symbolic_head=$(git -C "$repo" symbolic-ref --quiet HEAD 2>/dev/null); then
        initial_target_error='initial-publish 要求 symbolic attached branch'
        return 1
    fi
    if [[ "$symbolic_head" != refs/heads/* || "$symbolic_head" == 'refs/heads/' ]]; then
        initial_target_error='initial-publish 的 symbolic HEAD 不是本地 branch'
        return 1
    fi
    initial_branch_ref=$symbolic_head
    initial_branch=${initial_branch_ref#refs/heads/}
    if [[ "$current_branch" != "$initial_branch" ]]; then
        initial_target_error='symbolic HEAD 与当前 branch 名不一致'
        return 1
    fi

    if git -C "$repo" show-ref --verify --quiet "$initial_branch_ref"; then
        initial_target_error='initial-publish 只接受 branch ref 尚不存在的 unborn 仓库'
        return 1
    else
        show_ref_status=$?
        if ((show_ref_status != 1)); then
            initial_target_error='无法安全确认当前 branch ref 尚不存在'
            return 1
        fi
    fi
    if git -C "$repo" rev-parse --verify 'HEAD^{commit}' >/dev/null 2>&1; then
        initial_target_error='initial-publish 不接受已有 HEAD commit 的仓库'
        return 1
    fi
    if ! existing_commit=$(git -C "$repo" rev-list --all --max-count=1 2>/dev/null); then
        initial_target_error='无法确认本地仓库不存在可解析 commit'
        return 1
    fi
    if [[ -n "$existing_commit" ]]; then
        initial_target_error='initial-publish 不接受已有可解析 commit 的仓库'
        return 1
    fi

    branch_remote_values=$(
        git -C "$repo" config --get-all "branch.$initial_branch.remote" 2>/dev/null || true
    )
    branch_merge_values=$(
        git -C "$repo" config --get-all "branch.$initial_branch.merge" 2>/dev/null || true
    )
    if [[ -n "$current_upstream" || -n "$branch_remote_values" || -n "$branch_merge_values" ]]; then
        initial_target_error='initial-publish 要求当前 unborn branch 未配置 upstream'
        return 1
    fi

    if [[ -z "$remote_arg" || "$remote_arg" == -* ||
        "$remote_arg" == *$'\n'* || "$remote_arg" == *$'\r'* || "$remote_arg" == *$'\t'* ]]; then
        initial_target_error='--remote 必须是有效的已配置 remote 名'
        return 1
    fi
    if ! configured_remotes=$(git -C "$repo" remote 2>/dev/null); then
        initial_target_error='无法读取已配置 remote'
        return 1
    fi
    if ! grep -Fxq -- "$remote_arg" <<<"$configured_remotes"; then
        initial_target_error="未配置指定 remote: $remote_arg"
        return 1
    fi
    initial_remote=$remote_arg

    if ! fetch_urls=$(git -C "$repo" remote get-url --all "$initial_remote" 2>/dev/null) ||
        [[ -z "$fetch_urls" || "$fetch_urls" == *$'\n'* ]]; then
        initial_target_error='initial remote 缺失或配置了多个 fetch endpoint'
        return 1
    fi
    if ! push_urls=$(git -C "$repo" remote get-url --push --all "$initial_remote" 2>/dev/null) ||
        [[ -z "$push_urls" || "$push_urls" == *$'\n'* ]]; then
        initial_target_error='initial remote 缺失或配置了多个 push endpoint'
        return 1
    fi
    if [[ "$fetch_urls" != "$push_urls" ]]; then
        initial_target_error='initial remote 的 fetch 与 push endpoint 不一致'
        return 1
    fi
}

check_initial_worktree_scope() {
    local entry
    local path

    initial_scope_error=''
    while IFS= read -r -d '' entry; do
        if ((${#entry} < 4)); then
            initial_scope_error='无法解析 initial-publish worktree 状态'
            return 1
        fi
        path=${entry:3}
        if [[ -z ${allowed_paths[$path]+present} ]]; then
            initial_scope_error="initial-publish 存在显式范围外改动: $(printf '%q' "$path")"
            return 1
        fi
    done < <(
        git -C "$repo" --literal-pathspecs status --porcelain=v1 -z --untracked-files=all
    )
}

check_initial_remote_empty() {
    local output
    local status

    initial_remote_error=''
    if output=$(git -C "$repo" ls-remote --quiet "$initial_remote" 2>/dev/null); then
        :
    else
        status=$?
        initial_remote_error="远端空状态查询失败（exit $status）"
        return 1
    fi
    if [[ -n "$output" ]]; then
        initial_remote_error='远端不是完全空 remote'
        return 1
    fi
    printf 'remote empty check: passed\n'
}

verify_initial_root_commit() {
    local resolved_head
    local parent_line
    local symbolic_head
    local path
    declare -A expected_paths=()

    initial_commit_error=''
    if ! resolved_head=$(git -C "$repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null) ||
        [[ "$resolved_head" != "$commit_hash" ]]; then
        initial_commit_error='root commit 后 HEAD 无法精确解析'
        return 1
    fi
    if ! parent_line=$(git -C "$repo" rev-list --parents -n 1 "$commit_hash" 2>/dev/null) ||
        [[ "$parent_line" != "$commit_hash" ]]; then
        initial_commit_error='initial-publish 创建的 commit 不是 root commit'
        return 1
    fi
    if ((${#committed_paths[@]} == 0)); then
        initial_commit_error='initial-publish 不允许空 root commit'
        return 1
    fi
    if ((${#committed_paths[@]} != ${#staged_paths[@]})); then
        initial_commit_error='root commit 文件范围与 staged 范围不一致'
        return 1
    fi
    for path in "${staged_paths[@]}"; do
        expected_paths["$path"]=1
    done
    for path in "${committed_paths[@]}"; do
        if [[ -z ${expected_paths[$path]+present} ]]; then
            initial_commit_error='root commit 文件范围与 staged 范围不一致'
            return 1
        fi
    done
    if ! symbolic_head=$(git -C "$repo" symbolic-ref --quiet HEAD 2>/dev/null) ||
        [[ "$symbolic_head" != "$initial_branch_ref" ]]; then
        initial_commit_error='root commit 后 symbolic branch 发生变化'
        return 1
    fi
}

query_initial_published_remote() {
    local output
    local status
    local ref_name
    local extra

    initial_remote_error=''
    if output=$(git -C "$repo" ls-remote --quiet --refs "$initial_remote" 2>/dev/null); then
        :
    else
        status=$?
        initial_remote_error="push 后远端 ref 查询失败（exit $status）"
        return 1
    fi
    if [[ -z "$output" || "$output" == *$'\n'* ]]; then
        initial_remote_error='push 后远端 ref 集合不是唯一目标 branch'
        return 1
    fi
    IFS=$'\t' read -r initial_remote_oid ref_name extra <<<"$output"
    if [[ ! "$initial_remote_oid" =~ ^[0-9a-f]+$ ||
        "$ref_name" != "$initial_branch_ref" || -n "$extra" ]]; then
        initial_remote_error='push 后远端 ref 集合不是唯一目标 branch'
        return 1
    fi
}

inspect_resume_upstream() {
    local branch_remote_values
    local branch_merge_values
    local resolved_upstream

    resume_upstream_error=''
    resume_upstream_present=0
    branch_remote_values=$(
        git -C "$repo" config --get-all "branch.$resume_branch.remote" 2>/dev/null || true
    )
    branch_merge_values=$(
        git -C "$repo" config --get-all "branch.$resume_branch.merge" 2>/dev/null || true
    )
    if [[ -z "$branch_remote_values" && -z "$branch_merge_values" ]]; then
        return 0
    fi
    if [[ -z "$branch_remote_values" || -z "$branch_merge_values" ||
        "$branch_remote_values" == *$'\n'* || "$branch_merge_values" == *$'\n'* ]]; then
        resume_upstream_error='resume upstream 配置缺失或含糊'
        return 1
    fi
    if [[ "$branch_remote_values" != "$resume_remote" ||
        "$branch_merge_values" != "$resume_branch_ref" ]]; then
        resume_upstream_error='resume upstream 与 selected remote/branch 不一致'
        return 1
    fi
    if ! resolved_upstream=$(
        git -C "$repo" rev-parse --verify '@{upstream}^{commit}' 2>/dev/null
    ); then
        resume_upstream_error='resume upstream 已配置但无法解析为 commit'
        return 1
    fi
    if [[ "$resolved_upstream" != "$resume_expected_oid" ]]; then
        resume_upstream_error='resume upstream commit 与 expected HEAD 不一致'
        return 1
    fi
    resume_upstream_present=1
}

resolve_resume_target() {
    local symbolic_head
    local object_format
    local oid_length
    local resolved_head
    local parent_line
    local tree_paths
    local resume_status
    local git_dir
    local marker
    local configured_remotes
    local fetch_urls
    local push_urls

    resume_target_error=''
    if ! symbolic_head=$(git -C "$repo" symbolic-ref --quiet HEAD 2>/dev/null); then
        resume_target_error='resume 要求 symbolic attached branch'
        return 1
    fi
    if [[ "$symbolic_head" != refs/heads/* || "$symbolic_head" == 'refs/heads/' ]]; then
        resume_target_error='resume symbolic HEAD 不是本地 branch'
        return 1
    fi
    resume_branch_ref=$symbolic_head
    resume_branch=${resume_branch_ref#refs/heads/}
    if [[ "$current_branch" != "$resume_branch" ]]; then
        resume_target_error='resume symbolic HEAD 与当前 branch 名不一致'
        return 1
    fi

    if ! object_format=$(
        git -C "$repo" rev-parse --show-object-format=storage 2>/dev/null
    ); then
        resume_target_error='无法确定当前 Git object format'
        return 1
    fi
    case "$object_format" in
        sha1) oid_length=40 ;;
        sha256) oid_length=64 ;;
        *)
            resume_target_error='不支持当前 Git object format'
            return 1
            ;;
    esac
    if ((${#resume_expected_oid} != oid_length)) ||
        [[ ! "$resume_expected_oid" =~ ^[0-9a-f]+$ ]]; then
        resume_target_error="expected HEAD 必须是 $object_format 的完整小写十六进制 OID"
        return 1
    fi
    if ! resolved_head=$(git -C "$repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null); then
        resume_target_error='resume HEAD 无法解析为 commit'
        return 1
    fi
    if [[ "$resolved_head" != "$resume_expected_oid" ]]; then
        resume_target_error='当前 HEAD 与 expected HEAD 不一致'
        return 1
    fi
    resume_head=$resolved_head
    if ! parent_line=$(git -C "$repo" rev-list --parents -n 1 "$resume_head" 2>/dev/null) ||
        [[ "$parent_line" != "$resume_head" ]]; then
        resume_target_error='resume 只接受无 parent 的 root commit'
        return 1
    fi
    if ! tree_paths=$(git -C "$repo" ls-tree -r --name-only "$resume_head" 2>/dev/null) ||
        [[ -z "$tree_paths" ]]; then
        resume_target_error='resume root commit tree 不能为空'
        return 1
    fi
    if ! git -C "$repo" diff --cached --quiet; then
        resume_target_error='resume 要求 index/staged 状态干净'
        return 1
    fi
    resume_status=$(
        GIT_OPTIONAL_LOCKS=0 git -C "$repo" status --porcelain=v1 --untracked-files=all
    )
    if [[ -n "$resume_status" ]]; then
        resume_target_error='resume 要求 worktree 完全干净（包括 untracked 文件）'
        return 1
    fi
    if ! git_dir=$(git -C "$repo" rev-parse --absolute-git-dir 2>/dev/null); then
        resume_target_error='无法解析 Git metadata 目录'
        return 1
    fi
    for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD REBASE_HEAD \
        rebase-apply rebase-merge sequencer BISECT_START; do
        if [[ -e "$git_dir/$marker" ]]; then
            resume_target_error='resume 拒绝未完成的 Git 操作'
            return 1
        fi
    done

    if ! configured_remotes=$(git -C "$repo" remote 2>/dev/null); then
        resume_target_error='无法读取已配置 remote'
        return 1
    fi
    if ! grep -Fxq -- "$remote_arg" <<<"$configured_remotes"; then
        resume_target_error="未配置指定 remote: $remote_arg"
        return 1
    fi
    resume_remote=$remote_arg
    if ! fetch_urls=$(git -C "$repo" remote get-url --all "$resume_remote" 2>/dev/null) ||
        [[ -z "$fetch_urls" || "$fetch_urls" == *$'\n'* ]]; then
        resume_target_error='resume remote 缺失或配置了多个 fetch endpoint'
        return 1
    fi
    if ! push_urls=$(git -C "$repo" remote get-url --push --all "$resume_remote" 2>/dev/null) ||
        [[ -z "$push_urls" || "$push_urls" == *$'\n'* ]]; then
        resume_target_error='resume remote 缺失或配置了多个 push endpoint'
        return 1
    fi
    if [[ "$fetch_urls" != "$push_urls" ]]; then
        resume_target_error='resume remote 的 fetch 与 push endpoint 不一致'
        return 1
    fi
    if ! inspect_resume_upstream; then
        resume_target_error=$resume_upstream_error
        return 1
    fi
}

classify_resume_remote() {
    local output
    local status
    local remote_oid
    local remote_ref
    local extra

    resume_remote_error=''
    resume_remote_state=''
    if output=$(git -C "$repo" ls-remote --quiet --refs "$resume_remote" 2>/dev/null); then
        :
    else
        status=$?
        resume_remote_error="resume 远端 ref 查询失败（exit $status）"
        return 1
    fi
    if [[ -z "$output" ]]; then
        resume_remote_state='A'
        return 0
    fi
    if [[ "$output" == *$'\n'* ]]; then
        resume_remote_state='C'
        resume_remote_error='远端存在额外或含糊的 refs'
        return 0
    fi
    IFS=$'\t' read -r remote_oid remote_ref extra <<<"$output"
    if [[ ! "$remote_oid" =~ ^[0-9a-f]+$ || -n "$extra" ]]; then
        resume_remote_state='C'
        resume_remote_error='远端 ref 输出无法安全解析'
        return 0
    fi
    if [[ "$remote_ref" == "$resume_branch_ref" &&
        "$remote_oid" == "$resume_expected_oid" ]]; then
        resume_remote_state='B'
        resume_remote_oid=$remote_oid
        return 0
    fi
    resume_remote_state='C'
    if [[ "$remote_ref" == "$resume_branch_ref" ]]; then
        resume_remote_error='远端目标 branch 指向其他 OID'
    else
        resume_remote_error='远端存在非目标 ref'
    fi
}

run_resume_push() {
    run_git_remote_command \
        'git push --set-upstream --no-follow-tags <remote> HEAD:<branch>' \
        git -C "$repo" push --set-upstream --no-follow-tags \
        "$resume_remote" "HEAD:$resume_branch_ref"
}

verify_resume_result() {
    local final_head
    local parent_line
    local final_upstream
    local final_counts
    local final_status
    local symbolic_head

    resume_verify_error=''
    if ! final_head=$(git -C "$repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null) ||
        [[ "$final_head" != "$resume_expected_oid" ]]; then
        resume_verify_error='恢复后 HEAD 与 expected OID 不一致'
        return 1
    fi
    if ! parent_line=$(git -C "$repo" rev-list --parents -n 1 "$final_head" 2>/dev/null) ||
        [[ "$parent_line" != "$final_head" ]] ||
        [[ $(git -C "$repo" rev-list --count "$final_head") != 1 ]]; then
        resume_verify_error='恢复后 HEAD 不再是唯一 root commit'
        return 1
    fi
    if ! symbolic_head=$(git -C "$repo" symbolic-ref --quiet HEAD 2>/dev/null) ||
        [[ "$symbolic_head" != "$resume_branch_ref" ]]; then
        resume_verify_error='恢复后 symbolic branch 发生变化'
        return 1
    fi
    if ! classify_resume_remote; then
        resume_verify_error=$resume_remote_error
        return 1
    fi
    if [[ "$resume_remote_state" != 'B' ]]; then
        resume_verify_error="恢复后远端不是精确期望状态: $resume_remote_error"
        return 1
    fi
    if ! inspect_resume_upstream || ((resume_upstream_present == 0)); then
        resume_verify_error=${resume_upstream_error:-'恢复后 upstream 尚未建立'}
        return 1
    fi
    if ! final_upstream=$(
        git -C "$repo" rev-parse --verify '@{upstream}^{commit}' 2>/dev/null
    ) || [[ "$final_upstream" != "$final_head" ]]; then
        resume_verify_error='恢复后 upstream commit 与 HEAD 不一致'
        return 1
    fi
    if ! final_counts=$(
        git -C "$repo" rev-list --left-right --count "$final_head...$final_upstream" 2>/dev/null
    ) || [[ "$final_counts" != $'0\t0' ]]; then
        resume_verify_error='恢复后 HEAD 与 upstream ahead/behind 不是 0/0'
        return 1
    fi
    if ! git -C "$repo" diff --cached --quiet; then
        resume_verify_error='恢复后 index 不干净'
        return 1
    fi
    final_status=$(
        GIT_OPTIONAL_LOCKS=0 git -C "$repo" status --porcelain=v1 --untracked-files=all
    )
    if [[ -n "$final_status" ]]; then
        resume_verify_error='恢复后 worktree 不干净'
        return 1
    fi

    printf 'HEAD: %s\n' "$final_head"
    printf 'upstream: %s\n' "$final_upstream"
    printf 'remote branch OID: %s\n' "$resume_remote_oid"
    printf 'ahead/behind: %s\n' "$final_counts"
    printf 'worktree: clean\n'
}

resume_initial_publish() {
    local need_push=0
    local second_push=0

    export GIT_OPTIONAL_LOCKS=0
    print_snapshot
    if ! resolve_resume_target; then
        fail "$resume_target_error"
    fi

    printf '\n== Resume initial publish ==\n'
    printf 'expected HEAD: %s\n' "$resume_expected_oid"
    printf 'branch: %s\n' "$resume_branch"
    printf 'remote: %s\n' "$resume_remote"

    if ! classify_resume_remote; then
        fail "$resume_remote_error"
    fi
    case "$resume_remote_state" in
        A) need_push=1 ;;
        B)
            if ((resume_upstream_present == 0)); then
                need_push=1
            fi
            ;;
        C) fail "远端处于冲突或含糊状态；拒绝恢复: $resume_remote_error" ;;
    esac

    if ((need_push == 1)); then
        printf '\n== Resume push ==\n'
        if ! run_resume_push; then
            if ! classify_resume_remote; then
                fail "$resume_remote_error"
            fi
            case "$resume_remote_state" in
                A)
                    fail_resume_retryable 'resume push 失败且远端仍为空'
                    ;;
                C)
                    fail "resume push 后远端进入冲突或含糊状态: $resume_remote_error"
                    ;;
                B)
                    if ! inspect_resume_upstream; then
                        if [[ "$resume_upstream_error" != \
                            'resume upstream 已配置但无法解析为 commit' ]]; then
                            fail "$resume_upstream_error"
                        fi
                        resume_upstream_present=0
                    fi
                    if ((resume_upstream_present == 0)); then
                        second_push=1
                    fi
                    ;;
            esac
        fi
    fi

    if ((second_push == 1)); then
        printf '\n== Resume up-to-date push ==\n'
        if ! run_resume_push; then
            if ! classify_resume_remote; then
                fail "$resume_remote_error"
            fi
            case "$resume_remote_state" in
                A) fail_resume_retryable 'up-to-date push 失败且远端为空' ;;
                C) fail "up-to-date push 后远端冲突或含糊: $resume_remote_error" ;;
                B)
                    if ! inspect_resume_upstream || ((resume_upstream_present == 0)); then
                        fail_resume_retryable '远端已正确但本地 upstream 尚未建立'
                    fi
                    ;;
            esac
        fi
    fi

    printf '\n== Resume 最终验证 ==\n'
    if ! verify_resume_result; then
        fail "$resume_verify_error"
    fi
    printf '\nGit Finalizer 完成：initial publish 恢复已验证。\n'
}

risk_count=0
add_risk() {
    printf '  - %s\n' "$*"
    risk_count=$((risk_count + 1))
}

repo_arg=''
message=''
remote_arg=''
resume_expected_oid=''
dry_run=0
initial_publish=0
resume_initial=0
repo_seen=0
message_seen=0
remote_seen=0
resume_seen=0
separator_seen=0
declare -a allow_test_fixture_args=()

while (($# > 0)); do
    case "$1" in
        --repo)
            (($# >= 2)) || fail '--repo 缺少参数'
            ((repo_seen == 0)) || fail '--repo 只能指定一次'
            repo_arg=$2
            repo_seen=1
            shift 2
            ;;
        --message)
            (($# >= 2)) || fail '--message 缺少参数'
            ((message_seen == 0)) || fail '--message 只能指定一次'
            message=$2
            message_seen=1
            shift 2
            ;;
        --initial-publish)
            ((initial_publish == 0)) || fail '--initial-publish 只能指定一次'
            initial_publish=1
            shift
            ;;
        --resume-initial-publish)
            (($# >= 2)) || fail '--resume-initial-publish 缺少 expected HEAD OID'
            ((resume_seen == 0)) || fail '--resume-initial-publish 只能指定一次'
            resume_expected_oid=$2
            resume_initial=1
            resume_seen=1
            shift 2
            ;;
        --remote)
            (($# >= 2)) || fail '--remote 缺少参数'
            ((remote_seen == 0)) || fail '--remote 只能指定一次'
            remote_arg=$2
            remote_seen=1
            shift 2
            ;;
        --dry-run)
            ((dry_run == 0)) || fail '--dry-run 只能指定一次'
            dry_run=1
            shift
            ;;
        --allow-test-fixture)
            (($# >= 2)) || fail '--allow-test-fixture 缺少参数'
            allow_test_fixture_args+=("$2")
            shift 2
            ;;
        --)
            separator_seen=1
            shift
            break
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            fail "未知参数（文件列表前必须使用 --）: $1"
            ;;
    esac
done

input_paths=("$@")

((repo_seen == 1)) || fail '必须指定 --repo'
if ((resume_initial == 1)); then
    ((initial_publish == 0)) || fail 'resume 模式不接受 --initial-publish'
    ((message_seen == 0)) || fail 'resume 模式不接受 --message'
    ((dry_run == 0)) || fail 'resume 模式不支持 --dry-run'
    ((${#allow_test_fixture_args[@]} == 0)) ||
        fail 'resume 模式不接受 --allow-test-fixture'
    ((separator_seen == 0 && ${#input_paths[@]} == 0)) ||
        fail 'resume 模式不接受文件列表或 -- 分隔符'
    ((remote_seen == 1)) || fail 'resume 模式必须指定 --remote'
elif ((initial_publish == 1)); then
    ((separator_seen == 1)) || fail '缺少文件列表分隔符 --'
    ((message_seen == 1)) || fail '必须指定 --message'
    ((remote_seen == 1)) || fail '--initial-publish 必须指定 --remote'
else
    ((separator_seen == 1)) || fail '缺少文件列表分隔符 --'
    ((message_seen == 1)) || fail '必须指定 --message'
    ((remote_seen == 0)) || fail '--remote 只允许与 --initial-publish 一起使用'
fi
if ((initial_publish == 1 || resume_initial == 1)); then
    [[ -n "$remote_arg" && "$remote_arg" != -* &&
        "$remote_arg" != *$'\n'* && "$remote_arg" != *$'\r'* && "$remote_arg" != *$'\t'* ]] ||
        fail '--remote 必须是有效的 remote 名'
fi
if ((resume_initial == 0)); then
    [[ -n ${message//[[:space:]]/} ]] || fail 'commit message 不能为空'
    ((${#input_paths[@]} > 0)) || fail '文件列表不能为空'
fi
[[ "$repo_arg" == /* ]] || fail '--repo 必须是绝对路径'
[[ -d "$repo_arg" ]] || fail "repo 路径不存在或不是目录: $repo_arg"

for command_name in git realpath stat grep sed; do
    require_command "$command_name"
done

repo=$(realpath -e -- "$repo_arg") || fail "无法解析 repo 路径: $repo_arg"
[[ $(git -C "$repo" rev-parse --is-inside-work-tree 2>/dev/null) == 'true' ]] ||
    fail "不是 Git worktree: $repo"
repo_root=$(git -C "$repo" rev-parse --show-toplevel)
repo_root=$(realpath -e -- "$repo_root")
[[ "$repo" == "$repo_root" ]] || fail "--repo 必须指向 worktree 根目录: $repo_root"

if ((resume_initial == 1)); then
    resume_initial_publish
    exit 0
fi

declare -a paths=()
declare -a absolute_paths=()
declare -a staged_paths=()
declare -A allowed_paths=()
declare -a test_fixture_paths=()
declare -A test_fixture_content_overrides=()

for input_path in "${input_paths[@]}"; do
    [[ -n "$input_path" ]] || fail '文件路径不能为空'
    [[ "$input_path" != *$'\n'* && "$input_path" != *$'\r'* && "$input_path" != *$'\t'* ]] ||
        fail '文件路径不能包含换行符、回车符或制表符'

    if [[ "$input_path" == /* ]]; then
        candidate=$input_path
    else
        candidate=$repo/$input_path
    fi
    lexical_path=$(realpath -m -s -- "$candidate") || fail "无法解析文件路径: $input_path"
    [[ "$lexical_path" == "$repo/"* ]] || fail "文件不在 repo 内: $input_path"
    [[ "$lexical_path" != "$repo" ]] || fail '不能把 repo 根目录作为提交文件'

    relative_path=${lexical_path#"$repo/"}
    [[ "$relative_path" != '.git' && "$relative_path" != .git/* ]] ||
        fail "禁止提交 Git 元数据路径: $input_path"
    [[ -z ${allowed_paths[$relative_path]+present} ]] ||
        fail "重复文件路径: $(printf '%q' "$relative_path")"

    if [[ -L "$lexical_path" ]]; then
        :
    else
        resolved_path=$(realpath -m -- "$candidate") || fail "无法解析文件路径: $input_path"
        [[ "$resolved_path" == "$repo/"* ]] || fail "文件经符号链接解析后不在 repo 内: $input_path"
        [[ ! -d "$lexical_path" ]] || fail "只接受显式文件，不能指定目录: $input_path"
    fi

    if [[ ! -e "$lexical_path" && ! -L "$lexical_path" ]]; then
        git -C "$repo" --literal-pathspecs ls-files --error-unmatch -- "$relative_path" \
            >/dev/null 2>&1 || fail "文件不存在且不是 tracked deletion: $input_path"
    fi

    allowed_paths["$relative_path"]=1
    paths+=("$relative_path")
    absolute_paths+=("$lexical_path")
done

for fixture_arg in "${allow_test_fixture_args[@]}"; do
    [[ -n "$fixture_arg" ]] || fail '--allow-test-fixture 路径不能为空'
    [[ "$fixture_arg" != /* ]] || fail '--allow-test-fixture 必须是 repo-relative path'
    [[ "$fixture_arg" != *$'\n'* && "$fixture_arg" != *$'\r'* && "$fixture_arg" != *$'\t'* ]] ||
        fail '--allow-test-fixture 路径不能包含换行符、回车符或制表符'

    fixture_lexical=$(realpath -m -s -- "$repo/$fixture_arg") ||
        fail "无法解析 test fixture 路径: $fixture_arg"
    [[ "$fixture_lexical" == "$repo/"* && "$fixture_lexical" != "$repo" ]] ||
        fail "test fixture 不在 repo 内: $fixture_arg"
    fixture_relative=${fixture_lexical#"$repo/"}
    [[ "$fixture_arg" == "$fixture_relative" ]] ||
        fail "--allow-test-fixture 必须是规范的 repo-relative path: $fixture_arg"
    [[ "$fixture_relative" == tests/* ]] ||
        fail "test fixture 内容例外只允许 tests/ 目录下的文件: $fixture_arg"
    [[ -n ${allowed_paths[$fixture_relative]+present} ]] ||
        fail "test fixture 不在本次显式文件范围内: $fixture_arg"
    [[ -f "$fixture_lexical" && ! -L "$fixture_lexical" ]] ||
        fail "test fixture 必须是仓库内普通文件: $fixture_arg"
    fixture_resolved=$(realpath -e -- "$fixture_lexical") ||
        fail "无法解析 test fixture 文件: $fixture_arg"
    [[ "$fixture_resolved" == "$repo/"* ]] ||
        fail "test fixture 经符号链接解析后不在 repo 内: $fixture_arg"
    [[ "$fixture_resolved" == "$fixture_lexical" ]] ||
        fail "test fixture 路径不能包含符号链接: $fixture_arg"
    [[ -z ${test_fixture_content_overrides[$fixture_relative]+present} ]] ||
        fail "重复 test fixture 内容例外: $(printf '%q' "$fixture_relative")"

    test_fixture_content_overrides["$fixture_relative"]=1
    test_fixture_paths+=("$fixture_relative")
done

print_snapshot

printf '\n== 显式范围 ==\n'
printf 'repo: %s\n' "$repo"
if ((initial_publish == 1)); then
    printf 'mode: initial-publish\n'
    printf 'remote: %s\n' "$remote_arg"
fi
printf 'branch: %s\n' "${current_branch:-'(detached)'}"
printf 'commit message: %q\n' "$message"
printf 'files:\n'
for path in "${paths[@]}"; do
    print_path "$path"
done
for path in "${test_fixture_paths[@]}"; do
    printf 'test fixture content override: %q\n' "$path"
done

collect_staged_paths
if ((dry_run == 1)); then
    printf '\n== DRY-RUN 风险 ==\n'
    if ((initial_publish == 1)); then
        if ! resolve_initial_target; then
            add_risk "$initial_target_error；真实运行会在 git add 和 commit 前停止"
        fi
        if [[ -n $(git -C "$repo" ls-files --stage) ]]; then
            add_risk 'initial-publish 检测到预先存在的 index 条目'
        fi
        if ! check_initial_worktree_scope; then
            add_risk "$initial_scope_error"
        fi
        printf '  - dry-run 未执行 ls-remote；未实时核验远端是否完全为空。\n'
    elif ! resolve_normal_target; then
        add_risk "$normal_target_error；真实运行会在 git add 和 commit 前停止"
    else
        printf '  - dry-run 未执行 fetch；未实时核验远端 branch 或 ahead/behind。\n'
    fi

    for path in "${staged_paths[@]}"; do
        if [[ -z ${allowed_paths[$path]+present} ]]; then
            add_risk "已有 staged 文件超出显式范围: $(printf '%q' "$path")"
        fi
    done

    for index in "${!paths[@]}"; do
        path=${paths[$index]}
        absolute_path=${absolute_paths[$index]}
        if reason=$(sensitive_path_reason "$path"); then
            add_risk "真实运行会拒绝 $(printf '%q' "$path"): $reason"
            continue
        fi
        if is_working_large_binary "$absolute_path"; then
            add_risk "真实运行会拒绝大于 5 MiB 的明显二进制文件: $(printf '%q' "$path")"
        fi
        if [[ -f "$absolute_path" && ! -L "$absolute_path" ]]; then
            if [[ ! -r "$absolute_path" ]]; then
                add_risk "文件不可读: $(printf '%q' "$path")"
            elif [[ -z ${test_fixture_content_overrides[$path]+present} ]] &&
                reason=$(working_content_reason "$absolute_path"); then
                add_risk "真实运行会拒绝 $(printf '%q' "$path"): $reason"
            fi
        fi
        path_status=$(
            git -C "$repo" --literal-pathspecs status --short --untracked-files=all -- "$path"
        )
        if [[ -z "$path_status" ]]; then
            add_risk "当前没有可见改动，可能导致 staged diff 为空: $(printf '%q' "$path")"
        fi
    done

    if ((risk_count == 0)); then
        printf '  - 未发现上述静态风险；实际运行前仍需保证测试和审查已通过。\n'
    fi
    printf '\nDRY-RUN 完成：未执行 git add、git commit、git fetch 或 git push。\n'
    exit 0
fi

if ((initial_publish == 1)); then
    if ! resolve_initial_target; then
        fail "$initial_target_error"
    fi
    if [[ -n $(git -C "$repo" ls-files --stage) ]]; then
        fail 'initial-publish 不允许预先存在 index 或 staged 内容'
    fi
    if ! check_initial_worktree_scope; then
        fail "$initial_scope_error"
    fi
elif ! resolve_normal_target; then
    fail "$normal_target_error"
fi

for path in "${staged_paths[@]}"; do
    if [[ -z ${allowed_paths[$path]+present} ]]; then
        fail "已有 staged 文件超出显式范围: $(printf '%q' "$path")"
    fi
done

for index in "${!paths[@]}"; do
    path=${paths[$index]}
    absolute_path=${absolute_paths[$index]}
    if reason=$(sensitive_path_reason "$path"); then
        fail "拒绝敏感文件 $(printf '%q' "$path"): $reason"
    fi
    if is_working_large_binary "$absolute_path"; then
        fail "拒绝大于 5 MiB 的明显二进制文件: $(printf '%q' "$path")"
    fi
    if [[ -f "$absolute_path" && ! -L "$absolute_path" ]]; then
        [[ -r "$absolute_path" ]] || fail "文件不可读: $(printf '%q' "$path")"
        if [[ -z ${test_fixture_content_overrides[$path]+present} ]] &&
            reason=$(working_content_reason "$absolute_path"); then
            fail "拒绝敏感文件 $(printf '%q' "$path"): $reason"
        fi
    fi
done

if ((initial_publish == 1)); then
    printf '\n== Root commit 前远端空状态检查 ==\n'
    if ! check_initial_remote_empty; then
        fail "$initial_remote_error；未执行新增 git add、commit 或 push"
    fi
else
    printf '\n== Commit 前 fetch 与 fast-forward 检查 ==\n'
    if ! check_normal_remote_state 'commit 前'; then
        fail "$normal_remote_error；未执行新增 git add、commit 或 push"
    fi
fi

printf '\n== 显式暂存 ==\n'
if ! run_git_mutation 'git add -- <explicit paths>' \
    git -C "$repo" --literal-pathspecs add -- "${paths[@]}"; then
    fail 'git add 失败；未执行 commit 或 push'
fi

check_staged_scope
check_test_fixture_staged_scope
((${#staged_paths[@]} > 0)) || fail 'staged diff 为空；未执行 commit 或 push'

if [[ -n $(git -C "$repo" ls-files -u) ]]; then
    fail 'index 存在未解决冲突；未执行 commit 或 push'
fi

printf '$ git diff --cached --name-status\n'
git -C "$repo" --literal-pathspecs diff --cached --name-status --no-renames
printf '$ git diff --cached --check\n'
if ! git -C "$repo" diff --cached --check >/dev/null; then
    fail 'git diff --cached --check 失败；未执行 commit 或 push'
fi
printf '(passed)\n'

for path in "${staged_paths[@]}"; do
    if reason=$(sensitive_path_reason "$path"); then
        fail "拒绝敏感 staged 文件 $(printf '%q' "$path"): $reason"
    fi
    if is_staged_large_binary "$path"; then
        fail "拒绝大于 5 MiB 的明显 staged 二进制文件: $(printf '%q' "$path")"
    fi
    if get_index_entry "$path" &&
        [[ $(git -C "$repo" cat-file -t "$index_oid" 2>/dev/null) == 'blob' ]]; then
        if [[ -z ${test_fixture_content_overrides[$path]+present} ]] &&
            reason=$(staged_content_reason "$index_oid"); then
            fail "拒绝敏感 staged 文件 $(printf '%q' "$path"): $reason"
        fi
    fi
done

printf '\n== Commit ==\n'
if ! run_git_mutation 'git commit -m <message>' git -C "$repo" commit -m "$message"; then
    fail 'git commit 失败；未执行 fetch 或 push'
fi

commit_hash=$(git -C "$repo" rev-parse HEAD)
commit_message=$(git -C "$repo" log -1 --format=%B)
mapfile -d '' -t committed_paths < <(
    git -C "$repo" diff-tree --root --no-commit-id --name-only -r --no-renames -z "$commit_hash"
)
for path in "${committed_paths[@]}"; do
    if [[ -z ${allowed_paths[$path]+present} ]]; then
        if ((initial_publish == 1)); then
            fail_initial_after_commit \
                "root commit 包含超出显式范围的文件: $(printf '%q' "$path")"
        else
            fail_after_commit "commit 包含超出显式范围的文件: $(printf '%q' "$path")"
        fi
    fi
done

if ((initial_publish == 1)) && ! verify_initial_root_commit; then
    fail_initial_after_commit "$initial_commit_error"
fi

printf 'commit hash: %s\n' "$commit_hash"
printf 'commit message: %q\n' "$commit_message"
printf 'changed files:\n'
git -C "$repo" diff-tree --root --no-commit-id --name-status -r --no-renames "$commit_hash"

if ((initial_publish == 1)); then
    printf '\n== Root commit 后远端空状态复查 ==\n'
    if ! check_initial_remote_empty; then
        fail_initial_after_commit "$initial_remote_error"
    fi

    printf '\n== Initial push ==\n'
    if ! run_git_remote_command \
        'git push --set-upstream --no-follow-tags <remote> HEAD:<branch>' \
        git -C "$repo" push --set-upstream --no-follow-tags \
        "$initial_remote" "HEAD:$initial_branch_ref"; then
        fail_initial_after_commit 'initial push 失败或结果无法确认'
    fi

    printf '\n== Initial push 后验证 ==\n'
    final_head=$(git -C "$repo" rev-parse --verify 'HEAD^{commit}') ||
        fail_initial_after_commit 'push 后无法解析 HEAD'
    final_upstream=$(git -C "$repo" rev-parse --verify '@{upstream}^{commit}') ||
        fail_initial_after_commit 'push 后无法解析 upstream'
    if ! query_initial_published_remote; then
        fail_initial_after_commit "$initial_remote_error"
    fi
    if ! final_counts=$(
        git -C "$repo" rev-list --left-right --count "$final_head...$final_upstream" 2>/dev/null
    ); then
        fail_initial_after_commit 'push 后无法计算 HEAD 与 upstream 的 ahead/behind'
    fi
    final_status=$(git -C "$repo" status --porcelain=v1 --untracked-files=all)

    printf 'HEAD: %s\n' "$final_head"
    printf 'upstream: %s\n' "$final_upstream"
    printf 'remote branch OID: %s\n' "$initial_remote_oid"
    printf 'ahead/behind: %s\n' "$final_counts"
    printf 'worktree: %s\n' "${final_status:-clean}"

    [[ "$final_head" == "$final_upstream" ]] ||
        fail_initial_after_commit 'push 后本地 HEAD 与 upstream 不一致'
    [[ "$final_head" == "$initial_remote_oid" ]] ||
        fail_initial_after_commit 'push 后本地 HEAD 与远端 branch 不一致'
    [[ "$final_counts" == $'0\t0' ]] ||
        fail_initial_after_commit 'push 后本地 HEAD 与 upstream ahead/behind 不是 0/0'
    [[ -z "$final_status" ]] ||
        fail_initial_after_commit 'push 后 worktree 不干净'
    git -C "$repo" diff --cached --quiet ||
        fail_initial_after_commit 'push 后 index 不干净'
else
    printf '\n== Commit 后 fetch 与 fast-forward 检查 ==\n'
    if ! resolve_normal_target; then
        fail_after_commit "$normal_target_error"
    fi
    if ! check_normal_remote_state 'commit 后'; then
        fail_after_commit "$normal_remote_error"
    fi

    printf '\n== Push ==\n'
    if ! run_git_remote_command 'git push <upstream remote> HEAD:<upstream branch>' \
        git -C "$repo" push "$upstream_remote" "HEAD:$upstream_branch_ref"; then
        fail_after_commit 'git push 失败'
    fi

    printf '\n== Push 后验证 ==\n'
    printf '$ git rev-parse HEAD\n'
    final_head=$(git -C "$repo" rev-parse HEAD)
    printf '%s\n' "$final_head"
    printf '$ git rev-parse @{upstream}\n'
    final_upstream=$(git -C "$repo" rev-parse '@{upstream}^{commit}') ||
        fail_after_commit 'push 后无法解析 upstream'
    printf '%s\n' "$final_upstream"
    if ! query_remote_branch; then
        fail_after_commit "push 后 $remote_query_error"
    fi
    printf 'remote branch OID: %s\n' "$remote_branch_oid"
    if ! final_counts=$(
        git -C "$repo" rev-list --left-right --count "$final_head...$final_upstream" 2>/dev/null
    ); then
        fail_after_commit 'push 后无法计算 HEAD 与 upstream 的 ahead/behind'
    fi
    printf 'ahead/behind: %s\n' "$final_counts"
    printf '$ git status --short\n'
    final_status=$(git -C "$repo" status --short)
    print_value_or "$final_status" '(clean)'

    [[ "$final_head" == "$final_upstream" ]] ||
        fail_after_commit 'push 后本地 HEAD 与 upstream 不一致'
    [[ "$final_head" == "$remote_branch_oid" ]] ||
        fail_after_commit 'push 后本地 HEAD 与远端 branch 不一致'
    [[ "$final_counts" == $'0\t0' ]] ||
        fail_after_commit 'push 后本地 HEAD 与 upstream ahead/behind 不是 0/0'
fi

printf '\nGit Finalizer 完成：commit 与 push 已验证。\n'
