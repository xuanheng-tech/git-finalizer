{
  "context_loader_contract_version": 1,
  "git_finalizer_contract_version": 2,
  "schema_version": 1,
  "snapshot_runner_contract_version": 2,
  "toolchain_contract_version": 3,
  "tools": {
    "context-loader": {
      "public_cli_contract_version": 1,
      "skill_contract_version": 1,
      "skill_manifest": "manifests/context-loader/tool_skill_manifest.json",
      "source_directory": "context-loader"
    },
    "git-finalizer": {
      "public_cli_contract_version": 2,
      "skill_contract_version": 1,
      "source_directory": "git-finalizer"
    },
    "snapshot-runner": {
      "public_cli_contract_version": 2,
      "skill_contract_version": 1,
      "skill_manifest": "manifests/snapshot-runner/tool_skill_manifest.json",
      "source_directory": "snapshot-runner",
      "uv_install_policy": {
        "bin_dir": "~/.local/share/snapshot-runner/bin",
        "index": [
          "https://pypi.org/simple"
        ],
        "no_build": true
      }
    }
  },
  "workflow_skill": {
    "canonical_owner": "git-finalizer",
    "compatibility_shims": [
      "three-tool-git-workflow"
    ],
    "contract_version": 1,
    "name": "git-change-delivery"
  },
  "worktree_controller_contract_version": 1,
  "worktree_controller_status": "available_external"
}
