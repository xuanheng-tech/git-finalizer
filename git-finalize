normalize_heads_ref() {
    local value=$1
    local label=$2
    local branch

    normalized_ref_error=''
    if [[ "$value" == refs/* ]]; then
        if [[ "$value" != refs/heads/* || "$value" == 'refs/heads/' ]]; then
            normalized_ref_error="$label 只接受 refs/heads/*"
            return 1
        fi
        branch=${value#refs/heads/}
    else
        branch=$value
    fi
    if [[ -z "$branch" || "$branch" == 'HEAD' || "$branch" == '@' ||
        "$branch" == -* || "$branch" == *$'\n'* || "$branch" == *$'\r'* ||
        "$branch" == *$'\t'* ]]; then
        normalized_ref_error="$label 不是有效的 branch 名"
        return 1
    fi
    if ! git -C "$repo" check-ref-format --branch "$branch" >/dev/null 2>&1; then
        normalized_ref_error="$label 不是有效的 branch 名"
        return 1
    fi
    normalized_branch=$branch
    normalized_ref="refs/heads/$branch"
}

normalize_integration_ref() {
    local value=$1
    local remote_name=$2

    if [[ "$value" == "refs/remotes/$remote_name/"* ]]; then
        value="refs/heads/${value#"refs/remotes/$remote_name/"}"
    elif [[ "$value" == "$remote_name/"* ]]; then
        value=${value#"$remote_name/"}
    fi
    normalize_heads_ref "$value" '--integrated-into'
}

validate_retirement_oid() {
    local value=$1
    local label=$2
    local object_format
    local oid_length

    retirement_validation_error=''
    if ! object_format=$(git -C "$repo" rev-parse --show-object-format=storage 2>/dev/null); then
        retirement_validation_error='无法确定当前 Git object format'
        return 1
    fi
    case "$object_format" in
        sha1) oid_length=40 ;;
        sha256) oid_length=64 ;;
        *)
            retirement_validation_error='不支持当前 Git object format'
            return 1
            ;;
    esac
    if ((${#value} != oid_length)) || [[ ! "$value" =~ ^[0-9a-f]+$ ]]; then
        retirement_validation_error="$label 必须是 $object_format 的完整小写十六进制 OID"
        return 1
    fi
}

# GF-INTEGRATION-ADAPTER: worktree-controller-retirement (single site)
verify_retirement_plan() {
    local operation=$1
    local common_dir
    local executable
    local verifier_output
    local -a recovery=()

    ((retirement_plan_id_seen == 1)) || return 0
    common_dir=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir) || {
        retirement_validation_error='无法定位 Git common dir'
        return 1
    }
    if [[ ! -d "$common_dir/worktree-controller/v1" &&
        -d "$common_dir/codex-worktree/v1" ]]; then
        retirement_validation_error='检测到 legacy codex-worktree namespace；retirement 需先经 WC 治理激活 worktree-controller/v1'
        return 1
    fi
    executable=$(realpath -e -- "${BASH_SOURCE[0]}") || {
        retirement_validation_error='无法解析 Finalizer 入口'
        return 1
    }
    retirement_verifier=${executable%/*}/git-finalize-retirement-plan.py
    [[ -f "$retirement_verifier" && ! -L "$retirement_verifier" ]] || {
        retirement_validation_error='缺少 retirement protocol companion'
        return 1
    }
    ((dry_run == 1)) || recovery=(--recover)
    if ! verifier_output=$("$PYTHON3_EXECUTABLE" -B "$retirement_verifier" \
        --repo "$repo" --plan-id "$retirement_plan_id_arg" --operation "$operation" \
        --branch "$retirement_feature_branch" --remote "$retirement_remote" \
        --integrated-into "$integrated_into_arg" \
        --expected-oid "$retirement_expected_oid" \
        --expected-integrated-oid "$expected_integrated_oid_arg" "${recovery[@]}" 2>&1); then
        retirement_validation_error="Controller retirement plan 校验失败: $(
            printf '%s\n' "$verifier_output" | tail -n 1
        )"
        return 1
    fi
    summary_retirement_plan_id=$retirement_plan_id_arg
}

run_retirement_plan_delete() {
    local operation=$1
    local output
    local attempted
    local receipt_id
    local completed=1

    retirement_controller_error=''
    if ! output=$(run_git_mutation "Controller-authorized $operation retirement CAS" \
        "$PYTHON3_EXECUTABLE" -B "$retirement_verifier" \
        --repo "$repo" --plan-id "$retirement_plan_id_arg" --operation "$operation" \
        --branch "$retirement_feature_branch" --remote "$retirement_remote" \
        --integrated-into "$integrated_into_arg" \
        --expected-oid "$retirement_expected_oid" \
        --expected-integrated-oid "$retirement_integration_oid_before" \
        --recover --execute 2>&1); then
        completed=0
    fi
    if ! attempted=$(printf '%s\n' "$output" | tail -n 1 |
        "$PYTHON3_EXECUTABLE" -B -c '
import json, sys
value = json.load(sys.stdin)
if not isinstance(value, dict) or type(value.get("controller_complete")) is not bool:
    raise ValueError("invalid completion result")
if sys.argv[1] == "1" and value["controller_complete"] is not True:
    raise ValueError("completion not verified")
attempted = value.get("mutation_attempted")
if type(attempted) is not bool:
    raise ValueError("invalid mutation result")
receipt_id = value.get("receipt_id")
if sys.argv[1] == "1" and (not isinstance(receipt_id, str) or not receipt_id):
    raise ValueError("completion receipt is missing")
print(str(attempted).lower() + "\t" + (receipt_id or ""))
' "$completed" 2>/dev/null); then
        if ((completed == 1)); then
            retirement_controller_error='Controller retirement completion 结果无法验证'
            return 1
        fi
    else
        IFS=$'\t' read -r attempted receipt_id <<<"$attempted"
        summary_retirement_lease_bound=$attempted
        summary_retirement_receipt_id=$receipt_id
        if [[ "$operation" == remote ]]; then
            summary_push_executed=$attempted
        fi
    fi
    if ((completed == 0)); then
        retirement_controller_error="Controller retirement 未完成: $(printf '%s\n' "$output" |
            sed -n '/^ERROR: retirement plan validation blocked:/p' | tail -n 1)"
        return 1
    fi
}

