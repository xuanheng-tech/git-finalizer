  --allocation-id <id>           Optional linkage; required with --reviewed-sensitive-source.
  --task-key <key>               Optional linkage; required with --reviewed-sensitive-source.
  --authority-key <key>          Optional linkage; required with --reviewed-sensitive-source.
  --worktree-path <path>         Optional linkage; must equal the Finalizer repo root.
  --role <role>                  Optional Worktree Controller role linkage.
  --repo <path>                  Absolute path to the Git worktree root.
  --message <text>               Non-empty commit message.
  --mode commit-only             Commit locally without remote checks or push.
  --mode verify-only             Validate locally without Git mutations or remote access.
  --initial-commit-only          Create one local root commit from an unborn branch.
  --initial-publish              Publish one root commit from an unborn branch.
  --initial-branch-publish       First-publish one existing local history branch.
  --resume-initial-publish <oid> Resume publication of one exact root commit.
  --resume-publish <oid>         Publish existing commits ahead of configured upstream.
  --sync-published-branch <oid>  Fast-forward an existing branch from a live published source.
  --source-remote <name>         Configured source remote for sync; local upstream is preserved.
  --expected-target-oid <oid>    Exact existing target baseline for sync.
  --publish-existing-branch <oid>
