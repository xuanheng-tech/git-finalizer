    fi
    if ! head=$(git -C "$repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null); then
        retirement_verify_error='retirement 后无法解析 HEAD'
        return 1
    fi
    summary_head_after=$head
    if [[ "$head" != "$retirement_head_before" ]]; then
        retirement_verify_error='retirement 前后 local HEAD 发生变化'
        return 1
    fi
    summary_head_unchanged=true
    index=$(git -C "$repo" ls-files --stage) || {
        retirement_verify_error='retirement 后无法记录 index'
        return 1
    }
    if [[ "$index" != "$retirement_index_before" ]]; then
        retirement_verify_error='retirement 前后 index 发生变化'
        return 1
    fi
    summary_index_unchanged=true
    if ! status=$(
        GIT_OPTIONAL_LOCKS=0 git -C "$repo" status --porcelain=v1 --untracked-files=all
    ); then
        retirement_verify_error='retirement 后无法验证 worktree 状态'
        return 1
    fi
    if [[ -n "$status" || "$status" != "$retirement_status_before" ]]; then
        retirement_verify_error='retirement 后 worktree 不干净或状态发生变化'
        return 1
    fi
    summary_worktree_state='clean'
    summary_worktree_unchanged=true
    tags=$(git -C "$repo" for-each-ref --format='%(objectname)%09%(refname)' refs/tags) || {
        retirement_verify_error='retirement 后无法记录 tags'
        return 1
    }
    if [[ "$tags" != "$retirement_tags_before" ]]; then
        retirement_verify_error='retirement 前后 tags 发生变化'
        return 1
    fi
    summary_retirement_tags_unchanged=true
}

check_retirement_local_lifecycle() {
    local line
    local local_oid
    local local_only
    local remote_only
    local branch_ref
    local upstream_ref
    local worktree_output
    local upstream_output
    local target_upstream="refs/remotes/$retirement_remote/$retirement_feature_branch"

    retirement_local_error=''
    if ! worktree_output=$(git -C "$repo" worktree list --porcelain); then
        retirement_local_error='无法枚举 local worktrees'
        return 1
    fi
    while IFS= read -r line; do
        if [[ "$line" == "branch $retirement_feature_ref" ]]; then
            retirement_local_error='目标 branch 仍被一个 local worktree checkout'
            return 1
        fi
    done <<<"$worktree_output"

    if local_oid=$(
        git -C "$repo" show-ref --verify --hash "$retirement_feature_ref" 2>/dev/null
    ); then
        if ! local_only=$(
            git -C "$repo" rev-list --count "$retirement_expected_oid..$retirement_feature_ref"
        ) || ! remote_only=$(
            git -C "$repo" rev-list --count "$retirement_feature_ref..$retirement_expected_oid"
        ); then
            retirement_local_error='无法验证 local/expected feature branch commit 差异'
            return 1
        fi
        if ((local_only > 0)); then
            retirement_local_error="local feature branch 仍有 $local_only 个 local-only commit"
            return 1
        fi
        if ((remote_only > 0)) || [[ "$local_oid" != "$retirement_expected_oid" ]]; then
            if ((retire_remote_branch == 1)); then
                retirement_local_error='local feature branch 与 remote feature OID 不一致'
            else
                retirement_local_error='local feature branch 与 expected feature OID 不一致'
            fi
            return 1
        fi
    fi

    if ! upstream_output=$(
        git -C "$repo" for-each-ref --format='%(refname)%09%(upstream)' refs/heads
    ); then
        retirement_local_error='无法枚举 local branch upstreams'
        return 1
    fi
    while IFS=$'\t' read -r branch_ref upstream_ref; do
        [[ -n "$branch_ref" ]] || continue
        if [[ "$upstream_ref" == "$target_upstream" &&
            "$branch_ref" != "$retirement_feature_ref" ]]; then
            retirement_local_error='其他 local branch 仍把目标 remote ref 作为 upstream'
            return 1
        fi
    done <<<"$upstream_output"
}

validate_retirement_ci() {
    retirement_ci_error=''
    if ((ci_required == 1)); then
        if [[ "$ci_status_arg" != 'SUCCESS' ]]; then
            retirement_ci_error='repository policy 要求 CI SUCCESS'
            return 1
        fi
        case "$ci_verification_source_arg" in
            tool_authenticated|human_authenticated_ui) ;;
            *)
                retirement_ci_error='ci_verification_source 不足以证明 required CI'
                return 1
                ;;
        esac
        if ! validate_retirement_oid "$ci_commit_oid_arg" 'ci_commit_oid'; then
            retirement_ci_error=$retirement_validation_error
            return 1
        fi
        if [[ "$ci_commit_oid_arg" != "$retirement_integration_oid" ]]; then
            retirement_ci_error='ci_commit_oid 与 live integration target OID 不一致'
            return 1
        fi
    else
        if [[ "$ci_status_arg" != 'NOT_REQUIRED' ||
            "$ci_verification_source_arg" != 'not_required' ||
            -n "$ci_commit_oid_arg" || -n "$ci_verified_at_arg" ]]; then
            retirement_ci_error='未启用 --ci-required 时 CI evidence 必须为 not_required'
            return 1
        fi
    fi
}

verify_retirement_remote_absent() {
    retirement_verify_error=''
    if ! query_retirement_refs; then
        retirement_verify_error=$retirement_remote_error
        return 1
    fi
    if ((retirement_feature_present == 1)); then
        retirement_verify_error='post-delete live remote feature ref 仍存在'
        return 1
    fi
    if ((retirement_integration_present == 0)) ||
        [[ "$retirement_integration_oid" != "$retirement_integration_oid_before" ]]; then
        retirement_verify_error='post-delete integration target 缺失或 OID 发生变化'
        return 1
    fi
    if ! run_git_remote_command 'git fetch --prune --no-tags <remote>' \
        git -C "$repo" fetch --prune --no-tags "$retirement_remote"; then
        retirement_verify_error='post-delete fetch --prune 失败'
        return 1
    fi
    if git -C "$repo" show-ref --verify --quiet "$retirement_tracking_ref"; then
        retirement_verify_error='post-delete remote-tracking feature ref 仍存在'
        return 1
    fi
    summary_retirement_remote_tracking_absent=true
    summary_retirement_remote_absent_after=true
    if ! verify_retirement_local_unchanged; then
        return 1
    fi
}

fail_retirement() {
    local result=$1
    shift

    summary_retirement_result=$result
    if [[ "$result" == 'REMOTE_DELETE_UNVERIFIED' ||
        "$result" == 'LOCAL_DELETE_UNVERIFIED' ]]; then
        summary_default_failure_status='failed'
        summary_next_action='inspect_remote_state_then_rerun_same_retirement'
    fi
    fail "$*"
}

run_retirement_delete() {
    if ((retirement_plan_id_seen == 1)); then
        summary_push_branch_refspec_only=true
        summary_push_follow_tags_disabled=true
        run_retirement_plan_delete remote
        return
    fi
    local display='git push --no-follow-tags --force-with-lease=<ref>:<expected> <remote> :<ref>'
    local -a command=(
        git -C "$repo" push --no-follow-tags
        "--force-with-lease=$retirement_feature_ref:$retirement_expected_oid"
        "$retirement_remote" ":$retirement_feature_ref"
    )

    summary_push_branch_refspec_only=true
    summary_push_follow_tags_disabled=true
    summary_retirement_lease_bound=true
    run_git_remote_command "$display" "${command[@]}"
}

retire_remote_branch_ref() {
    local normalized_branch
    local normalized_ref

    summary_mode_state='preflight'
    summary_retirement_operation=$([[ "$dry_run" == 1 ]] && printf dry_run || printf delete)
    summary_retirement_remote=$remote_arg
    summary_retirement_expected_oid=$expected_remote_oid_arg
    summary_retirement_ci_required=$([[ "$ci_required" == 1 ]] && printf true || printf false)
    summary_retirement_ci_status=$ci_status_arg
    summary_retirement_ci_commit_oid=$ci_commit_oid_arg
    summary_retirement_ci_source=$ci_verification_source_arg
    summary_retirement_ci_verified_at=$ci_verified_at_arg
    retirement_remote=$remote_arg
    retirement_expected_oid=$expected_remote_oid_arg
    summary_retirement_plan_id=$retirement_plan_id_arg

    if ! normalize_heads_ref "$retire_remote_branch_arg" '--retire-remote-branch'; then
        fail_retirement RETIREMENT_BLOCKED "$normalized_ref_error"
    fi
    retirement_feature_branch=$normalized_branch
    retirement_feature_ref=$normalized_ref
    summary_retirement_branch=$retirement_feature_branch
    summary_retirement_ref=$retirement_feature_ref
    if is_protected_branch "$retirement_feature_branch" ||
        is_special_lifecycle_branch "$retirement_feature_branch"; then
        fail_retirement RETIREMENT_BLOCKED \
            "retire-remote-branch 拒绝受保护分支: $retirement_feature_branch"
    fi
    if ! normalize_integration_ref "$integrated_into_arg" "$retirement_remote"; then
        fail_retirement RETIREMENT_BLOCKED "$normalized_ref_error"
    fi
    retirement_integration_ref=$normalized_ref
    summary_retirement_integrated_ref=$retirement_integration_ref
    if [[ "$retirement_feature_ref" == "$retirement_integration_ref" ]]; then
        fail_retirement RETIREMENT_BLOCKED 'feature ref 与 integration target 不能相同'
    fi
    if ! validate_retirement_oid "$retirement_expected_oid" 'expected_remote_oid'; then
        fail_retirement RETIREMENT_BLOCKED "$retirement_validation_error"
    fi
    if ((expected_integrated_oid_seen == 1)) &&
        ! validate_retirement_oid "$expected_integrated_oid_arg" 'expected_integrated_oid'; then
        fail_retirement RETIREMENT_BLOCKED "$retirement_validation_error"
    fi
    if ! verify_retirement_plan remote; then
        fail_retirement RETIREMENT_BLOCKED "$retirement_validation_error"
    fi
    if ! capture_retirement_local_state; then
        fail_retirement RETIREMENT_BLOCKED "$retirement_local_error"
    fi
    if ! resolve_retirement_remote; then
        fail_retirement RETIREMENT_BLOCKED "$retirement_remote_error"
    fi
    if ! query_retirement_default_branch; then
        fail_retirement RETIREMENT_BLOCKED "$retirement_remote_error"
    fi
    if [[ "$retirement_feature_ref" == "$retirement_default_ref" ]]; then
        fail_retirement RETIREMENT_BLOCKED \
            "retire-remote-branch 拒绝 remote default branch: $retirement_feature_branch"
    fi

    summary_phase='remote_preflight'
    if ! run_git_remote_command 'git fetch --prune --no-tags <remote>' \
        git -C "$repo" fetch --prune --no-tags "$retirement_remote"; then
        fail_retirement RETIREMENT_BLOCKED 'retirement preflight fetch 失败'
    fi
    if ! query_retirement_refs; then
        fail_retirement RETIREMENT_BLOCKED "$retirement_remote_error"
    fi
    if ((retirement_integration_present == 0)); then
        fail_retirement RETIREMENT_BLOCKED 'live remote integration target 不存在'
    fi
    if ! git -C "$repo" cat-file -e "$retirement_integration_oid^{commit}" 2>/dev/null; then
        fail_retirement RETIREMENT_BLOCKED 'integration target 无法解析为本地 commit object'
    fi
    retirement_integration_oid_before=$retirement_integration_oid
    summary_retirement_integrated_oid=$retirement_integration_oid
    if ((expected_integrated_oid_seen == 1)) &&
        [[ "$retirement_integration_oid" != "$expected_integrated_oid_arg" ]]; then
        fail_retirement RETIREMENT_BLOCKED \
            'live integration target OID 与 expected_integrated_oid 不一致'
    fi
    if ! validate_retirement_ci; then
        fail_retirement RETIREMENT_BLOCKED "$retirement_ci_error"
    fi

    retirement_tracking_ref="refs/remotes/$retirement_remote/$retirement_feature_branch"
    if ((retirement_feature_present == 0)); then
        if ((retirement_plan_id_seen == 1)); then
            if ! git -C "$repo" cat-file -e "$retirement_expected_oid^{commit}" 2>/dev/null ||
                ! git -C "$repo" merge-base --is-ancestor \
                    "$retirement_expected_oid" "$retirement_integration_oid"; then
                fail_retirement RETIREMENT_BLOCKED \
                    'plan-bound expected feature OID 无法证明已 ancestry-integrated'
            fi
            summary_retirement_ancestry=true
            if ! check_retirement_local_lifecycle; then
                fail_retirement RETIREMENT_BLOCKED "$retirement_local_error"
            fi
        fi
        summary_phase='post_verify'
        if ! verify_retirement_remote_absent; then
            fail_retirement REMOTE_DELETE_UNVERIFIED "$retirement_verify_error"
        fi
        settle_absent_retirement_plan remote
        summary_post_verify='passed'
        summary_remote_conclusion='already_absent_verified'
        summary_retirement_result='ALREADY_ABSENT_VERIFIED'
        summary_mode_state='verified'
        summary_completed_through='post_verify'
        summary_next_action='none'
        return 0
    fi
    if [[ "$retirement_feature_oid" != "$retirement_expected_oid" ]]; then
        fail_retirement RETIREMENT_BLOCKED 'live remote feature OID 与 expected_remote_oid 不一致'
    fi
    if ! git -C "$repo" cat-file -e "$retirement_feature_oid^{commit}" 2>/dev/null; then
        fail_retirement RETIREMENT_BLOCKED 'feature target 无法解析为本地 commit object'
    fi
    if ! git -C "$repo" merge-base --is-ancestor \
        "$retirement_feature_oid" "$retirement_integration_oid"; then
        fail_retirement RETIREMENT_BLOCKED \
            'feature remote OID 不是 integration target OID 的 ancestor'
    fi
    summary_retirement_ancestry=true
    if ! check_retirement_local_lifecycle; then
        fail_retirement RETIREMENT_BLOCKED "$retirement_local_error"
    fi

    if ((dry_run == 1)); then
        if ! query_retirement_refs; then
            fail_retirement RETIREMENT_BLOCKED "$retirement_remote_error"
        fi
        if ((retirement_feature_present == 0)) ||
            [[ "$retirement_feature_oid" != "$retirement_expected_oid" ||
                "$retirement_integration_oid" != "$retirement_integration_oid_before" ]]; then
            fail_retirement RETIREMENT_BLOCKED 'dry-run 复查发现 live remote refs 已变化'
        fi
        if ! verify_retirement_local_unchanged; then
            fail_retirement RETIREMENT_BLOCKED "$retirement_verify_error"
        fi
        summary_retirement_remote_absent_after=false
        summary_retirement_result='RETIREMENT_PREFLIGHT_PASSED'
        summary_remote_conclusion='retirement_preflight_passed'
        summary_post_verify='skipped_by_dry_run'
        summary_mode_state='dry_run_complete'
        summary_completed_through='preflight'
        summary_next_action='publish_install_verify_then_run_without_dry_run'
        return 0
    fi

    if ! query_retirement_refs; then
        fail_retirement RETIREMENT_BLOCKED "$retirement_remote_error"
    fi
    if ((retirement_feature_present == 0)); then
        summary_phase='post_verify'
        if ! verify_retirement_remote_absent; then
            fail_retirement REMOTE_DELETE_UNVERIFIED "$retirement_verify_error"
        fi
        settle_absent_retirement_plan remote
        summary_post_verify='passed'
        summary_remote_conclusion='already_absent_verified'
        summary_retirement_result='ALREADY_ABSENT_VERIFIED'
        summary_mode_state='verified'
        summary_completed_through='post_verify'
        summary_next_action='none'
        return 0
    fi
    if [[ "$retirement_feature_oid" != "$retirement_expected_oid" ||
        "$retirement_integration_oid" != "$retirement_integration_oid_before" ]]; then
        fail_retirement RETIREMENT_BLOCKED \
            'delete 前 live remote refs 已变化；expected-OID lease gate 拒绝继续'
    fi

    summary_phase='remote_mutation'
    ((retirement_plan_id_seen == 1)) || summary_push_executed=true
    if ! run_retirement_delete; then
        summary_push_result='uncertain'
        if [[ -n "${retirement_controller_error:-}" ]]; then
            fail_retirement REMOTE_DELETE_UNVERIFIED "$retirement_controller_error"
        fi
        if query_retirement_refs && ((retirement_feature_present == 0)) &&
            [[ "$retirement_integration_oid" == "$retirement_integration_oid_before" ]]; then
            summary_push_result='confirmed_after_uncertain'
        else
            fail_retirement REMOTE_DELETE_UNVERIFIED \
                'lease-bound remote delete 被拒绝或结果无法验证'
        fi
    else
        summary_push_result='succeeded'
    fi

    summary_phase='post_verify'
    summary_post_verify='failed'
    if ! verify_retirement_remote_absent; then
        fail_retirement REMOTE_DELETE_UNVERIFIED "$retirement_verify_error"
    fi
    summary_post_verify='passed'
    summary_remote_conclusion='remote_branch_retired_verified'
    summary_retirement_result='REMOTE_BRANCH_RETIRED_VERIFIED'
    summary_mode_state='verified'
    summary_completed_through='post_verify'
    summary_next_action='none'
}

capture_retirement_other_local_refs() {
    retirement_other_local_refs_before=$(
        git -C "$repo" for-each-ref --format='%(objectname)%09%(refname)' refs/heads |
            while IFS=$'\t' read -r oid ref_name; do
                [[ "$ref_name" == "$retirement_feature_ref" ]] ||
                    printf '%s\t%s\n' "$oid" "$ref_name"
            done
    ) || {
        retirement_local_error='无法记录 retirement 前其他 local branch refs'
        return 1
    }
}

verify_retirement_local_absent() {
    local other_refs
    local line
    local worktree_output

    retirement_verify_error=''
    if git -C "$repo" show-ref --verify --quiet "$retirement_feature_ref"; then
        retirement_verify_error='post-delete local feature ref 仍存在'
        return 1
    fi
    if ! worktree_output=$(git -C "$repo" worktree list --porcelain); then
        retirement_verify_error='post-delete 无法核验 worktree checkout'
        return 1
    fi
    while IFS= read -r line; do
        if [[ "$line" == "branch $retirement_feature_ref" ]]; then
            retirement_verify_error='post-delete 目标 branch 被 worktree checkout'
            return 1
        fi
    done <<<"$worktree_output"
    other_refs=$(
        git -C "$repo" for-each-ref --format='%(objectname)%09%(refname)' refs/heads |
            while IFS=$'\t' read -r oid ref_name; do
                [[ "$ref_name" == "$retirement_feature_ref" ]] ||
                    printf '%s\t%s\n' "$oid" "$ref_name"
            done
    ) || {
        retirement_verify_error='无法记录 retirement 后其他 local branch refs'
        return 1
    }
    if [[ "$other_refs" != "$retirement_other_local_refs_before" ]]; then
        retirement_verify_error='retirement 前后其他 local branch refs 发生变化'
        return 1
    fi
    if ! query_retirement_refs; then
        retirement_verify_error=$retirement_remote_error
        return 1
    fi
    if ((retirement_integration_present == 0)) ||
        [[ "$retirement_integration_oid" != "$retirement_integration_oid_before" ]]; then
        retirement_verify_error='post-delete integration target 缺失或 OID 发生变化'
        return 1
    fi
    if ((retirement_feature_present != retirement_feature_present_before)) ||
        { ((retirement_feature_present == 1)) &&
            [[ "$retirement_feature_oid" != "$retirement_feature_oid_before" ]]; }; then
        retirement_verify_error='local retirement 期间 live remote feature ref 发生变化'
        return 1
    fi
    if ! run_git_remote_command 'git fetch --prune --no-tags <remote>' \
        git -C "$repo" fetch --prune --no-tags "$retirement_remote"; then
        retirement_verify_error='post-delete fetch --prune 失败'
        return 1
    fi
    if git -C "$repo" show-ref --verify --quiet "$retirement_tracking_ref"; then
        if ((retirement_feature_present == 0)); then
            retirement_verify_error='remote 已 absent 但 remote-tracking feature ref 仍存在'
            return 1
        fi
        summary_retirement_remote_tracking_absent=false
    else
        if ((retirement_feature_present == 1)); then
            retirement_verify_error='live remote feature 存在但 tracking ref 缺失'
            return 1
        fi
        summary_retirement_remote_tracking_absent=true
    fi
    summary_retirement_remote_absent_after=$(
        ((retirement_feature_present == 0)) && printf true || printf false
    )
    summary_retirement_local_absent_after=true
    if ! verify_retirement_local_unchanged; then
        return 1
    fi
}

