#!/usr/bin/env bash

set -Eeuo pipefail

export GIT_TERMINAL_PROMPT=0
export GCM_INTERACTIVE=Never

PYTHON3_EXECUTABLE=$(command -v python3 || true)
readonly PYTHON3_EXECUTABLE

python3_available() {
    [[ -n "$PYTHON3_EXECUTABLE" ]] &&
        "$PYTHON3_EXECUTABLE" -B -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1
}

if ((EUID == 0)); then
    printf 'ERROR: Git Finalizer must run as the current non-root user\n' >&2
    exit 1
fi

readonly VERSION="1.8.16"
readonly MAX_BINARY_BYTES=$((5 * 1024 * 1024))
readonly MAX_ALLOWED_LARGE_BINARY_BYTES=$((25 * 1024 * 1024))
readonly SUMMARY_SCHEMA_VERSION=1
readonly MAX_SUMMARY_WARNINGS=5

integration_publish_requested=0
for integration_publish_argument in "$@"; do
    [[ "$integration_publish_argument" != '--' ]] || break
    if [[ "$integration_publish_argument" == '--publish-integration-candidate' ]]; then
        integration_publish_requested=1
    fi
done
if ((integration_publish_requested == 1)); then
    python3_available || {
        printf 'ERROR: integration publication requires Python 3.11+ on PATH\n' >&2
        exit 1
    }
    finalizer_executable=$(realpath -e -- "${BASH_SOURCE[0]}") || {
        printf 'ERROR: cannot resolve Git Finalizer entrypoint\n' >&2
        exit 1
    }
    integration_publish_companion=${finalizer_executable%/*}/git-finalize-integration-publish.py
    [[ -f "$integration_publish_companion" && ! -L "$integration_publish_companion" ]] || {
        printf 'ERROR: integration publication companion is missing\n' >&2
        exit 1
    }
    exec "$PYTHON3_EXECUTABLE" -B "$integration_publish_companion" "$@"
fi

repository_bootstrap_requested=0
for bootstrap_argument in "$@"; do
    [[ "$bootstrap_argument" != '--' ]] || break
    if [[ "$bootstrap_argument" == '--repo-plan' ||
        "$bootstrap_argument" == '--repo-ensure' ]]; then
        repository_bootstrap_requested=1
    fi
done
if ((repository_bootstrap_requested == 1)); then
    python3_available || {
        printf 'ERROR: repository bootstrap requires Python 3.11+ on PATH\n' >&2
        exit 1
    }
    finalizer_executable=$(realpath -e -- "${BASH_SOURCE[0]}") || {
        printf 'ERROR: cannot resolve Git Finalizer entrypoint\n' >&2
        exit 1
    }
    repository_bootstrap_companion=${finalizer_executable%/*}/git-finalize-repo-bootstrap.py
    [[ -f "$repository_bootstrap_companion" &&
        ! -L "$repository_bootstrap_companion" ]] || {
        printf 'ERROR: repository bootstrap companion is missing\n' >&2
        exit 1
    }
    exec "$PYTHON3_EXECUTABLE" -B "$repository_bootstrap_companion" "$@"
fi

summary_requested=0
for summary_argument in "$@"; do
    [[ "$summary_argument" != '--' ]] || break
    if [[ "$summary_argument" == '--summary' ]]; then
        summary_requested=1
    fi
done

summary_mode='normal'
summary_status='blocked'
summary_phase='cli'
summary_exit_code=0
summary_repo=''
summary_repository_id=''
summary_allocation_id=''
summary_task_key=''
summary_authority_key=''
summary_worktree_path=''
summary_role=''
summary_branch=''
summary_upstream=''
summary_path_count=0
summary_dry_run=false
summary_default_failure_status='blocked'
summary_commit_created=false
summary_commit_sha=''
summary_push_executed=false
summary_push_result='not_run'
summary_push_branch_refspec_only=''
summary_push_follow_tags_disabled=''
summary_post_verify='not_run'
summary_reason=''
summary_next_action=''
summary_warnings_omitted=0
summary_mode_state='not_started'
summary_snapshot_verification='not_requested'
summary_remote_conclusion='not_checked'
summary_recovery_start=''
summary_commit_reused=false
summary_completed_through='none'
summary_resume_required=false
summary_resume_oid=''
summary_resume_remote=''
summary_worktree_state=''
summary_worktree_before_state=''
summary_commit_result='not_run'
summary_head_before=''
summary_head_after=''
summary_head_unchanged=false
summary_index_unchanged=false
summary_worktree_unchanged=false
summary_resume_publish_kind=''
summary_publish_ahead=''
summary_publish_behind=''
summary_publish_commit_count=''
summary_publish_range=''
summary_push_target=''
summary_final_head=''
summary_final_remote_oid=''
summary_sync_source_remote=''
summary_sync_expected_target_oid=''
summary_retirement_operation=''
summary_retirement_remote=''
summary_retirement_branch=''
summary_retirement_ref=''
summary_retirement_expected_oid=''
summary_retirement_integrated_ref=''
summary_retirement_integrated_oid=''
summary_retirement_ancestry=''
summary_retirement_ci_required=false
summary_retirement_ci_status='NOT_REQUIRED'
summary_retirement_ci_commit_oid=''
summary_retirement_ci_source='not_required'
summary_retirement_ci_verified_at=''
summary_retirement_remote_absent_after=''
summary_retirement_result='RETIREMENT_BLOCKED'
summary_retirement_lease_bound=false
summary_retirement_tags_unchanged=false
summary_retirement_remote_tracking_absent=false
summary_retirement_local_absent_after=''
summary_retirement_plan_id=''
summary_retirement_receipt_id=''
declare -a summary_warnings=()
declare -a summary_fixture_exceptions=()
declare -a summary_source_reviews=()

record_summary_warning() {
    if ((${#summary_warnings[@]} < MAX_SUMMARY_WARNINGS)); then
        summary_warnings+=("$*")
    else
        summary_warnings_omitted=$((summary_warnings_omitted + 1))
    fi
}

record_summary_failure() {
    summary_status=$summary_default_failure_status
    summary_reason=$*
    if [[ -z "$summary_next_action" ]]; then
        if [[ "$summary_status" == 'blocked' ]]; then
            summary_next_action='resolve_blocker_and_retry'
        else
            summary_next_action='inspect_failure'
        fi
    fi
}

render_summary() {
    "$PYTHON3_EXECUTABLE" -B - \
        "$SUMMARY_SCHEMA_VERSION" "$VERSION" "$summary_mode" "$summary_status" "$summary_phase" \
        "$summary_exit_code" "$summary_repo" "$summary_repository_id" \
        "$summary_allocation_id" "$summary_task_key" "$summary_authority_key" \
        "$summary_worktree_path" "$summary_role" "$summary_branch" "$summary_upstream" \
        "$summary_path_count" "$summary_dry_run" "$summary_commit_created" \
        "$summary_commit_sha" "$summary_push_executed" "$summary_push_result" \
        "$summary_push_branch_refspec_only" "$summary_push_follow_tags_disabled" \
        "$summary_post_verify" "$summary_reason" "$summary_next_action" \
        "$summary_warnings_omitted" "$summary_mode_state" \
        "$summary_snapshot_verification" "$summary_remote_conclusion" \
        "$summary_recovery_start" "$summary_commit_reused" \
        "$summary_completed_through" "$summary_resume_required" \
        "$summary_resume_oid" "$summary_resume_remote" "$summary_worktree_state" \
        "$summary_worktree_before_state" "$summary_commit_result" \
        "$summary_head_before" "$summary_head_after" "$summary_head_unchanged" \
        "$summary_index_unchanged" "$summary_worktree_unchanged" \
        "$summary_resume_publish_kind" "$summary_publish_ahead" \
        "$summary_publish_behind" "$summary_publish_commit_count" \
        "$summary_publish_range" "$summary_push_target" \
        "$summary_final_head" "$summary_final_remote_oid" \
        "$summary_sync_source_remote" "$summary_sync_expected_target_oid" \
        "$summary_retirement_operation" "$summary_retirement_remote" \
        "$summary_retirement_branch" "$summary_retirement_ref" \
        "$summary_retirement_expected_oid" "$summary_retirement_integrated_ref" \
        "$summary_retirement_integrated_oid" "$summary_retirement_ancestry" \
        "$summary_retirement_ci_required" "$summary_retirement_ci_status" \
        "$summary_retirement_ci_commit_oid" "$summary_retirement_ci_source" \
        "$summary_retirement_ci_verified_at" \
        "$summary_retirement_remote_absent_after" "$summary_retirement_result" \
        "$summary_retirement_lease_bound" "$summary_retirement_tags_unchanged" \
        "$summary_retirement_remote_tracking_absent" \
        "$summary_retirement_local_absent_after" "$summary_retirement_plan_id" \
        "$summary_retirement_receipt_id" \
        "$(printf '%s\n' "${summary_fixture_exceptions[@]}")" \
        "$(printf '%s\n' "${summary_source_reviews[@]}")" \
        "${summary_warnings[@]}" <<'PY'
import json
import sys


def take(values):
    return next(values)


def boolean(value):
    return value == "true"


def bounded(value, limit):
    omitted = max(0, len(value) - limit)
    return value[:limit], omitted


values = iter(sys.argv[1:])
schema_version = int(take(values))
version = take(values)
mode = take(values)
status = take(values)
phase = take(values)
exit_code = int(take(values))
repository = take(values)
repository_id = take(values)
allocation_id = take(values)
task_key = take(values)
authority_key = take(values)
worktree_path = take(values)
role = take(values)
branch = take(values)
upstream = take(values)
path_count = int(take(values))
dry_run = boolean(take(values))
commit_created = boolean(take(values))
commit_sha = take(values)
push_executed = boolean(take(values))
push_result = take(values)
push_branch_refspec_only_raw = take(values)
push_follow_tags_disabled_raw = take(values)
push_branch_refspec_only = (
    boolean(push_branch_refspec_only_raw) if push_branch_refspec_only_raw else None
)
push_follow_tags_requested = (
    False if boolean(push_follow_tags_disabled_raw) else None
)
post_verify = take(values)
reason, reason_omitted = bounded(take(values), 512)
next_action, next_action_omitted = bounded(take(values), 256)
warnings_omitted = int(take(values))
mode_state = take(values)
snapshot_verification = take(values)
remote_conclusion = take(values)
recovery_start = take(values)
commit_reused = boolean(take(values))
completed_through = take(values)
resume_required = boolean(take(values))
resume_oid = take(values)
resume_remote = take(values)
worktree_state = take(values)
worktree_before_state = take(values)
commit_result = take(values)
head_before = take(values)
head_after = take(values)
head_unchanged = boolean(take(values))
index_unchanged = boolean(take(values))
worktree_unchanged = boolean(take(values))
resume_publish_kind = take(values)
publish_ahead_raw = take(values)
publish_behind_raw = take(values)
publish_commit_count_raw = take(values)
publish_range = take(values)
push_target = take(values)
final_head = take(values)
final_remote_oid = take(values)
sync_source_remote = take(values)
sync_expected_target_oid = take(values)
retirement_operation = take(values)
retirement_remote = take(values)
retirement_branch = take(values)
retirement_ref = take(values)
retirement_expected_oid = take(values)
retirement_integrated_ref = take(values)
retirement_integrated_oid = take(values)
retirement_ancestry_raw = take(values)
retirement_ci_required = boolean(take(values))
retirement_ci_status = take(values)
retirement_ci_commit_oid = take(values)
retirement_ci_source = take(values)
retirement_ci_verified_at = take(values)
retirement_remote_absent_after_raw = take(values)
retirement_result = take(values)
retirement_lease_bound = boolean(take(values))
retirement_tags_unchanged = boolean(take(values))
retirement_remote_tracking_absent = boolean(take(values))
retirement_local_absent_after_raw = take(values)
retirement_plan_id = take(values)
retirement_receipt_id = take(values)
fixture_exceptions = [json.loads(line) for line in take(values).splitlines() if line]
source_reviews = [json.loads(line) for line in take(values).splitlines() if line]


def optional_integer(value):
    return int(value) if value else None


def optional_boolean(value):
    return boolean(value) if value else None

warnings = []
warning_characters_omitted = 0
for raw_warning in values:
    warning, omitted = bounded(raw_warning, 256)
    warnings.append(warning)
    warning_characters_omitted += omitted

result = {
    "summary_schema_version": schema_version,
    "finalizer_version": version,
    "mode": mode,
    "status": status,
    "final_phase": phase,
    "exit_code": exit_code,
    "repository": repository or None,
    "repository_id": repository_id or None,
    "allocation_id": allocation_id or None,
    "task_key": task_key or None,
    "authority_key": authority_key or None,
    "worktree_path": worktree_path or None,
    "role": role or None,
    "branch": branch or None,
    "upstream": upstream or None,
    "requested_path_count": path_count,
    "dry_run": dry_run,
    "commit": {"created": commit_created, "sha": commit_sha or None},
    "push": {
        "executed": push_executed,
        "result": push_result,
        "branch_refspec_only": push_branch_refspec_only,
        "follow_tags_requested": push_follow_tags_requested,
    },
    "warnings": warnings,
    "warnings_omitted": warnings_omitted,
    "warning_characters_omitted": warning_characters_omitted,
    "reason": reason or None,
    "reason_omitted_characters": reason_omitted,
    "next_action": next_action,
    "next_action_omitted_characters": next_action_omitted,
}
if fixture_exceptions:
    result["fixture_exceptions"] = fixture_exceptions
if source_reviews:
    if status == "success" and not dry_run:
        for review in source_reviews:
            review["content_scan"] = "passed"
    result["reviewed_sensitive_sources"] = source_reviews
if mode == "initial":
    result["mode_result"] = {
        "initial_publish": mode_state,
        "snapshot_verification": snapshot_verification,
        "remote_conclusion": remote_conclusion,
        "post_verify": post_verify,
    }
elif mode == "initial_branch":
    result["mode_result"] = {
        "initial_branch_publish": mode_state,
        "remote_conclusion": remote_conclusion,
        "post_verify": post_verify,
    }
elif mode in {"publish_existing_branch", "publish_existing_history"}:
    interface = (
        "publish-existing-history"
        if mode == "publish_existing_history"
        else "publish-existing-branch"
    )
    result["mode_result"] = {
        "interface": interface,
        "commit_reused": commit_reused,
        "remote_conclusion": remote_conclusion,
        "pre_publish": {
            "commit_count": optional_integer(publish_commit_count_raw),
            "commit_range": publish_range or None,
        },
        "push_target": push_target or None,
        "post_verify": post_verify,
        "head": {
            "before": head_before or None,
            "after": head_after or None,
            "unchanged": head_unchanged,
        },
        "index_unchanged": index_unchanged,
        "worktree": {
            "before": worktree_before_state or None,
            "after": worktree_state or None,
            "unchanged": worktree_unchanged,
        },
        "final": {
            "head": final_head or None,
            "remote_ref_oid": final_remote_oid or None,
        },
    }
    if mode == "publish_existing_history":
        result["mode_result"]["bootstrap_prerequisite"] = "repo-plan/repo-ensure"
elif mode == "sync_published_branch":
    result["mode_result"] = {
        "interface": "sync-published-branch",
        "source_remote": sync_source_remote or None,
        "published_oid": commit_sha or None,
        "expected_target_oid": sync_expected_target_oid or None,
        "push_target": push_target or None,
        "commit_count": optional_integer(publish_commit_count_raw),
        "post_verify": post_verify,
        "remote_conclusion": remote_conclusion,
        "final_remote_oid": final_remote_oid or None,
        "local_head_unchanged": head_unchanged,
        "local_upstream_unchanged": head_unchanged and index_unchanged and worktree_unchanged,
    }
elif mode == "resume":
    resume_interface = {
        "initial_root": "resume-initial-publish",
        "existing_commits": "resume-publish",
        "existing_history_first": "resume-existing-history-publish",
    }.get(resume_publish_kind)
    result["mode_result"] = {
        "interface": resume_interface,
        "publish_kind": resume_publish_kind or None,
        "recovery_start": recovery_start or None,
        "commit_reused": commit_reused,
        "completed_through": completed_through,
        "resume_required": resume_required,
        "pre_publish": {
            "ahead": optional_integer(publish_ahead_raw),
            "behind": optional_integer(publish_behind_raw),
            "commit_count": optional_integer(publish_commit_count_raw),
            "commit_range": publish_range or None,
        },
        "push_target": push_target or None,
        "post_verify": post_verify,
        "final": {
            "head": final_head or None,
            "remote_ref_oid": final_remote_oid or None,
            "worktree": worktree_state or None,
        },
    }
elif mode == "initial-commit-only":
    result["mode_result"] = {
        "initial_root_commit": mode_state,
        "remote_verification": remote_conclusion,
        "post_verify": post_verify,
        "worktree": worktree_state or None,
    }
elif mode == "commit-only":
    result["mode_result"] = {
        "remote_verification": remote_conclusion,
        "post_verify": post_verify,
        "worktree": worktree_state or None,
    }
elif mode == "verify-only":
    result["mode_result"] = {
        "local_validation": mode_state,
        "commit": commit_result,
        "remote_verification": remote_conclusion,
        "post_verify": post_verify,
        "head": {
            "before": head_before or None,
            "after": head_after or None,
            "unchanged": head_unchanged,
        },
        "index_unchanged": index_unchanged,
        "worktree": {
            "before": worktree_before_state or None,
            "after": worktree_state or None,
            "unchanged": worktree_unchanged,
        },
    }
elif mode in {"retire_local_branch", "retire_remote_branch"}:
    operation_name = "local" if mode == "retire_local_branch" else "remote"
    result["mode_result"] = {
        "interface": f"retire-{operation_name}-branch",
        "operation": retirement_operation or None,
        "remote": retirement_remote or None,
        "branch": retirement_branch or None,
        f"{operation_name}_ref": retirement_ref or None,
        f"expected_{operation_name}_oid": retirement_expected_oid or None,
        "expected_oid": retirement_expected_oid or None,
        "retirement_plan_id": retirement_plan_id or None,
        "integrated_into_ref": retirement_integrated_ref or None,
        "integrated_into_oid": retirement_integrated_oid or None,
        "ancestry_verified": optional_boolean(retirement_ancestry_raw),
        "ci_required": retirement_ci_required,
        "ci_status": retirement_ci_status,
        "ci_commit_oid": retirement_ci_commit_oid or None,
        "ci_verification_source": retirement_ci_source,
        "ci_verified_at": retirement_ci_verified_at or None,
        "expected_oid_lease_bound": retirement_lease_bound,
        "remote_absent_after": optional_boolean(retirement_remote_absent_after_raw),
        "local_absent_after": optional_boolean(retirement_local_absent_after_raw),
        "remote_tracking_ref_absent": retirement_remote_tracking_absent,
        "head": {
            "before": head_before or None,
            "after": head_after or None,
            "unchanged": head_unchanged,
        },
        "index_unchanged": index_unchanged,
        "worktree": {
            "clean_before": worktree_before_state == "clean",
            "clean_after": worktree_state == "clean",
            "unchanged": worktree_unchanged,
        },
        "tags_unchanged": retirement_tags_unchanged,
        "result": retirement_result,
    }
    if retirement_receipt_id:
        result["mode_result"]["retirement_receipt_id"] = retirement_receipt_id
else:
    result["mode_result"] = {"post_verify": post_verify}
if resume_required:
    result["resume"] = {
        "head_oid": resume_oid,
        "remote": resume_remote,
    }

print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))
PY
}

emit_summary() {
    local operation_exit=$?

    trap - EXIT
    summary_exit_code=$operation_exit
    if ((operation_exit == 0)); then
        summary_status='success'
        summary_phase='complete'
        summary_reason=''
        summary_next_action=${summary_next_action:-none}
    elif [[ -z "$summary_reason" ]]; then
        summary_status='failed'
        summary_reason='operation exited without a classified failure reason'
        summary_next_action='rerun_without_summary_for_diagnostics'
    fi

    if ! render_summary >&3; then
        printf 'ERROR: Git Finalizer summary serialization failed; operation exit=%s\n' \
            "$operation_exit" >&4
        printf '{"summary_schema_version":%s,"finalizer_version":"%s",' \
            "$SUMMARY_SCHEMA_VERSION" "$VERSION" >&3
        printf '"summary_status":"serialization_failed","operation_status":"%s",' \
            "$summary_status" >&3
        printf '"operation_exit_code":%s}\n' "$operation_exit" >&3
    fi
    exec 3>&- 4>&-
    exit "$operation_exit"
}

