            "$retirement_integration_ref")
                ((retirement_integration_present == 0)) || {
                    retirement_remote_error='remote integration ref 返回重复结果'
                    return 1
                }
                retirement_integration_present=1
                retirement_integration_oid=$oid
                ;;
            *)
                retirement_remote_error='remote branch 查询返回范围外 ref'
                return 1
                ;;
        esac
    done <<<"$output"
}

capture_retirement_local_state() {
    local symbolic_head

    retirement_local_error=''
    if ! symbolic_head=$(git -C "$repo" symbolic-ref --quiet HEAD 2>/dev/null); then
        retirement_local_error='branch retirement 要求 symbolic attached branch'
        return 1
    fi
    if [[ "$symbolic_head" != refs/heads/* || "$symbolic_head" == 'refs/heads/' ]]; then
        retirement_local_error='branch retirement symbolic HEAD 不是本地 branch'
        return 1
    fi
    retirement_symbolic_head_before=$symbolic_head
    if ! retirement_head_before=$(
        git -C "$repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null
    ); then
        retirement_local_error='branch retirement 要求已有可解析 HEAD commit'
        return 1
    fi
    if ! git -C "$repo" diff --cached --quiet; then
        retirement_local_error='branch retirement 要求 index/staged 状态干净'
        return 1
    fi
    if ! retirement_status_before=$(
        GIT_OPTIONAL_LOCKS=0 git -C "$repo" status --porcelain=v1 --untracked-files=all
    ); then
        retirement_local_error='无法验证 retirement 前 worktree 状态'
        return 1
    fi
    if [[ -n "$retirement_status_before" ]]; then
        retirement_local_error='branch retirement 要求 worktree 完全干净（包括 untracked 文件）'
        return 1
    fi
    retirement_index_before=$(git -C "$repo" ls-files --stage) || {
        retirement_local_error='无法记录 retirement 前 index'
        return 1
    }
    retirement_tags_before=$(
        git -C "$repo" for-each-ref --format='%(objectname)%09%(refname)' refs/tags
    ) || {
        retirement_local_error='无法记录 retirement 前 tags'
        return 1
    }
    summary_branch=${symbolic_head#refs/heads/}
    summary_head_before=$retirement_head_before
    summary_worktree_before_state='clean'
}

