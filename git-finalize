    --run-id <controller-run-id> [--summary]
  git-finalize --retire-remote-branch <branch-name-or-refs/heads/ref>
    --remote <remote-name>
    --integrated-into <branch-name-or-matching-remote/branch-or-refs/heads/ref>
    --expected-remote-oid <full-oid> --repo <absolute-repo> [--dry-run] [--summary]
    [--ci-required --ci-status SUCCESS --ci-commit-oid <full-oid>
      --ci-verification-source <tool_authenticated|human_authenticated_ui>
      [--ci-verified-at <timestamp>]]
  git-finalize --retire-local-branch <branch-name-or-refs/heads/ref>
    --remote <remote-name>
    --integrated-into <branch-name-or-matching-remote/branch-or-refs/heads/ref>
    --expected-local-oid <full-oid> --expected-integrated-oid <full-oid>
    --retirement-plan-id <sha256> --repo <absolute-repo> [--dry-run] [--summary]

Options:
  --repo-plan                    Read-only Gitea repository/bootstrap decision.
  --repo-ensure                  Create or verify one empty Gitea repository; never publish.
  --gitea-url <url>              Credential-free Gitea web root; credentials use Git authority.
  --gitea-profile <label>        Optional non-secret profile label for the receipt.
  --owner <name>                 Exact personal or organization owner.
  --repo-name <name>             Exact Gitea repository name.
