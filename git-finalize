query_retirement_default_branch() {
    local output
    local status
    local left
    local name
    local extra

    retirement_remote_error=''
    retirement_default_ref=''
    if output=$(
        git -C "$repo" ls-remote --symref --quiet "$retirement_remote" HEAD 2>/dev/null
    ); then
        :
    else
        status=$?
        retirement_remote_error="无法查询 remote default branch（exit $status）"
        return 1
    fi
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        IFS=$'\t' read -r left name extra <<<"$line"
        if [[ "$left" == 'ref: refs/heads/'* && "$name" == 'HEAD' && -z "$extra" ]]; then
            [[ -z "$retirement_default_ref" ]] || {
                retirement_remote_error='remote default branch 返回重复 symbolic ref'
                return 1
            }
            retirement_default_ref=${left#ref: }
        fi
    done <<<"$output"
    if [[ -z "$retirement_default_ref" ]]; then
        retirement_remote_error='无法安全确定 remote default branch；retirement fail closed'
        return 1
    fi
}

query_retirement_refs() {
    local output
    local status
    local oid
    local ref_name
    local extra

    retirement_remote_error=''
    retirement_feature_present=0
    retirement_feature_oid=''
    retirement_integration_present=0
    retirement_integration_oid=''
    if output=$(
        git -C "$repo" ls-remote --quiet --refs "$retirement_remote" \
            "$retirement_feature_ref" "$retirement_integration_ref" 2>/dev/null
    ); then
        :
    else
        status=$?
        retirement_remote_error="remote branch 查询失败（exit $status）"
        return 1
    fi
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        IFS=$'\t' read -r oid ref_name extra <<<"$line"
        if [[ ! "$oid" =~ ^[0-9a-f]+$ || -n "$extra" ]]; then
            retirement_remote_error='remote branch 查询输出无法安全解析'
            return 1
        fi
        case "$ref_name" in
            "$retirement_feature_ref")
                ((retirement_feature_present == 0)) || {
                    retirement_remote_error='remote feature ref 返回重复结果'
                    return 1
                }
                retirement_feature_present=1
