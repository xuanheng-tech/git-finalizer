fail() {
    record_summary_failure "$*"
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

fail_after_commit() {
    summary_status='failed'
    summary_reason=$*
    summary_next_action='inspect_failure_with_local_commit_retained'
    printf 'ERROR: %s\n' "$*" >&2
    printf '本地提交 %s 已创建，但未完成 push；未执行 pull、rebase、merge 或 reset。\n' "$commit_hash" >&2
    exit 1
}

fail_created_commit() {
    if ((initial_publish == 1)); then
        fail_initial_after_commit "$@"
    elif ((initial_commit_only == 1)); then
        fail_initial_commit_only_after_commit "$@"
    elif ((initial_branch_publish == 1)); then
        fail_initial_branch_after_commit "$@"
    else
        fail_after_commit "$@"
    fi
}

fail_initial_after_commit() {
    summary_status='failed'
    summary_reason=$*
    summary_mode_state='commit_retained'
    summary_next_action='resume_initial_publish'
    summary_resume_required=true
    summary_resume_oid=$commit_hash
    summary_resume_remote=$initial_remote
    printf 'ERROR: %s\n' "$*" >&2
    printf '本地 root commit %s 已保留；不得重跑 --initial-publish。\n' "$commit_hash" >&2
    printf '恢复入口:\n' >&2
    printf '  git-finalize --resume-initial-publish %s --remote %q --repo %q\n' \
        "$commit_hash" "$initial_remote" "$repo" >&2
    exit 1
}

fail_initial_commit_only_after_commit() {
    summary_status='failed'
    summary_reason=$*
    summary_mode_state='commit_retained'
    summary_next_action='inspect_local_root_commit'
    summary_push_result='skipped_by_initial_commit_only'
    summary_post_verify='skipped_by_initial_commit_only'
    summary_remote_conclusion='skipped_by_initial_commit_only'
    printf 'ERROR: %s\n' "$*" >&2
    printf '本地 root commit %s 已保留；未访问或修改远端。\n' "$commit_hash" >&2
    exit 1
}

fail_initial_branch_after_commit() {
    local observed_upstream

    summary_status='failed'
    summary_reason=$*
    summary_mode_state='commit_retained'
    summary_next_action='inspect_initial_branch_publish_failure'
    if ! observed_upstream=$(
        git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null
    ); then
        observed_upstream='(none)'
    fi
    printf 'ERROR: %s\n' "$*" >&2
    printf '本地提交 %s 已保留；未执行 pull、rebase、merge、reset 或 force push。\n' \
        "$commit_hash" >&2
    printf '显式目标: %s/%s\n' "$branch_publish_remote" "$branch_publish_branch" >&2
    printf '当前 upstream: %s\n' "$observed_upstream" >&2
    exit 1
}

fail_publish_existing_branch() {
    local observed_upstream

    summary_status='failed'
    summary_reason=$*
    summary_next_action='inspect_existing_branch_publish_failure'
    summary_commit_reused=true
    summary_head_after=$(
        git -C "$repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null || printf '(unknown)'
    )
    if [[ "$summary_head_after" == "$resume_expected_oid" ]]; then
        summary_head_unchanged=true
    fi
    if ! observed_upstream=$(
        git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null
    ); then
        observed_upstream='(none)'
    fi
    printf 'ERROR: %s\n' "$*" >&2
    printf '本地 HEAD %s 未被 Finalizer 创建或改写；未执行 force push。\n' \
        "$resume_expected_oid" >&2
    printf '显式目标: %s/%s\n' "$branch_publish_remote" "$branch_publish_branch" >&2
    printf '当前 upstream: %s\n' "$observed_upstream" >&2
    exit 1
}

fail_existing_history_publish() {
    local observed_upstream

    summary_status='failed'
    summary_reason=$*
    summary_next_action='resume_existing_history_publish'
    summary_commit_reused=true
    summary_resume_required=true
    summary_resume_oid=$resume_expected_oid
    summary_resume_remote=$branch_publish_remote
    summary_head_after=$(
        git -C "$repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null || printf '(unknown)'
    )
    if [[ "$summary_head_after" == "$resume_expected_oid" ]]; then
        summary_head_unchanged=true
    fi
    if ! observed_upstream=$(
        git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null
    ); then
        observed_upstream='(none)'
    fi
    printf 'ERROR: %s\n' "$*" >&2
    printf '本地 HEAD %s 未被 Finalizer 创建或改写；未执行 force push。\n' \
        "$resume_expected_oid" >&2
    printf '显式目标: %s/%s\n' "$branch_publish_remote" "$branch_publish_branch" >&2
    printf '当前 upstream: %s\n' "$observed_upstream" >&2
    printf '若远端仍为空或仅有 expected target，可使用同一 OID 恢复：\n' >&2
    printf '  git-finalize --resume-existing-history-publish %s --remote %q --remote-branch %q --repo %q\n' \
        "$resume_expected_oid" "$branch_publish_remote" "$branch_publish_branch" "$repo" >&2
    exit 1
}

fail_resume_retryable() {
    summary_status='failed'
    summary_reason=$*
    summary_next_action='retry_same_resume'
    summary_resume_required=true
    summary_resume_oid=$resume_expected_oid
    summary_resume_remote=$resume_remote
    printf 'ERROR: %s\n' "$*" >&2
    printf '本地 HEAD %s 保持不变；可安全再次运行同一恢复命令:\n' \
        "$resume_expected_oid" >&2
    if [[ "$resume_cli_option" == '--resume-publish' ]]; then
        printf '  git-finalize --resume-publish %s --repo %q\n' \
            "$resume_expected_oid" "$repo" >&2
    else
        printf '  git-finalize --resume-initial-publish %s --remote %q --repo %q\n' \
            "$resume_expected_oid" "$resume_remote" "$repo" >&2
    fi
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "缺少必需命令: $1"
}

verify_initial_snapshot() {
    local source=$1

    "$PYTHON3_EXECUTABLE" -B "$snapshot_verifier" "$snapshot_id" "$repo" "$source" "${paths[@]}"
}

print_value_or() {
    local value=$1
    local empty_value=$2

    if [[ -n "$value" ]]; then
        printf '%s\n' "$value"
    else
        printf '%s\n' "$empty_value"
    fi
}

print_path() {
    printf '  - %q\n' "$1"
}

redact_stream() {
    sed -E \
        -e 's#(https?://)[^/@[:space:]]+@#\1[redacted]@#g' \
        -e 's#([?&](access_token|auth|credential|password|secret|token)=)[^&[:space:]]+#\1[redacted]#gI' \
        -e 's#(github_pat_|gh[pousr]_|sk-(proj-)?|xox[baprs]-)[A-Za-z0-9_.-]{8,}#\1[redacted]#g'
}

run_git_mutation() {
    local display=$1
    shift
    local output
    local status

    printf '$ %s\n' "$display"
    if output=$("$@" 2>&1); then
        if [[ -n "$output" ]]; then
            printf '%s\n' "$output" | redact_stream
        fi
        return 0
    else
        status=$?
        if [[ -n "$output" ]]; then
            printf '%s\n' "$output" | redact_stream >&2
        fi
        return "$status"
    fi
}

run_git_remote_command() {
    local display=$1
    shift
    local status

    printf '$ %s\n' "$display"
    if "$@" >/dev/null 2>&1; then
        printf '(completed)\n'
        return 0
    else
        status=$?
        printf 'remote check failed (exit %s)\n' "$status" >&2
        return "$status"
    fi
}

run_branch_push() {
    local set_upstream=$1
    local remote=$2
    local branch_refspec=$3
    local display='git push --no-follow-tags <remote> HEAD:<branch>'
    local -a command=(git -C "$repo" push --no-follow-tags)

    if [[ "$set_upstream" == true ]]; then
        display='git push --no-follow-tags --set-upstream <remote> HEAD:<branch>'
        command+=(--set-upstream)
    fi
    command+=("$remote" "$branch_refspec")

    summary_push_branch_refspec_only=true
    summary_push_follow_tags_disabled=true
    run_git_remote_command "$display" "${command[@]}"
}

sensitive_path_reason() {
    local path=${1,,}
    local env_re='(^|/)\.env($|[._-])'
    local marker_re='(^|[/._ -])(credentials?|secrets?|tokens?)([/._ -]|$)'
    local key_re='(^|[/._ -])(private|ssh)[._ -]?key([/._ -]|$)'
    local ssh_name_re='(^|/)(id_rsa|id_dsa|id_ecdsa|id_ed25519)(\.pub)?$'

    if [[ $path =~ $env_re ]]; then
        printf '.env 路径'
        return 0
    fi
    if [[ $path =~ $key_re ]] || [[ $path =~ $ssh_name_re ]]; then
        printf 'private key/SSH key 路径标记'
        return 0
    fi
    if [[ $path =~ $marker_re ]]; then
        printf 'credential/secret/token 路径标记'
        return 0
    fi
    return 1
}

load_source_reviews() {
    ((source_review_seen == 1)) || return 0
    local phase=$1
    local executable helper output path receipt reason
    executable=$(realpath -e -- "${BASH_SOURCE[0]}") || fail '无法解析 Finalizer 入口'
    helper=${executable%/*}/git-finalize-source-review.py
    [[ -f "$helper" && ! -L "$helper" ]] || fail '缺少 source review companion'
    output=$("$PYTHON3_EXECUTABLE" -B "$helper" --review "$source_review_file" \
        --repo "$repo" --phase "$phase" --repository-id "$repository_id_arg" \
        --allocation-id "$allocation_id_arg" --task-key "$task_key_arg" \
        --authority-key "$authority_key_arg" -- "${paths[@]}") ||
        fail 'reviewed-sensitive-source validation blocked'
    reviewed_source_paths=()
    summary_source_reviews=()
    while IFS=$'\t' read -r path receipt; do
        reason=$(sensitive_path_reason "$path") || fail 'review 只接受敏感源码路径'
        [[ "$reason" == 'credential/secret/token 路径标记' ]] ||
            fail 'review 不接受 .env 或 private/SSH key 路径'
        reviewed_source_paths["$path"]=1
        if [[ "$phase" == head ]]; then
            reviewed_source_paths["$path"]=$(git -C "$repo" rev-parse "HEAD:$path") ||
                fail '无法解析 reviewed source HEAD blob'
        fi
        summary_source_reviews+=("$receipt")
    done <<<"$output"
}

readonly assignment_re="(credentials?|password|passwd|secret|token|api[_-]?key|client[_-]?secret|access[_-]?token|refresh[_-]?token)['\"]?[[:space:]]*[:=][[:space:]]*['\"][^'\"]{12,}['\"]"

content_verdict_reason() {
    case "$1" in
        PRIVATE) printf 'private key 内容签名' ;;
        KNOWN) printf '高置信度 token/credential 内容签名' ;;
        SSH) printf 'SSH key 内容签名' ;;
        ASSIGNMENT) printf '疑似硬编码 credential/secret/token' ;;
        CLEAR) return 1 ;;
        *) printf '内容分类失败' ;;
    esac
}

working_content_reason() {
    content_verdict_reason "$(public_schema_content_verdict file "$1" "${2:-}" "${3:-}")"
}

staged_content_reason() {
    content_verdict_reason "$(public_schema_content_verdict blob "$1" "${2:-}" "${3:-}")"
}

is_working_large_binary() {
    local path=$1
    local size

    [[ -f "$path" && ! -L "$path" ]] || return 1
    size=$(stat -c '%s' -- "$path") || return 1
    ((size > MAX_BINARY_BYTES)) || return 1
    if LC_ALL=C grep -Iq -- . "$path"; then
        return 1
    fi
    return 0
}

get_index_entry() {
    local path=$1
    local entry
    local metadata

    entry=$(git -C "$repo" --literal-pathspecs ls-files -s -- "$path") || return 1
    [[ -n "$entry" && "$entry" == *$'\t'* ]] || return 1
    metadata=${entry%%$'\t'*}
    read -r index_mode index_oid index_stage <<<"$metadata"
    [[ "$index_stage" == "0" ]]
}

is_staged_large_binary() {
    local path=$1
    local size
    local numstat

    get_index_entry "$path" || return 1
    [[ $(git -C "$repo" cat-file -t "$index_oid" 2>/dev/null) == "blob" ]] || return 1
    size=$(git -C "$repo" cat-file -s "$index_oid") || return 1
    ((size > MAX_BINARY_BYTES)) || return 1
    numstat=$(git -C "$repo" --literal-pathspecs diff --cached --numstat --no-renames -- "$path")
    [[ "$numstat" == $'-\t-\t'* ]]
}

collect_staged_paths() {
    mapfile -d '' -t staged_paths < <(
        git -C "$repo" --literal-pathspecs diff --cached --name-only --no-renames -z
    )
}

is_staged_deletion() {
    local path=$1
    local diff_status

    # A staged deletion is absent from the index. Disable rename detection so the
    # old side of a rename is checked against HEAD as the same exact deletion.
    if git -C "$repo" --literal-pathspecs \
        diff --cached --no-renames --no-ext-diff --no-textconv \
            --quiet --diff-filter=D HEAD -- "$path"; then
        return 1
    else
        diff_status=$?
    fi
    ((diff_status == 1)) || return 1
}

is_retained_staged_deletion() {
    local path=$1
    local absolute_path=$repo/$path

    is_staged_deletion "$path" || return 1
    [[ -e "$absolute_path" || -L "$absolute_path" ]] || return 0
    git -C "$repo" check-ignore --quiet --no-index -- "$path"
}

check_staged_scope() {
    local path

    collect_staged_paths
    for path in "${staged_paths[@]}"; do
        if [[ -z ${allowed_paths[$path]+present} ]]; then
            fail "staged 文件超出显式范围: $(printf '%q' "$path")"
        fi
    done
}

check_test_fixture_staged_scope() {
    local path
    declare -A current_staged_paths=()

    ((${#test_fixture_paths[@]} > 0)) || return 0
    for path in "${staged_paths[@]}"; do
        current_staged_paths["$path"]=1
    done
    for path in "${paths[@]}"; do
        [[ -n ${current_staged_paths[$path]+present} ]] ||
            fail "test fixture 例外要求 staged 范围精确等于显式文件范围: $(printf '%q' "$path")"
    done
    for path in "${test_fixture_paths[@]}"; do
        get_index_entry "$path" ||
            fail "test fixture 必须作为普通文件出现在 staged 范围: $(printf '%q' "$path")"
        [[ "$index_mode" == '100644' || "$index_mode" == '100755' ]] ||
            fail "test fixture staged 条目必须是普通文件: $(printf '%q' "$path")"
    done
}

check_large_binary_staged_scope() {
    local path
    local staged_size
    declare -A current_staged_paths=()

    ((${#large_binary_paths[@]} > 0)) || return 0
    for path in "${staged_paths[@]}"; do
        current_staged_paths["$path"]=1
    done
    for path in "${large_binary_paths[@]}"; do
        [[ -n ${current_staged_paths[$path]+present} ]] ||
            fail "大二进制例外目标未进入 staged 范围: $(printf '%q' "$path")"
        get_index_entry "$path" ||
            fail "大二进制例外目标必须作为普通文件进入 staged 范围: $(printf '%q' "$path")"
        [[ "$index_mode" == '100644' || "$index_mode" == '100755' ]] ||
            fail "大二进制例外目标的 staged 条目必须是普通文件: $(printf '%q' "$path")"
        is_staged_large_binary "$path" ||
            fail "大二进制例外目标的 staged blob 必须大于 5 MiB: $(printf '%q' "$path")"
        staged_size=$(git -C "$repo" cat-file -s "$index_oid") ||
            fail "无法读取大二进制 staged blob 大小: $(printf '%q' "$path")"
        ((staged_size <= MAX_ALLOWED_LARGE_BINARY_BYTES)) ||
            fail "大二进制例外目标超过 25 MiB 硬上限: $(printf '%q' "$path")"
    done
}

print_snapshot() {
    local head
    local status
    local remotes

    current_branch=$(git -C "$repo" branch --show-current)
    if ! head=$(git -C "$repo" rev-parse HEAD 2>/dev/null); then
        head='(unborn HEAD)'
    fi
    status=$(git -C "$repo" status --short)
    if ((verify_only == 1)); then
        remotes=''
        current_upstream=''
    else
        remotes=$(git -C "$repo" remote)
        if ! current_upstream=$(
            git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null
        ); then
            current_upstream=''
        fi
    fi
    summary_branch=$current_branch
    summary_upstream=$current_upstream

    printf '\n== Git Finalizer v%s: 提交前状态 ==\n' "$VERSION"
    printf '$ git branch --show-current\n'
    print_value_or "$current_branch" '(detached)'
    printf '$ git rev-parse HEAD\n%s\n' "$head"
    printf '$ git status --short\n'
    print_value_or "$status" '(clean)'
    printf '$ git remote\n'
    if ((verify_only == 1)); then
        printf '(skipped by verify-only)\n'
    elif [[ -n "$remotes" ]]; then
        printf '%s\n' "$remotes"
    else
        printf '(none)\n'
    fi
    printf '$ git rev-parse --abbrev-ref --symbolic-full-name @{upstream}\n'
    if ((verify_only == 1)); then
        printf '(skipped by verify-only)\n'
    else
        print_value_or "$current_upstream" '(none)'
    fi
}

classify_branch_upstream() {
    local branch_name=$1
    local selected_remote=$2
    local expected_merge_ref=$3
    local remote_status=0
    local merge_status=0
    local resolved_upstream
    local -a remote_values=()
    local -a merge_values=()

    branch_upstream_state=''
    branch_upstream_oid=''
    branch_upstream_error=''

    git -C "$repo" config --get-all "branch.$branch_name.remote" \
        >/dev/null 2>&1 || remote_status=$?
    git -C "$repo" config --get-all "branch.$branch_name.merge" \
        >/dev/null 2>&1 || merge_status=$?
    if ((remote_status != 0 && remote_status != 1)) ||
        ((merge_status != 0 && merge_status != 1)); then
        branch_upstream_state='conflicting'
        branch_upstream_error='upstream 配置无法安全读取'
        return 0
    fi
    if ((remote_status == 0)); then
        mapfile -d '' -t remote_values < <(
            git -C "$repo" config --null --get-all "branch.$branch_name.remote"
        )
    fi
    if ((merge_status == 0)); then
        mapfile -d '' -t merge_values < <(
            git -C "$repo" config --null --get-all "branch.$branch_name.merge"
        )
    fi

    if ((${#remote_values[@]} == 0 && ${#merge_values[@]} == 0)); then
        branch_upstream_state='none'
        return 0
    fi
    if ((${#remote_values[@]} != 1 || ${#merge_values[@]} != 1)) ||
        [[ -z "${remote_values[0]-}" || -z "${merge_values[0]-}" ]] ||
        [[ "${remote_values[0]}" != "$selected_remote" ||
            "${merge_values[0]}" != "$expected_merge_ref" ]]; then
        branch_upstream_state='conflicting'
        branch_upstream_error='upstream 配置与 selected remote/branch 冲突或含糊'
        return 0
    fi

    if resolved_upstream=$(
        git -C "$repo" rev-parse --verify '@{upstream}^{commit}' 2>/dev/null
    ); then
        if [[ ! "$resolved_upstream" =~ ^[0-9a-f]+$ ||
            "$resolved_upstream" == *$'\n'* ]]; then
            branch_upstream_state='conflicting'
            branch_upstream_error='upstream commit 输出无法安全解析'
            return 0
        fi
        branch_upstream_state='exact_resolved'
        branch_upstream_oid=$resolved_upstream
    else
        branch_upstream_state='exact_unresolved'
    fi
}

resolve_local_commit_target() {
    local mode=$1
    local head_ref
    local show_ref_status

    local_commit_target_error=''
    local_commit_branch_ref=''
    [[ -n "$current_branch" ]] || {
        local_commit_target_error='当前为 detached HEAD，拒绝 commit'
        return 1
    }

    if ! head_ref=$(git -C "$repo" symbolic-ref --quiet HEAD 2>/dev/null); then
        local_commit_target_error='当前 HEAD 不是 symbolic attached branch，拒绝 commit'
        return 1
    fi
    [[ "$head_ref" == "refs/heads/$current_branch" ]] || {
        local_commit_target_error='当前 symbolic HEAD 与 branch 名不一致，拒绝 commit'
        return 1
    }

    if ! git -C "$repo" rev-parse --verify 'HEAD^{commit}' >/dev/null 2>&1; then
        if git -C "$repo" show-ref --verify --quiet "$head_ref"; then
            local_commit_target_error='当前 HEAD 无法解析为 commit，拒绝 commit'
        else
            show_ref_status=$?
            if ((show_ref_status == 1)); then
                case "$mode" in
                    normal)
                        local_commit_target_error='当前为 unborn HEAD；正常模式拒绝 commit'
                        ;;
                    commit-only)
                        local_commit_target_error='当前为 unborn HEAD；commit-only 模式拒绝 commit'
                        ;;
                    verify-only)
                        local_commit_target_error='当前为 unborn HEAD；verify-only 模式拒绝验证'
                        ;;
                esac
            else
                local_commit_target_error='当前 branch ref 无效，拒绝 commit'
            fi
        fi
        return 1
    fi

    local_commit_branch_ref=$head_ref
}

verify_local_candidate() {
    local index
    local path
    local absolute_path
    local command_status
    local whitespace_output
    local candidate_count=0
    local candidate_temp_checked=0
    local candidate_result verdict size binary digest filtered_oid raw_oid reason candidate_rules
    declare -A candidate_paths=()

    summary_phase='local_validation'
    if [[ -n $(git -C "$repo" ls-files -u) ]]; then
        fail 'index 存在未解决冲突；未执行 commit 或 push'
    fi

    for index in "${!paths[@]}"; do
        path=${paths[$index]}
        absolute_path=${absolute_paths[$index]}
        if [[ -n ${retained_staged_deletions[$path]+present} ]]; then
            candidate_paths["$path"]=1
            candidate_count=$((candidate_count + 1))
            continue
        fi

        if git -C "$repo" --literal-pathspecs ls-files --error-unmatch -- "$path" \
            >/dev/null 2>&1; then
            if git -C "$repo" --literal-pathspecs diff --quiet --no-ext-diff \
                --no-textconv HEAD -- "$path"; then
                continue
            else
                command_status=$?
            fi
            ((command_status == 1)) ||
                fail "无法只读验证候选文件: $(printf '%q' "$path")"
        else
            command_status=$?
            ((command_status == 1)) ||
                fail "无法判断候选文件是否 tracked: $(printf '%q' "$path")"
            if git -C "$repo" check-ignore --quiet --no-index -- "$path"; then
                fail "ignored 文件无法进入提交范围: $(printf '%q' "$path")"
            else
                command_status=$?
            fi
            ((command_status == 1)) ||
                fail "无法验证 ignore 状态: $(printf '%q' "$path")"

            if whitespace_output=$(git -C "$repo" diff --no-index --no-ext-diff \
                --no-textconv --check -- /dev/null "$absolute_path" 2>&1); then
                command_status=0
            else
                command_status=$?
            fi
            ((command_status == 0 || command_status == 1)) ||
                fail "无法只读检查候选文件 whitespace: $(printf '%q' "$path")"
            [[ -z "$whitespace_output" ]] ||
                fail 'git diff --check 失败；未执行 add、commit 或 push'
        fi

        candidate_paths["$path"]=1
        candidate_count=$((candidate_count + 1))

        # Check the blob Git would stage, including clean filters and encoding.
        if [[ -f "$absolute_path" && ! -L "$absolute_path" ]]; then
            if ((candidate_temp_checked == 0)); then
                if ! "$PYTHON3_EXECUTABLE" -B - <<'PY'
import tempfile
from pathlib import Path

try:
    with tempfile.TemporaryDirectory(prefix="gf-candidate-probe-") as directory:
        (Path(directory) / "write-test").touch()
except OSError:
    raise SystemExit(1)
PY
                then
                    fail 'candidate object temporary directory is unavailable; validation requires temporary writes; use an executor-authorized writable temporary directory or native channel; no add, commit or push'
                fi
                candidate_temp_checked=1
            fi
            candidate_rules=''
            if [[ -n ${history_fixture_paths[$path]+present} ]]; then
                raw_oid=$(git -C "$repo" hash-object --no-filters -- "$path") ||
                    fail '无法只读复核 candidate fixture raw blob'
                candidate_rules=${history_fixture_rules[$path:$raw_oid]-}
            fi
            candidate_result=$(public_schema_content_verdict candidate "$path" "$candidate_rules" '')
            read -r verdict size binary digest filtered_oid <<<"$candidate_result"
            [[ "$size" =~ ^[0-9]+$ && "$binary" =~ ^[01]$ &&
               "$digest" =~ ^[0-9a-f]{64}$ && "$filtered_oid" =~ ^[0-9a-f]+$ ]] ||
                fail '无法只读验证 clean-filter candidate blob；未执行 add、commit 或 push'
            if [[ -z ${test_fixture_content_overrides[$path]+present} ]] &&
                reason=$(content_verdict_reason "$verdict"); then
                fail "拒绝候选敏感文件 $(printf '%q' "$path"): $reason"
            fi
            if ((binary == 1 && size > MAX_BINARY_BYTES)); then
                [[ -n ${large_binary_overrides[$path]+present} ]] ||
                    fail "拒绝候选的大于 5 MiB 明显二进制文件: $(printf '%q' "$path")"
                ((size <= MAX_ALLOWED_LARGE_BINARY_BYTES)) ||
                    fail 'clean-filter candidate blob 超过 25 MiB 硬上限'
            fi
            if [[ -n ${large_binary_overrides[$path]+present} ]] &&
                ((binary != 1 || size <= MAX_BINARY_BYTES)); then
                fail 'large binary exception requires a filtered candidate above 5 MiB'
            fi
            if [[ -n ${reviewed_source_paths[$path]+present} ]]; then
                raw_oid=$(git -C "$repo" hash-object --no-filters -- "$path") ||
                    fail '无法只读验证 reviewed source raw blob'
                [[ "$filtered_oid" == "$raw_oid" ]] ||
                    fail 'reviewed source clean-filter blob 已漂移；未执行 add、commit 或 push'
            fi
        fi
    done

    ((candidate_count > 0)) || fail 'staged diff 为空；未执行 commit 或 push'

    if ((${#paths_to_add[@]} > 0)) &&
        ! git -C "$repo" --literal-pathspecs diff --no-ext-diff --no-textconv \
            --check HEAD -- "${paths_to_add[@]}" >/dev/null; then
        fail 'git diff --check 失败；未执行 add、commit 或 push'
    fi

    if ((${#test_fixture_paths[@]} > 0)); then
        for path in "${paths[@]}"; do
            [[ -n ${candidate_paths[$path]+present} ]] ||
                fail "test fixture 例外要求候选范围精确等于显式文件范围: $(printf '%q' "$path")"
        done
    fi
    for path in "${large_binary_paths[@]}"; do
        [[ -n ${candidate_paths[$path]+present} ]] ||
            fail "大二进制例外目标未进入候选范围: $(printf '%q' "$path")"
    done
    if ((fixture_exceptions_seen == 1 && (verify_only == 1 || commit_only == 1))); then
        declare -A changed_index_paths=()
        local fixture_key
        for path in "${staged_paths[@]}"; do
            changed_index_paths["$path"]=1
        done
        for path in "${!history_fixture_paths[@]}"; do
            [[ -n ${candidate_paths[$path]+present} ]] ||
                fail 'local fixture review 未进入候选范围；未执行 add、commit 或 push'
            raw_oid=$(git -C "$repo" hash-object --no-filters -- "$path") ||
                fail '无法只读复核 local fixture raw blob'
            fixture_key=$path:$raw_oid:credential-assignment-v1
            [[ -n ${history_fixture_exceptions[$fixture_key]+present} ]] ||
                fail 'local fixture review raw blob 已漂移；未执行 add、commit 或 push'
            filtered_oid=$(git -C "$repo" hash-object --path="$path" -- "$path") ||
                fail '无法只读复核 local fixture clean-filter blob'
            [[ "$filtered_oid" == "$raw_oid" ]] ||
                fail 'local fixture review clean-filter blob 已漂移；未执行 add、commit 或 push'
            if [[ -n ${changed_index_paths[$path]+present} ]]; then
                get_index_entry "$path" ||
                    fail 'local fixture review staged entry 无效；未执行 add、commit 或 push'
                [[ "$index_oid" == "$raw_oid" &&
                   ("$index_mode" == '100644' || "$index_mode" == '100755') ]] ||
                    fail 'local fixture review staged blob 已漂移；未执行 add、commit 或 push'
                staged_content_reason "$index_oid" '' credential-assignment-v1 >/dev/null ||
                    fail 'local fixture review detector 未命中 staged blob'
            fi
            if ((verify_only == 1)); then
                summary_fixture_exceptions+=("${history_fixture_exceptions[$fixture_key]}")
            fi
        done
    fi
}

resolve_normal_target() {
    local head_ref
    local upstream_details
    local branch_push_remote
    local default_push_remote
    local effective_push_remote
    local fetch_urls
    local push_urls

    normal_target_error=''
    if ! resolve_local_commit_target normal; then
        normal_target_error=$local_commit_target_error
        return 1
    fi
    head_ref=$local_commit_branch_ref

    if ! upstream_details=$(
        git -C "$repo" for-each-ref \
            --format='%(upstream:short)%09%(upstream:remotename)%09%(upstream:remoteref)' \
            "$head_ref"
    ); then
        normal_target_error='无法解析当前分支 upstream'
        return 1
    fi
    if [[ -z "$upstream_details" || "$upstream_details" == *$'\n'* ]]; then
        normal_target_error='当前分支不存在唯一可解析的 upstream'
        return 1
    fi
    IFS=$'\t' read -r upstream_name upstream_remote upstream_branch_ref <<<"$upstream_details"
    if [[ -z "$upstream_name" || -z "$upstream_remote" ||
        "$upstream_remote" == '.' || "$upstream_branch_ref" != refs/heads/* ]]; then
        normal_target_error='upstream 不是可验证的远端 branch'
        return 1
    fi

    classify_branch_upstream "$current_branch" "$upstream_remote" "$upstream_branch_ref"
    if [[ "$branch_upstream_state" != 'exact_resolved' ]]; then
        normal_target_error=${branch_upstream_error:-'正常模式要求精确且可解析的 upstream'}
        return 1
    fi

    branch_push_remote=$(
        git -C "$repo" config --get-all "branch.$current_branch.pushRemote" 2>/dev/null || true
    )
    default_push_remote=$(git -C "$repo" config --get-all remote.pushDefault 2>/dev/null || true)
    if [[ "$branch_push_remote" == *$'\n'* || "$default_push_remote" == *$'\n'* ]]; then
        normal_target_error='push remote 配置含糊，无法证明唯一 push 目标'
        return 1
    fi
    effective_push_remote=${branch_push_remote:-${default_push_remote:-$upstream_remote}}
    [[ "$effective_push_remote" == "$upstream_remote" ]] || {
        normal_target_error='实际 push remote 与 upstream remote 不一致'
        return 1
    }

    if ! fetch_urls=$(git -C "$repo" remote get-url --all "$upstream_remote" 2>/dev/null) ||
        [[ -z "$fetch_urls" || "$fetch_urls" == *$'\n'* ]]; then
        normal_target_error='upstream remote 缺失或配置了多个 fetch endpoint'
        return 1
    fi
    if ! push_urls=$(git -C "$repo" remote get-url --push --all "$upstream_remote" 2>/dev/null) ||
        [[ -z "$push_urls" || "$push_urls" == *$'\n'* ]]; then
        normal_target_error='upstream remote 缺失或配置了多个 push endpoint'
        return 1
    fi
    [[ "$fetch_urls" == "$push_urls" ]] || {
        normal_target_error='upstream 的 fetch 与 push endpoint 不一致'
        return 1
    }
}

query_remote_branch() {
    local output
    local status
    local ref_name
    local extra

    remote_query_error=''
    if output=$(
        git -C "$repo" ls-remote --quiet --refs "$upstream_remote" \
            "$upstream_branch_ref" 2>/dev/null
    ); then
        :
    else
        status=$?
        remote_query_error="远端 branch 查询失败（exit $status）"
        return 1
    fi
    if [[ -z "$output" ]]; then
        remote_query_error="远端 branch 不存在: $upstream_branch_ref"
        return 1
    fi
    if [[ "$output" == *$'\n'* ]]; then
        remote_query_error="远端 branch 查询返回含糊结果: $upstream_branch_ref"
        return 1
    fi

    IFS=$'\t' read -r remote_branch_oid ref_name extra <<<"$output"
    if [[ ! "$remote_branch_oid" =~ ^[0-9a-f]+$ ||
        "$ref_name" != "$upstream_branch_ref" || -n "$extra" ]]; then
        remote_query_error="远端 branch 查询结果无效: $upstream_branch_ref"
        return 1
    fi
}

check_normal_remote_state() {
    local phase=$1
    local local_hash
    local upstream_hash
    local counts
    local ahead
    local behind

    normal_remote_error=''
    normal_local_hash=''
    normal_upstream_hash=''
    normal_ahead=''
    normal_behind=''
    if ! run_git_remote_command 'git fetch <upstream remote>' \
        git -C "$repo" fetch --no-tags --no-recurse-submodules "$upstream_remote"; then
        normal_remote_error="$phase git fetch 失败"
        return 1
    fi
    if ! query_remote_branch; then
        normal_remote_error="$phase $remote_query_error"
        return 1
    fi
    if ! upstream_hash=$(git -C "$repo" rev-parse --verify '@{upstream}^{commit}' 2>/dev/null); then
        normal_remote_error="$phase upstream 无法解析为 commit: $upstream_name"
        return 1
    fi
    if [[ "$upstream_hash" != "$remote_branch_oid" ]]; then
        normal_remote_error="$phase fetch 后 upstream 与远端 branch OID 不一致"
        return 1
    fi
    if ! local_hash=$(git -C "$repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null); then
        normal_remote_error="$phase HEAD 无法解析为 commit"
        return 1
    fi
    if ! counts=$(
        git -C "$repo" rev-list --left-right --count "$local_hash...$upstream_hash" 2>/dev/null
    ); then
        normal_remote_error="$phase 无法计算 HEAD 与 upstream 的 ahead/behind"
        return 1
    fi
    read -r ahead behind <<<"$counts"
    if [[ ! "$ahead" =~ ^[0-9]+$ || ! "$behind" =~ ^[0-9]+$ ]]; then
        normal_remote_error="$phase ahead/behind 输出无效"
        return 1
    fi
    if ((behind > 0)); then
        if ((ahead > 0)); then
            normal_remote_error="$phase 本地已与 upstream 分叉（HEAD...upstream ahead/behind: $ahead/$behind）"
        else
            normal_remote_error="$phase 本地落后 upstream（HEAD...upstream ahead/behind: $ahead/$behind）"
        fi
        return 1
    fi

    normal_local_hash=$local_hash
    normal_upstream_hash=$upstream_hash
    normal_ahead=$ahead
    normal_behind=$behind

    printf 'upstream: %s\n' "$upstream_name"
    printf 'remote branch: %s\n' "$upstream_branch_ref"
    printf 'ahead/behind: %s/%s\n' "$ahead" "$behind"
    printf 'fast-forward check: passed\n'
}

resolve_initial_target() {
    local require_remote=${1:-1}
    local symbolic_head
    local show_ref_status
    local existing_commit
    local configured_remotes
    local fetch_urls
    local push_urls

    initial_target_error=''
    if ! symbolic_head=$(git -C "$repo" symbolic-ref --quiet HEAD 2>/dev/null); then
        initial_target_error='initial root commit 要求 symbolic attached branch'
        return 1
    fi
    if [[ "$symbolic_head" != refs/heads/* || "$symbolic_head" == 'refs/heads/' ]]; then
        initial_target_error='initial root commit 的 symbolic HEAD 不是本地 branch'
        return 1
    fi
    initial_branch_ref=$symbolic_head
    initial_branch=${initial_branch_ref#refs/heads/}
    if [[ "$current_branch" != "$initial_branch" ]]; then
        initial_target_error='symbolic HEAD 与当前 branch 名不一致'
        return 1
    fi

    if git -C "$repo" show-ref --verify --quiet "$initial_branch_ref"; then
        initial_target_error='initial root commit 只接受 branch ref 尚不存在的 unborn 仓库'
        return 1
    else
        show_ref_status=$?
        if ((show_ref_status != 1)); then
            initial_target_error='无法安全确认当前 branch ref 尚不存在'
            return 1
        fi
    fi
    if git -C "$repo" rev-parse --verify 'HEAD^{commit}' >/dev/null 2>&1; then
        initial_target_error='initial root commit 不接受已有 HEAD commit 的仓库'
        return 1
    fi
    if ! existing_commit=$(git -C "$repo" rev-list --all --max-count=1 2>/dev/null); then
        initial_target_error='无法确认本地仓库不存在可解析 commit'
        return 1
    fi
    if [[ -n "$existing_commit" ]]; then
        initial_target_error='initial root commit 不接受已有可解析 commit 的仓库'
        return 1
    fi

    if ((require_remote == 0)); then
        initial_remote=''
        return 0
    fi

    if [[ -z "$remote_arg" || "$remote_arg" == -* ||
        "$remote_arg" == *$'\n'* || "$remote_arg" == *$'\r'* || "$remote_arg" == *$'\t'* ]]; then
        initial_target_error='--remote 必须是有效的已配置 remote 名'
        return 1
    fi
    if ! configured_remotes=$(git -C "$repo" remote 2>/dev/null); then
        initial_target_error='无法读取已配置 remote'
        return 1
    fi
    if ! grep -Fxq -- "$remote_arg" <<<"$configured_remotes"; then
        initial_target_error="未配置指定 remote: $remote_arg"
        return 1
    fi
    initial_remote=$remote_arg

    classify_branch_upstream "$initial_branch" "$initial_remote" "$initial_branch_ref"
    case "$branch_upstream_state" in
        none|exact_unresolved) ;;
        exact_resolved)
            initial_target_error='initial-publish 不接受可解析 upstream'
            return 1
            ;;
        conflicting)
            initial_target_error=$branch_upstream_error
            return 1
            ;;
    esac

    if ! fetch_urls=$(git -C "$repo" remote get-url --all "$initial_remote" 2>/dev/null) ||
        [[ -z "$fetch_urls" || "$fetch_urls" == *$'\n'* ]]; then
        initial_target_error='initial remote 缺失或配置了多个 fetch endpoint'
        return 1
    fi
    if ! push_urls=$(git -C "$repo" remote get-url --push --all "$initial_remote" 2>/dev/null) ||
        [[ -z "$push_urls" || "$push_urls" == *$'\n'* ]]; then
        initial_target_error='initial remote 缺失或配置了多个 push endpoint'
        return 1
    fi
    if [[ "$fetch_urls" != "$push_urls" ]]; then
        initial_target_error='initial remote 的 fetch 与 push endpoint 不一致'
        return 1
    fi
}

check_initial_worktree_scope() {
    local entry
    local path

    initial_scope_error=''
    while IFS= read -r -d '' entry; do
        if ((${#entry} < 4)); then
            initial_scope_error='无法解析 initial root worktree 状态'
            return 1
        fi
        path=${entry:3}
        if [[ -z ${allowed_paths[$path]+present} ]]; then
            initial_scope_error="initial root 存在显式范围外改动: $(printf '%q' "$path")"
            return 1
        fi
    done < <(
        git -C "$repo" --literal-pathspecs status --porcelain=v1 -z --untracked-files=all
    )
}

check_initial_remote_empty() {
    local output
    local status

    initial_remote_error=''
    if output=$(git -C "$repo" ls-remote --quiet "$initial_remote" 2>/dev/null); then
        :
    else
        status=$?
        initial_remote_error="远端空状态查询失败（exit $status）"
        return 1
    fi
    if [[ -n "$output" ]]; then
        initial_remote_error='远端不是完全空 remote'
        return 1
    fi
    printf 'remote empty check: passed\n'
}

verify_initial_root_commit() {
    local resolved_head
    local parent_line
    local symbolic_head
    local path
    declare -A expected_paths=()

    initial_commit_error=''
    if ! resolved_head=$(git -C "$repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null) ||
        [[ "$resolved_head" != "$commit_hash" ]]; then
        initial_commit_error='root commit 后 HEAD 无法精确解析'
        return 1
    fi
    if ! parent_line=$(git -C "$repo" rev-list --parents -n 1 "$commit_hash" 2>/dev/null) ||
        [[ "$parent_line" != "$commit_hash" ]]; then
        initial_commit_error='initial 模式创建的 commit 不是 root commit'
        return 1
    fi
    if ((${#committed_paths[@]} == 0)); then
        initial_commit_error='initial 模式不允许空 root commit'
        return 1
    fi
    if ((${#committed_paths[@]} != ${#staged_paths[@]})); then
        initial_commit_error='root commit 文件范围与 staged 范围不一致'
        return 1
    fi
    for path in "${staged_paths[@]}"; do
        expected_paths["$path"]=1
    done
    for path in "${committed_paths[@]}"; do
        if [[ -z ${expected_paths[$path]+present} ]]; then
            initial_commit_error='root commit 文件范围与 staged 范围不一致'
            return 1
        fi
    done
    if ! symbolic_head=$(git -C "$repo" symbolic-ref --quiet HEAD 2>/dev/null) ||
        [[ "$symbolic_head" != "$initial_branch_ref" ]]; then
        initial_commit_error='root commit 后 symbolic branch 发生变化'
        return 1
    fi
}

query_initial_published_remote() {
    local output
    local status
    local ref_name
    local extra

    initial_remote_error=''
    if output=$(git -C "$repo" ls-remote --quiet --refs "$initial_remote" 2>/dev/null); then
        :
    else
        status=$?
        initial_remote_error="push 后远端 ref 查询失败（exit $status）"
        return 1
    fi
    if [[ -z "$output" || "$output" == *$'\n'* ]]; then
        initial_remote_error='push 后远端 ref 集合不是唯一目标 branch'
        return 1
    fi
    IFS=$'\t' read -r initial_remote_oid ref_name extra <<<"$output"
    if [[ ! "$initial_remote_oid" =~ ^[0-9a-f]+$ ||
        "$ref_name" != "$initial_branch_ref" || -n "$extra" ]]; then
        initial_remote_error='push 后远端 ref 集合不是唯一目标 branch'
        return 1
    fi
}

is_protected_branch() {
    case "$1" in
        main|master|trunk|production) return 0 ;;
        *) return 1 ;;
    esac
}

is_special_lifecycle_branch() {
    case "$1" in
        rescue|rescue/*|archive|archive/*|recovery|recovery/*) return 0 ;;
        *) return 1 ;;
    esac
}

resolve_initial_branch_target() {
    local symbolic_head
    local configured_remotes
    local fetch_urls
    local push_urls

    branch_publish_target_error=''
    if ! symbolic_head=$(git -C "$repo" symbolic-ref --quiet HEAD 2>/dev/null); then
        branch_publish_target_error='initial-branch-publish 要求 symbolic attached branch'
        return 1
    fi
    if [[ "$symbolic_head" != refs/heads/* || "$symbolic_head" == 'refs/heads/' ]]; then
        branch_publish_target_error='initial-branch-publish symbolic HEAD 不是本地 branch'
        return 1
    fi
    branch_publish_branch_ref=$symbolic_head
    branch_publish_branch=${branch_publish_branch_ref#refs/heads/}
    if [[ "$current_branch" != "$branch_publish_branch" ]]; then
        branch_publish_target_error='symbolic HEAD 与当前 branch 名不一致'
        return 1
    fi
    if is_protected_branch "$branch_publish_branch" &&
        ((publish_existing_history == 0 && resume_existing_history == 0)); then
        branch_publish_target_error="initial-branch-publish 拒绝受保护分支: $branch_publish_branch"
        return 1
    fi
    if ! git -C "$repo" check-ref-format --branch "$remote_branch_arg" >/dev/null 2>&1; then
        branch_publish_target_error='--remote-branch 不是有效的 branch 名'
        return 1
    fi
    if [[ "$remote_branch_arg" != "$branch_publish_branch" ]]; then
        branch_publish_target_error='本地 branch 名必须与 --remote-branch 完全一致'
        return 1
    fi
    if ! branch_publish_base_head=$(
        git -C "$repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null
    ); then
        branch_publish_target_error='initial-branch-publish 要求已有可解析 HEAD commit'
        return 1
    fi
    if ! git -C "$repo" show-ref --verify --quiet "$branch_publish_branch_ref"; then
        branch_publish_target_error='initial-branch-publish 要求已有本地 branch ref'
        return 1
    fi

    if ! configured_remotes=$(git -C "$repo" remote 2>/dev/null); then
        branch_publish_target_error='无法读取已配置 remote'
        return 1
    fi
    if ! grep -Fxq -- "$remote_arg" <<<"$configured_remotes"; then
        branch_publish_target_error="未配置指定 remote: $remote_arg"
        return 1
    fi
    branch_publish_remote=$remote_arg
    if ! fetch_urls=$(git -C "$repo" remote get-url --all "$branch_publish_remote" 2>/dev/null) ||
        [[ -z "$fetch_urls" || "$fetch_urls" == *$'\n'* ]]; then
        branch_publish_target_error='initial-branch remote 缺失或配置了多个 fetch endpoint'
        return 1
    fi
    if ! push_urls=$(
        git -C "$repo" remote get-url --push --all "$branch_publish_remote" 2>/dev/null
    ) || [[ -z "$push_urls" || "$push_urls" == *$'\n'* ]]; then
        branch_publish_target_error='initial-branch remote 缺失或配置了多个 push endpoint'
        return 1
    fi
    if [[ "$fetch_urls" != "$push_urls" ]]; then
        branch_publish_target_error='initial-branch remote 的 fetch 与 push endpoint 不一致'
        return 1
    fi
}

inspect_initial_branch_remote() {
    local output
    local status
    local line
    local oid
    local ref_name
    local extra

    branch_publish_remote_error=''
    branch_publish_target_present=0
    branch_publish_target_oid=''
    branch_publish_other_refs=''
    if output=$(git -C "$repo" ls-remote --quiet --refs "$branch_publish_remote" 2>/dev/null); then
        :
    else
        status=$?
        branch_publish_remote_error="initial-branch 远端 ref 查询失败（exit $status）"
        return 1
    fi
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        IFS=$'\t' read -r oid ref_name extra <<<"$line"
        if [[ ! "$oid" =~ ^[0-9a-f]+$ || "$ref_name" != refs/* || -n "$extra" ]]; then
            branch_publish_remote_error='initial-branch 远端 ref 输出无法安全解析'
            return 1
        fi
        if [[ "$ref_name" == "$branch_publish_branch_ref" ]]; then
            if ((branch_publish_target_present == 1)); then
                branch_publish_remote_error='initial-branch 远端目标 ref 返回重复结果'
                return 1
            fi
            branch_publish_target_present=1
            branch_publish_target_oid=$oid
        else
            branch_publish_other_refs+="$oid"$'\t'"$ref_name"$'\n'
        fi
    done <<<"$output"
}

capture_initial_branch_remote_baseline() {
    branch_publish_remote_error=''
    if ! inspect_initial_branch_remote; then
        return 1
    fi
    if ((branch_publish_target_present == 1)); then
        branch_publish_remote_error="远端目标 branch 已存在: $branch_publish_branch_ref"
        return 1
    fi
    branch_publish_remote_refs_before=$branch_publish_other_refs
    if ! branch_publish_local_tags_before=$(
        git -C "$repo" for-each-ref --format='%(objectname)%09%(refname)' refs/tags
    ); then
        branch_publish_remote_error='无法记录本地 tag 基线'
        return 1
    fi
    printf 'remote target absent check: passed\n'
    printf 'remote non-target refs baseline: recorded\n'
    printf 'local tags baseline: recorded\n'
}

inspect_existing_history_first_remote() {
    local allow_expected_target=$1

    history_remote_state='unknown'
    if ! inspect_initial_branch_remote; then
        return 1
    fi
    if [[ -n "$branch_publish_other_refs" ]]; then
        branch_publish_remote_error='远端包含非目标用户 Git refs；existing-history first publication 已阻断'
        return 1
    fi
    if ((branch_publish_target_present == 0)); then
        history_remote_state='empty'
        return 0
    fi
    if [[ "$allow_expected_target" == true &&
        "$branch_publish_target_oid" == "$resume_expected_oid" ]]; then
        history_remote_state='expected_target_only'
        return 0
    fi
    branch_publish_remote_error='远端不是完全空 repository；请转用普通 existing-history publication 规则'
    return 1
}

capture_existing_history_remote_baseline() {
    local allow_expected_target=$1

    if ! inspect_existing_history_first_remote "$allow_expected_target"; then
        return 1
    fi
    branch_publish_remote_refs_before=''
    if ! branch_publish_local_tags_before=$(
        git -C "$repo" for-each-ref --format='%(objectname)%09%(refname)' refs/tags
    ); then
        branch_publish_remote_error='无法记录本地 tag 基线'
        return 1
    fi
    printf 'remote user refs state: %s\n' "$history_remote_state"
    printf 'local tags baseline: recorded\n'
}

recheck_existing_history_remote_baseline() {
    local allow_expected_target=$1
    local local_tags_now

    if ! inspect_existing_history_first_remote "$allow_expected_target"; then
        return 1
    fi
    if ! local_tags_now=$(
        git -C "$repo" for-each-ref --format='%(objectname)%09%(refname)' refs/tags
    ); then
        branch_publish_remote_error='无法复查本地 tags'
        return 1
    fi
    if [[ "$local_tags_now" != "$branch_publish_local_tags_before" ]]; then
        branch_publish_remote_error='existing-history publication 期间本地 tags 发生变化'
        return 1
    fi
    printf 'remote user refs recheck: %s\n' "$history_remote_state"
    printf 'local tags unchanged: passed\n'
}

check_initial_branch_remote_unchanged_absent() {
    local local_tags_now

    branch_publish_remote_error=''
    if ! inspect_initial_branch_remote; then
        return 1
    fi
    if ((branch_publish_target_present == 1)); then
        branch_publish_remote_error="远端目标 branch 已在 push 前出现: $branch_publish_branch_ref"
        return 1
    fi
    if [[ "$branch_publish_other_refs" != "$branch_publish_remote_refs_before" ]]; then
        branch_publish_remote_error='push 前远端非目标 refs 已变化'
        return 1
    fi
    if ! local_tags_now=$(
        git -C "$repo" for-each-ref --format='%(objectname)%09%(refname)' refs/tags
    ); then
        branch_publish_remote_error='无法复查本地 tags'
        return 1
    fi
    if [[ "$local_tags_now" != "$branch_publish_local_tags_before" ]]; then
        branch_publish_remote_error='commit 后本地 tags 发生变化'
        return 1
    fi
    printf 'remote target still absent: passed\n'
    printf 'remote non-target refs unchanged: passed\n'
    printf 'local tags unchanged: passed\n'
}

verify_initial_branch_commit() {
    local parent_line
    local branch_head

    branch_publish_verify_error=''
    if ! parent_line=$(git -C "$repo" rev-list --parents -n 1 "$commit_hash" 2>/dev/null) ||
        [[ "$parent_line" != "$commit_hash $branch_publish_base_head" ]]; then
        branch_publish_verify_error='新 commit 不是已有 HEAD 的单一直接子提交'
        return 1
    fi
    if ! branch_head=$(
        git -C "$repo" rev-parse --verify "$branch_publish_branch_ref^{commit}" 2>/dev/null
    ) || [[ "$branch_head" != "$commit_hash" ]]; then
        branch_publish_verify_error='新 commit 后本地 branch ref 与 HEAD 不一致'
        return 1
    fi
}

verify_initial_branch_result() {
    local final_head
    local final_upstream
    local final_counts
    local symbolic_head
    local local_tags_now
    local path
    local path_status

    branch_publish_verify_error=''
    if ! final_head=$(git -C "$repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null) ||
        [[ "$final_head" != "$commit_hash" ]]; then
        branch_publish_verify_error='push 后 HEAD 与 expected commit 不一致'
        return 1
    fi
    if ! symbolic_head=$(git -C "$repo" symbolic-ref --quiet HEAD 2>/dev/null) ||
        [[ "$symbolic_head" != "$branch_publish_branch_ref" ]]; then
        branch_publish_verify_error='push 后 symbolic branch 发生变化'
        return 1
    fi
    if ! inspect_initial_branch_remote; then
        branch_publish_verify_error=$branch_publish_remote_error
        return 1
    fi
    if ((branch_publish_target_present != 1)) ||
        [[ "$branch_publish_target_oid" != "$final_head" ]]; then
        branch_publish_verify_error='push 后远端目标 branch 与 HEAD 不一致'
        return 1
    fi
    if [[ "$branch_publish_other_refs" != "$branch_publish_remote_refs_before" ]]; then
        branch_publish_verify_error='push 后远端非目标 refs 发生变化'
        return 1
    fi
    if ! local_tags_now=$(
        git -C "$repo" for-each-ref --format='%(objectname)%09%(refname)' refs/tags
    ) || [[ "$local_tags_now" != "$branch_publish_local_tags_before" ]]; then
        branch_publish_verify_error='push 后本地 tags 发生变化'
        return 1
    fi
    classify_branch_upstream \
        "$branch_publish_branch" "$branch_publish_remote" "$branch_publish_branch_ref"
    if [[ "$branch_upstream_state" != 'exact_resolved' ||
        "$branch_upstream_oid" != "$final_head" ]]; then
        branch_publish_verify_error=${branch_upstream_error:-'push 后 upstream 未精确对齐目标 branch'}
        return 1
    fi
    if ! final_upstream=$(
        git -C "$repo" rev-parse --verify '@{upstream}^{commit}' 2>/dev/null
    ) || [[ "$final_upstream" != "$final_head" ]]; then
        branch_publish_verify_error='push 后 upstream commit 与 HEAD 不一致'
        return 1
    fi
    if ! final_counts=$(
        git -C "$repo" rev-list --left-right --count "$final_head...$final_upstream" 2>/dev/null
    ) || [[ "$final_counts" != $'0\t0' ]]; then
        branch_publish_verify_error='push 后 HEAD 与 upstream ahead/behind 不是 0/0'
        return 1
    fi
    if ! git -C "$repo" diff --cached --quiet; then
        branch_publish_verify_error='push 后 index 不干净'
        return 1
    fi
    for path in "${paths[@]}"; do
        path_status=$(
            git -C "$repo" --literal-pathspecs status --porcelain=v1 \
                --untracked-files=all -- "$path"
        )
        if [[ -n "$path_status" ]]; then
            branch_publish_verify_error="push 后显式路径不干净: $(printf '%q' "$path")"
            return 1
        fi
    done

    printf 'HEAD: %s\n' "$final_head"
    printf 'upstream: %s/%s\n' "$branch_publish_remote" "$branch_publish_branch"
    printf 'remote branch OID: %s\n' "$branch_publish_target_oid"
    printf 'ahead/behind: %s\n' "$final_counts"
    printf 'explicit paths: clean\n'
    printf 'remote non-target refs and tags: unchanged\n'
}

prepare_existing_branch_publish_range() {
    local line
    local oid
    local ref_name
    local extra
    local commit_output
    local -a remote_head_oids=()
    local -a rev_args=("$resume_expected_oid")
    declare -A seen_remote_oids=()

    existing_range_error=''
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        IFS=$'\t' read -r oid ref_name extra <<<"$line"
        if [[ ! "$oid" =~ ^[0-9a-f]+$ || "$ref_name" != refs/* || -n "$extra" ]]; then
            existing_range_error='无法解析 captured remote ref baseline'
            return 1
        fi
        [[ "$ref_name" == refs/heads/* ]] || continue
        if ! git -C "$repo" cat-file -e "$oid^{commit}" 2>/dev/null; then
            existing_range_error="fetch 后无法解析远端 branch commit: $ref_name"
            return 1
        fi
        if [[ -z ${seen_remote_oids[$oid]+present} ]]; then
            seen_remote_oids["$oid"]=1
            remote_head_oids+=("$oid")
        fi
    done <<<"$branch_publish_remote_refs_before"

    if ((${#remote_head_oids[@]} > 0)); then
        rev_args+=(--not "${remote_head_oids[@]}")
    fi
    if ! commit_output=$(
        git -C "$repo" rev-list --reverse --topo-order "${rev_args[@]}" 2>/dev/null
    ); then
        existing_range_error='无法计算相对 captured remote heads 的待发布 commit 集合'
        return 1
    fi
    existing_publish_commit_output_override=$commit_output
    resume_publish_commit_count=0
    while IFS= read -r oid; do
        [[ -n "$oid" ]] || continue
        resume_publish_commit_count=$((resume_publish_commit_count + 1))
    done <<<"$commit_output"
    resume_publish_range="$resume_expected_oid --not captured:$branch_publish_remote/heads"
}

verify_existing_branch_publish_local_state() {
    local current_head
    local current_branch_head
    local current_index
    local current_status
    local current_count

    publish_existing_verify_error=''
    if ! current_head=$(git -C "$repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null) ||
        [[ "$current_head" != "$publish_existing_head_before" ]]; then
        publish_existing_verify_error='HEAD 在 existing-branch publish 期间发生变化'
        return 1
    fi
    if ! current_branch_head=$(
        git -C "$repo" rev-parse --verify "$branch_publish_branch_ref^{commit}" 2>/dev/null
    ) || [[ "$current_branch_head" != "$publish_existing_head_before" ]]; then
        publish_existing_verify_error='本地 branch ref 在 existing-branch publish 期间发生变化'
        return 1
    fi
    current_index=$(git -C "$repo" ls-files --stage) || {
        publish_existing_verify_error='无法复查 index 状态'
        return 1
    }
    if [[ "$current_index" != "$publish_existing_index_before" ]]; then
        publish_existing_verify_error='index 在 existing-branch publish 期间发生变化'
        return 1
    fi
    current_status=$(
        GIT_OPTIONAL_LOCKS=0 git -C "$repo" status --porcelain=v1 --untracked-files=all
    ) || {
        publish_existing_verify_error='无法复查 worktree 状态'
        return 1
    }
    if [[ "$current_status" != "$publish_existing_status_before" ]]; then
        publish_existing_verify_error='worktree 在 existing-branch publish 期间发生变化'
        return 1
    fi
    if ! current_count=$(git -C "$repo" rev-list --count HEAD 2>/dev/null) ||
        [[ "$current_count" != "$publish_existing_commit_count_before" ]]; then
        publish_existing_verify_error='commit history 在 existing-branch publish 期间发生变化'
        return 1
    fi
}

validate_resume_expected_head() {
    local object_format
    local oid_length
    local resolved_head

    resume_target_error=''
    if ! object_format=$(
        git -C "$repo" rev-parse --show-object-format=storage 2>/dev/null
    ); then
        resume_target_error='无法确定当前 Git object format'
        return 1
    fi
    case "$object_format" in
        sha1) oid_length=40 ;;
        sha256) oid_length=64 ;;
        *)
            resume_target_error='不支持当前 Git object format'
            return 1
            ;;
    esac
    if ((${#resume_expected_oid} != oid_length)) ||
        [[ ! "$resume_expected_oid" =~ ^[0-9a-f]+$ ]]; then
        resume_target_error="expected HEAD 必须是 $object_format 的完整小写十六进制 OID"
        return 1
    fi
    if ! resolved_head=$(git -C "$repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null); then
        resume_target_error='resume HEAD 无法解析为 commit'
        return 1
    fi
    if [[ "$resolved_head" != "$resume_expected_oid" ]]; then
        resume_target_error='当前 HEAD 与 expected HEAD 不一致'
        return 1
    fi
    resume_head=$resolved_head
}

check_git_operation_state() {
    local git_dir
    local marker
    local merge_head

    git_operation_error=''
    if [[ -n "$merge_parent_arg" ]]; then
        local object_format oid_length
        object_format=$(git -C "$repo" rev-parse --show-object-format=storage) || return 1
        case "$object_format" in
            sha1) oid_length=40 ;;
            sha256) oid_length=64 ;;
            *) git_operation_error='unsupported Git object format'; return 1 ;;
        esac
        ((${#merge_parent_arg} == oid_length)) || {
            git_operation_error="--merge-parent requires a full $object_format OID"; return 1;
        }
    fi
    if ! git_dir=$(git -C "$repo" rev-parse --absolute-git-dir 2>/dev/null); then
        git_operation_error='无法解析 Git metadata 目录'
        return 1
    fi
    for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD REBASE_HEAD \
        rebase-apply rebase-merge sequencer BISECT_START; do
        if [[ -e "$git_dir/$marker" || -L "$git_dir/$marker" ]]; then
            if [[ "$marker" == MERGE_HEAD && -n "$merge_parent_arg" ]]; then
                [[ -f "$git_dir/$marker" && ! -L "$git_dir/$marker" ]] || {
                    git_operation_error='--merge-parent requires a regular MERGE_HEAD'; return 1;
                }
                cmp -s "$git_dir/$marker" <(printf '%s\n' "$merge_parent_arg") || {
                    git_operation_error='--merge-parent requires one exact MERGE_HEAD line'; return 1;
                }
                merge_head=$(git -C "$repo" rev-parse --verify 'HEAD^{commit}') || return 1
                [[ "$merge_head" != "$merge_parent_arg" ]] || {
                    git_operation_error='--merge-parent does not match one exact merge parent'; return 1;
                }
                [[ $(git -C "$repo" rev-parse --verify "$merge_parent_arg^{commit}" 2>/dev/null) == "$merge_parent_arg" ]] || {
                    git_operation_error='--merge-parent is not an existing commit'; return 1;
                }
                [[ -z $(git -C "$repo" ls-files --unmerged) ]] || {
                    git_operation_error='merge conflicts remain unresolved'; return 1;
                }
                if [[ -n "$merge_original_head" && "$merge_head" != "$merge_original_head" ]]; then
                    git_operation_error='HEAD changed during merge validation'; return 1
                fi
                merge_original_head=$merge_head
                continue
            fi
            git_operation_error='拒绝未完成的 Git 操作'
            return 1
        fi
    done
    if [[ -n "$merge_parent_arg" && ! -f "$git_dir/MERGE_HEAD" ]]; then
        git_operation_error='--merge-parent requires a pending two-parent merge'
        return 1
    fi
}

check_resume_clean_state() {
    local resume_status

    resume_target_error=''
    if ! git -C "$repo" diff --cached --quiet; then
        resume_target_error='resume 要求 index/staged 状态干净'
        return 1
    fi
    resume_status=$(
        GIT_OPTIONAL_LOCKS=0 git -C "$repo" status --porcelain=v1 --untracked-files=all
    )
    if [[ -n "$resume_status" ]]; then
        resume_target_error='resume 要求 worktree 完全干净（包括 untracked 文件）'
        return 1
    fi
    check_git_operation_state || { resume_target_error="resume $git_operation_error"; return 1; }
}

is_committed_large_binary() {
    local oid=$1
    local size

    size=$(git -C "$repo" cat-file -s "$oid" 2>/dev/null) || return 1
    ((size > MAX_BINARY_BYTES)) || return 1
    if LC_ALL=C grep -Iq -- . < <(git -C "$repo" cat-file blob "$oid" 2>/dev/null); then
        return 1
    fi
    return 0
}

load_history_large_binary_overrides() {
    local path lexical entry mode type oid extra size
    history_large_binary_overrides=()
    history_large_binary_applied=()
    for path in "${allow_large_binary_args[@]}"; do
        [[ -n "$path" && "$path" != /* && "$path" != *$'\n'* &&
           "$path" != *$'\r'* && "$path" != *$'\t'* ]] ||
            fail '--allow-large-binary requires a canonical repo-relative path'
        lexical=$(realpath -m -s -- "$repo/$path") || fail 'invalid large binary path'
        [[ "$lexical" == "$repo/$path" && "$lexical" == "$repo/"* &&
           "$path" != .git && "$path" != .git/* ]] || fail 'invalid large binary path'
        [[ -z ${history_large_binary_overrides[$path]+present} ]] ||
            fail 'duplicate large binary history exception'
        entry=$(git -C "$repo" --literal-pathspecs ls-tree HEAD -- "$path") ||
            fail 'cannot read large binary HEAD entry'
        [[ -n "$entry" && "$entry" != *$'\n'* && "$entry" == *$'\t'* ]] ||
            fail 'large binary history exception requires one HEAD file'
        read -r mode type oid extra <<<"${entry%%$'\t'*}"
        [[ ("$mode" == 100644 || "$mode" == 100755) && "$type" == blob && -z "$extra" ]] ||
            fail 'large binary history exception requires a regular HEAD blob'
        is_committed_large_binary "$oid" ||
            fail 'large binary history exception requires a binary blob above 5 MiB'
        size=$(git -C "$repo" cat-file -s "$oid") || fail 'cannot read large binary blob size'
        ((size <= MAX_ALLOWED_LARGE_BINARY_BYTES)) || fail 'large binary HEAD blob exceeds 25 MiB'
        history_large_binary_overrides["$path"]=$oid
    done
}

public_schema_content_verdict() {
    python3_available || { printf 'ERROR\n'; return 0; }
    local executable helper verdict
    executable=$(realpath -e -- "${BASH_SOURCE[0]}") || { printf 'ERROR\n'; return 0; }
    helper=${executable%/*}/git-finalize-content-scan.py
    [[ -f "$helper" && ! -L "$helper" ]] || { printf 'ERROR\n'; return 0; }
    verdict=$("$PYTHON3_EXECUTABLE" -B "$helper" "$1" "$2" "$repo" "$3" "$4") || verdict=ERROR
    printf '%s\n' "$verdict"
}

load_fixture_exceptions() {
    local phase=${1:-history}
    local records path oid detector record key review_remote

    [[ -n "$fixture_exceptions_file" ]] || return 0
    review_remote=${branch_publish_remote:-${upstream_remote:-}}
    if ((commit_only == 1 || verify_only == 1)); then
        review_remote=origin
    fi
    if ! records=$("$PYTHON3_EXECUTABLE" -B - \
        "$fixture_exceptions_file" "$repo" "${resume_expected_oid:-HEAD}" \
        "$review_remote" "$phase" "${normal_upstream_hash:-}" "$assignment_re" "$mode_arg" <<'PY'
import ast
from collections import Counter
import hashlib
import json
from pathlib import Path, PurePosixPath
import re
import subprocess
import sys


def require(condition, message):
    if not condition:
        raise ValueError(message)


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        require(key not in result, "duplicate JSON key")
        result[key] = value
    return result


