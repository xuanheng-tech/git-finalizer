validate_existing_publish_range() {
    local commit_output
    local commit_oid
    local whitespace_output
    local whitespace_status
    local path
    local reason
    local ignore_status
    local entry
    local entry_path
    local metadata
    local object_mode
    local object_type
    local object_oid
    local extra
    local fixture_key
    local excepted_detectors
    local detector
    local -a commit_oids=()
    local -a tree_entries=()
    declare -A publish_paths=()
    declare -A reviewed_fixture_paths_seen=()

    existing_range_error=''
    history_large_binary_overrides=()
    history_large_binary_applied=()
    if ((resume_initial == 1 || resume_existing == 1 || resume_existing_history == 1 ||
         publish_existing_branch == 1 || publish_existing_history == 1)); then
        load_history_large_binary_overrides
    fi
    if [[ -n ${existing_publish_commit_output_override-} ]]; then
        commit_output=$existing_publish_commit_output_override
    elif ! commit_output=$(
        git -C "$repo" rev-list --reverse --topo-order "$resume_publish_range" 2>/dev/null
    ); then
        existing_range_error='无法解析待发布 commit range'
        return 1
    fi
    [[ -n "$commit_output" ]] || {
        existing_range_error='待发布 commit range 为空'
        return 1
    }
    mapfile -t commit_oids <<<"$commit_output"
    if ((${#commit_oids[@]} != resume_publish_commit_count)); then
        existing_range_error='待发布 commit range 与 ahead 计数不一致'
        return 1
    fi

    for commit_oid in "${commit_oids[@]}"; do
        # Every unpublished parent is checked separately. Compare merge changes
        # to the first parent so an older side branch does not reintroduce the
        # already-published baseline into this range's validation scope.
        if whitespace_output=$(
            git -C "$repo" diff-tree --root --diff-merges=first-parent --no-commit-id --no-renames \
                -r --check "$commit_oid" 2>&1
        ); then
            whitespace_status=0
        else
            whitespace_status=$?
        fi
        if ((whitespace_status != 0)) || [[ -n "$whitespace_output" ]]; then
            existing_range_error="待发布 commit 存在 whitespace 错误: $commit_oid"
            return 1
        fi

        while IFS= read -r -d '' path; do
            if [[ -z "$path" || "$path" == /* || "$path" == '../'* ||
                "$path" == *'/../'* || "$path" == *$'\n'* || "$path" == *$'\r'* ||
                "$path" == *$'\t'* || "$path" == '.git' || "$path" == .git/* ]]; then
                existing_range_error="待发布 commit 包含异常文件路径: $(printf '%q' "$path")"
                return 1
            fi
            tree_entries=()
            mapfile -d '' -t tree_entries < <(
                git -C "$repo" --literal-pathspecs ls-tree -z "$commit_oid" -- "$path"
            )
            if ((${#tree_entries[@]} == 0)); then
                # A deletion adds no blob. Earlier unpublished additions are
                # still examined separately, even when HEAD now ignores them.
                publish_paths["$path"]=1
                continue
            fi
            if reason=$(sensitive_path_reason "$path") &&
                [[ -z ${reviewed_source_paths[$path]+present} ]]; then
                existing_range_error="拒绝待发布敏感文件 $(printf '%q' "$path"): $reason"
                return 1
            fi

            ignore_status=0
            git -C "$repo" check-ignore --quiet --no-index -- "$path" || ignore_status=$?
            if ((ignore_status == 0)); then
                existing_range_error="待发布 commit 包含 ignored 文件: $(printf '%q' "$path")"
                return 1
            fi
            if ((ignore_status != 1)); then
                existing_range_error="无法验证待发布文件的 ignore 状态: $(printf '%q' "$path")"
                return 1
            fi

            if ((${#tree_entries[@]} != 1)); then
                existing_range_error="待发布 commit 文件解析结果含糊: $(printf '%q' "$path")"
                return 1
            fi
            entry=${tree_entries[0]}
            [[ "$entry" == *$'\t'* ]] || {
                existing_range_error="无法解析待发布 commit 文件: $(printf '%q' "$path")"
                return 1
            }
            metadata=${entry%%$'\t'*}
            entry_path=${entry#*$'\t'}
            read -r object_mode object_type object_oid extra <<<"$metadata"
            if [[ "$entry_path" != "$path" || -n "$extra" || "$object_type" != 'blob' ||
                ( "$object_mode" != '100644' && "$object_mode" != '100755' ) ||
                ! "$object_oid" =~ ^[0-9a-f]+$ ]]; then
                existing_range_error="待发布 commit 包含非普通文件或异常对象: $(printf '%q' "$path")"
                return 1
            fi
            if is_committed_large_binary "$object_oid"; then
                if [[ "$object_oid" != "${history_large_binary_overrides[$path]-}" ]]; then
                    existing_range_error="拒绝待发布的大于 5 MiB 明显二进制文件: $(printf '%q' "$path")"
                    return 1
                fi
                history_large_binary_applied["$path"]=1
            fi
            if [[ -n ${reviewed_source_paths[$path]+present} &&
                "$object_oid" != "${reviewed_source_paths[$path]}" ]]; then
                existing_range_error="reviewed source history blob mismatch: $(printf '%q' "$path")"
                return 1
            fi
            excepted_detectors=${history_fixture_rules[$path:$object_oid]-}
            # Earlier ordinary revisions still receive an unmasked scan.
            # Once a reviewed fixture appears, retain exact later-blob guards.
            if [[ -n ${history_fixture_paths[$path]+present} &&
                -n ${reviewed_fixture_paths_seen[$path]+present} &&
                -z "$excepted_detectors" ]]; then
                existing_range_error="fixture exception path/blob identity mismatch: $(printf '%q' "$path")"
                return 1
            fi
            if reason=$(staged_content_reason "$object_oid" "$excepted_detectors"); then
                existing_range_error="拒绝待发布敏感文件 $(printf '%q' "$path"): $reason"
                return 1
            fi
            if [[ -n "$excepted_detectors" ]]; then
                reviewed_fixture_paths_seen["$path"]=1
            fi
            for detector in private-key-header-v1 known-token-v1 credential-assignment-v1; do
                fixture_key=$path:$object_oid:$detector
                if [[ -n ${history_fixture_exceptions[$fixture_key]+present} &&
                    -z ${history_fixture_applied[$fixture_key]+present} ]]; then
                    history_fixture_applied["$fixture_key"]=1
                    summary_fixture_exceptions+=("${history_fixture_exceptions[$fixture_key]}")
                    printf 'fixture exception applied: %s\n' "${history_fixture_exceptions[$fixture_key]}"
                fi
            done
            publish_paths["$path"]=1
        done < <(
            git -C "$repo" diff-tree --root --diff-merges=first-parent --no-commit-id --no-renames \
                -r --name-only -z "$commit_oid"
        )
    done

    for fixture_key in "${!history_fixture_exceptions[@]}"; do
        if [[ -z ${history_fixture_applied[$fixture_key]+present} ]]; then
            existing_range_error='fixture exception 未匹配待发布历史中的 exact path/blob/detector'
            return 1
        fi
    done
    for path in "${!history_large_binary_overrides[@]}"; do
        [[ -n ${history_large_binary_applied[$path]+present} ]] || {
            existing_range_error='large binary exception did not match the exact unpublished path/blob'
            return 1
        }
    done
    resume_publish_path_count=${#publish_paths[@]}
}

inspect_resume_upstream() {
    resume_upstream_error=''
    resume_upstream_present=0
    classify_branch_upstream "$resume_branch" "$resume_remote" "$resume_branch_ref"
    resume_upstream_state=$branch_upstream_state
    case "$resume_upstream_state" in
        none|exact_unresolved)
            return 0
            ;;
        exact_resolved)
            if [[ "$branch_upstream_oid" != "$resume_expected_oid" ]]; then
                resume_upstream_error='resume upstream commit 与 expected HEAD 不一致'
                return 1
            fi
            resume_upstream_present=1
            ;;
        conflicting)
            resume_upstream_error=$branch_upstream_error
            return 1
            ;;
    esac
}

resolve_resume_target() {
    local symbolic_head
    local parent_line
    local tree_paths
    local configured_remotes
    local fetch_urls
    local push_urls

    resume_target_error=''
    if ! symbolic_head=$(git -C "$repo" symbolic-ref --quiet HEAD 2>/dev/null); then
        resume_target_error='resume 要求 symbolic attached branch'
        return 1
    fi
    if [[ "$symbolic_head" != refs/heads/* || "$symbolic_head" == 'refs/heads/' ]]; then
        resume_target_error='resume symbolic HEAD 不是本地 branch'
        return 1
    fi
    resume_branch_ref=$symbolic_head
    resume_branch=${resume_branch_ref#refs/heads/}
    if [[ "$current_branch" != "$resume_branch" ]]; then
        resume_target_error='resume symbolic HEAD 与当前 branch 名不一致'
        return 1
    fi

    validate_resume_expected_head || return 1
    if ! parent_line=$(git -C "$repo" rev-list --parents -n 1 "$resume_head" 2>/dev/null) ||
        [[ "$parent_line" != "$resume_head" ]]; then
        resume_target_error='resume 只接受无 parent 的 root commit'
        return 1
    fi
    if ! tree_paths=$(git -C "$repo" ls-tree -r --name-only "$resume_head" 2>/dev/null) ||
        [[ -z "$tree_paths" ]]; then
        resume_target_error='resume root commit tree 不能为空'
        return 1
    fi
    check_resume_clean_state || return 1

    if ! configured_remotes=$(git -C "$repo" remote 2>/dev/null); then
        resume_target_error='无法读取已配置 remote'
        return 1
    fi
    if ! grep -Fxq -- "$remote_arg" <<<"$configured_remotes"; then
        resume_target_error="未配置指定 remote: $remote_arg"
        return 1
    fi
    resume_remote=$remote_arg
    if ! fetch_urls=$(git -C "$repo" remote get-url --all "$resume_remote" 2>/dev/null) ||
        [[ -z "$fetch_urls" || "$fetch_urls" == *$'\n'* ]]; then
        resume_target_error='resume remote 缺失或配置了多个 fetch endpoint'
        return 1
    fi
    if ! push_urls=$(git -C "$repo" remote get-url --push --all "$resume_remote" 2>/dev/null) ||
        [[ -z "$push_urls" || "$push_urls" == *$'\n'* ]]; then
        resume_target_error='resume remote 缺失或配置了多个 push endpoint'
        return 1
    fi
    if [[ "$fetch_urls" != "$push_urls" ]]; then
        resume_target_error='resume remote 的 fetch 与 push endpoint 不一致'
        return 1
    fi
    if ! inspect_resume_upstream; then
        resume_target_error=$resume_upstream_error
        return 1
    fi
}

classify_resume_remote() {
    local output
    local status
    local remote_oid
    local remote_ref
    local extra

    resume_remote_error=''
    resume_remote_state=''
    if output=$(git -C "$repo" ls-remote --quiet --refs "$resume_remote" 2>/dev/null); then
        :
    else
        status=$?
        resume_remote_error="resume 远端 ref 查询失败（exit $status）"
        return 1
    fi
    if [[ -z "$output" ]]; then
        resume_remote_state='A'
        return 0
    fi
    if [[ "$output" == *$'\n'* ]]; then
        resume_remote_state='C'
        resume_remote_error='远端存在额外或含糊的 refs'
        return 0
    fi
    IFS=$'\t' read -r remote_oid remote_ref extra <<<"$output"
    if [[ ! "$remote_oid" =~ ^[0-9a-f]+$ || -n "$extra" ]]; then
        resume_remote_state='C'
        resume_remote_error='远端 ref 输出无法安全解析'
        return 0
    fi
    if [[ "$remote_ref" == "$resume_branch_ref" &&
        "$remote_oid" == "$resume_expected_oid" ]]; then
        resume_remote_state='B'
        resume_remote_oid=$remote_oid
        return 0
    fi
    resume_remote_state='C'
    if [[ "$remote_ref" == "$resume_branch_ref" ]]; then
        resume_remote_error='远端目标 branch 指向其他 OID'
    else
        resume_remote_error='远端存在非目标 ref'
    fi
}

run_resume_push() {
    run_branch_push true "$resume_remote" "HEAD:$resume_branch_ref"
}

verify_resume_result() {
    local final_head
    local parent_line
    local final_upstream
    local final_counts
    local final_status
    local symbolic_head

    resume_verify_error=''
    if ! final_head=$(git -C "$repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null) ||
        [[ "$final_head" != "$resume_expected_oid" ]]; then
        resume_verify_error='恢复后 HEAD 与 expected OID 不一致'
        return 1
    fi
    if ! parent_line=$(git -C "$repo" rev-list --parents -n 1 "$final_head" 2>/dev/null) ||
        [[ "$parent_line" != "$final_head" ]] ||
        [[ $(git -C "$repo" rev-list --count "$final_head") != 1 ]]; then
        resume_verify_error='恢复后 HEAD 不再是唯一 root commit'
        return 1
    fi
    if ! symbolic_head=$(git -C "$repo" symbolic-ref --quiet HEAD 2>/dev/null) ||
        [[ "$symbolic_head" != "$resume_branch_ref" ]]; then
        resume_verify_error='恢复后 symbolic branch 发生变化'
        return 1
    fi
    if ! classify_resume_remote; then
        resume_verify_error=$resume_remote_error
        return 1
    fi
    if [[ "$resume_remote_state" != 'B' ]]; then
        resume_verify_error="恢复后远端不是精确期望状态: $resume_remote_error"
        return 1
    fi
    if ! inspect_resume_upstream || ((resume_upstream_present == 0)); then
        resume_verify_error=${resume_upstream_error:-'恢复后 upstream 尚未建立'}
        return 1
    fi
    if ! final_upstream=$(
        git -C "$repo" rev-parse --verify '@{upstream}^{commit}' 2>/dev/null
    ) || [[ "$final_upstream" != "$final_head" ]]; then
        resume_verify_error='恢复后 upstream commit 与 HEAD 不一致'
        return 1
    fi
    if ! final_counts=$(
        git -C "$repo" rev-list --left-right --count "$final_head...$final_upstream" 2>/dev/null
    ) || [[ "$final_counts" != $'0\t0' ]]; then
        resume_verify_error='恢复后 HEAD 与 upstream ahead/behind 不是 0/0'
        return 1
    fi
    if ! git -C "$repo" diff --cached --quiet; then
        resume_verify_error='恢复后 index 不干净'
        return 1
    fi
    final_status=$(
        GIT_OPTIONAL_LOCKS=0 git -C "$repo" status --porcelain=v1 --untracked-files=all
    )
    if [[ -n "$final_status" ]]; then
        resume_verify_error='恢复后 worktree 不干净'
        return 1
    fi

    summary_final_head=$final_head
    summary_final_remote_oid=$resume_remote_oid
    summary_worktree_state='clean'

    printf 'HEAD: %s\n' "$final_head"
    printf 'upstream: %s\n' "$final_upstream"
    printf 'remote branch OID: %s\n' "$resume_remote_oid"
    printf 'ahead/behind: %s\n' "$final_counts"
    printf 'worktree: clean\n'
}

resume_initial_publish() {
    local need_push=0
    local second_push=0

    summary_phase='preflight'
    summary_mode_state='recovering'
    export GIT_OPTIONAL_LOCKS=0
    print_snapshot
    if ! resolve_resume_target; then
        fail "$resume_target_error"
    fi
    resume_publish_commit_count=1
    resume_publish_range=$resume_expected_oid
    existing_publish_commit_output_override=''
    validate_existing_publish_range || fail "$existing_range_error；未执行 push"
    summary_branch=$resume_branch
    summary_upstream=$resume_remote/$resume_branch
    summary_commit_sha=$resume_expected_oid
    summary_commit_reused=true
    summary_resume_publish_kind='initial_root'
    summary_publish_commit_count=1
    summary_publish_range=$resume_expected_oid
    summary_push_target="$resume_remote:$resume_branch_ref"
    summary_completed_through='preflight'

    printf '\n== Resume initial publish ==\n'
    printf 'mode: resume-initial-publish\n'
    printf 'publish kind: initial_root\n'
    printf 'expected HEAD: %s\n' "$resume_expected_oid"
    printf 'branch: %s\n' "$resume_branch"
    printf 'remote: %s\n' "$resume_remote"

    if ! classify_resume_remote; then
        fail "$resume_remote_error"
    fi
    case "$resume_remote_state" in
        A)
            summary_recovery_start='empty_remote'
            summary_remote_conclusion='empty_remote'
            need_push=1
            ;;
        B)
            if ((resume_upstream_present == 0)); then
                summary_recovery_start='published_without_upstream'
                need_push=1
            else
                summary_recovery_start='already_published'
            fi
            summary_remote_conclusion='expected_branch_present'
            ;;
        C)
            summary_recovery_start='conflicting_remote'
            summary_remote_conclusion='conflicting_or_ambiguous'
            fail "远端处于冲突或含糊状态；拒绝恢复: $resume_remote_error"
            ;;
    esac
    summary_completed_through='remote_classification'

    if ((need_push == 1)); then
        summary_phase='push'
        summary_default_failure_status='failed'
        summary_push_executed=true
        printf '\n== Resume push ==\n'
        if ! run_resume_push; then
            summary_push_result='uncertain'
            if ! classify_resume_remote; then
                fail "$resume_remote_error"
            fi
            case "$resume_remote_state" in
                A)
                    fail_resume_retryable 'resume push 失败且远端仍为空'
                    ;;
                C)
                    fail "resume push 后远端进入冲突或含糊状态: $resume_remote_error"
                    ;;
                B)
                    if ! inspect_resume_upstream; then
                        fail "$resume_upstream_error"
                    fi
                    if ((resume_upstream_present == 0)); then
                        second_push=1
                    fi
                    ;;
            esac
        else
            summary_push_result='succeeded'
        fi
    fi

    if ((second_push == 1)); then
        summary_push_executed=true
        printf '\n== Resume up-to-date push ==\n'
        if ! run_resume_push; then
            summary_push_result='uncertain'
            if ! classify_resume_remote; then
                fail "$resume_remote_error"
            fi
            case "$resume_remote_state" in
                A) fail_resume_retryable 'up-to-date push 失败且远端为空' ;;
                C) fail "up-to-date push 后远端冲突或含糊: $resume_remote_error" ;;
                B)
                    if ! inspect_resume_upstream || ((resume_upstream_present == 0)); then
                        fail_resume_retryable '远端已正确但本地 upstream 尚未建立'
                    fi
                    ;;
            esac
        else
            summary_push_result='succeeded'
        fi
    fi
    summary_completed_through='push'

    summary_phase='post_verify'
    summary_post_verify='failed'
    printf '\n== Resume 最终验证 ==\n'
    if ! verify_resume_result; then
        fail "$resume_verify_error"
    fi
    printf 'post-verify: passed\n'
    summary_post_verify='passed'
    summary_remote_conclusion='published_and_upstream_aligned'
    summary_completed_through='post_verify'
    summary_mode_state='verified'
    summary_status='success'
    summary_next_action='none'
    printf '\nGit Finalizer 完成：initial publish 恢复已验证。\n'
}

snapshot_local_git_config() {
    local config_path
    local worktree_config_path
    local path
    local state
    local object_hash
    local metadata

    config_path=$(git -C "$repo" rev-parse --path-format=absolute --git-path config) ||
        return 1
    worktree_config_path=$(
        git -C "$repo" rev-parse --path-format=absolute --git-path config.worktree
    ) || return 1
    for path in "$config_path" "$worktree_config_path"; do
        if [[ -e "$path" || -L "$path" ]]; then
            [[ -f "$path" && -r "$path" ]] || return 1
            object_hash=$(git -C "$repo" hash-object --no-filters "$path") || return 1
            metadata=$(stat -c '%f:%s' -- "$path") || return 1
            state="present:$metadata:$object_hash"
        else
            state='absent'
        fi
        printf '%s\n' "$state"
    done
}

resolve_existing_resume_upstream() {
    local head_ref
    local upstream_details
    local upstream_full_ref
    local resolved_upstream
    local tracking_oid
    local fetch_urls
    local push_urls

    existing_upstream_error=''
    if ! resolve_local_commit_target normal; then
        existing_upstream_error=$local_commit_target_error
        return 1
    fi
    head_ref=$local_commit_branch_ref
    if ! upstream_details=$(
        git -C "$repo" for-each-ref \
            --format='%(upstream:short)%09%(upstream:remotename)%09%(upstream:remoteref)%09%(upstream)' \
            "$head_ref"
    ); then
        existing_upstream_error='无法解析当前分支 configured upstream'
        return 1
    fi
    if [[ -z "$upstream_details" || "$upstream_details" == *$'\n'* ]]; then
        existing_upstream_error='当前分支不存在唯一可解析的 configured upstream'
        return 1
    fi
    IFS=$'\t' read -r upstream_name upstream_remote upstream_branch_ref \
        upstream_full_ref <<<"$upstream_details"
    if [[ -z "$upstream_name" || -z "$upstream_remote" || "$upstream_remote" == '.' ||
        "$upstream_branch_ref" != refs/heads/* ||
        "$upstream_full_ref" != refs/remotes/* ]]; then
        existing_upstream_error='configured upstream 不是可验证的远端 branch'
        return 1
    fi
    if ! resolved_upstream=$(
        git -C "$repo" rev-parse --verify '@{upstream}^{commit}' 2>/dev/null
    ) || [[ ! "$resolved_upstream" =~ ^[0-9a-f]+$ ]]; then
        existing_upstream_error='configured upstream 无法解析为 commit'
        return 1
    fi
    if ! tracking_oid=$(
        git -C "$repo" rev-parse --verify "$upstream_full_ref^{commit}" 2>/dev/null
    ) || [[ "$resolved_upstream" != "$tracking_oid" ]]; then
        existing_upstream_error='configured upstream 解析结果不一致'
        return 1
    fi
    if ! fetch_urls=$(git -C "$repo" remote get-url --all "$upstream_remote" 2>/dev/null) ||
        [[ -z "$fetch_urls" || "$fetch_urls" == *$'\n'* ]]; then
        existing_upstream_error='upstream remote 缺失或配置了多个 fetch endpoint'
        return 1
    fi
    if ! push_urls=$(
        git -C "$repo" remote get-url --push --all "$upstream_remote" 2>/dev/null
    ) || [[ -z "$push_urls" || "$push_urls" == *$'\n'* ]]; then
        existing_upstream_error='upstream remote 缺失或配置了多个 push endpoint'
        return 1
    fi
    if [[ "$fetch_urls" != "$push_urls" ]]; then
        existing_upstream_error='upstream 的 fetch 与 push endpoint 不一致'
        return 1
    fi
}

resolve_existing_resume_target() {
    local symbolic_head
    local parent_line

    resume_target_error=''
    if ! symbolic_head=$(git -C "$repo" symbolic-ref --quiet HEAD 2>/dev/null); then
        resume_target_error='resume-publish 要求 symbolic attached branch'
        return 1
    fi
    if [[ "$symbolic_head" != refs/heads/* || "$symbolic_head" == 'refs/heads/' ]]; then
        resume_target_error='resume-publish symbolic HEAD 不是本地 branch'
        return 1
    fi
    resume_branch_ref=$symbolic_head
    resume_branch=${resume_branch_ref#refs/heads/}
    if [[ "$current_branch" != "$resume_branch" ]]; then
        resume_target_error='resume-publish symbolic HEAD 与当前 branch 名不一致'
        return 1
    fi
    validate_resume_expected_head || return 1
    if ! parent_line=$(git -C "$repo" rev-list --parents -n 1 "$resume_head" 2>/dev/null); then
        resume_target_error='无法验证 resume-publish HEAD ancestry'
        return 1
    fi
    if [[ "$parent_line" == "$resume_head" ]]; then
        resume_target_error='普通 --resume-publish 要求非 root commit；root commit 请使用 --resume-initial-publish'
        return 1
    fi
    check_resume_clean_state || return 1
    if ! resolve_existing_resume_upstream; then
        resume_target_error=$existing_upstream_error
        return 1
    fi
    if [[ "$local_commit_branch_ref" != "$resume_branch_ref" ]]; then
        resume_target_error='resume-publish 当前 branch ref 解析不一致'
        return 1
    fi

    resume_remote=$upstream_remote
    resume_push_target="$upstream_remote:$upstream_branch_ref"
    if ! resume_branch_head_before=$(
        git -C "$repo" rev-parse --verify "$resume_branch_ref^{commit}" 2>/dev/null
    ) || [[ "$resume_branch_head_before" != "$resume_expected_oid" ]]; then
        resume_target_error='resume-publish branch ref 与 expected HEAD 不一致'
        return 1
    fi
    if ! resume_local_tags_before=$(
        git -C "$repo" for-each-ref --format='%(objectname)%09%(refname)' refs/tags
    ); then
        resume_target_error='无法记录 resume-publish 本地 tag 基线'
        return 1
    fi
    if ! resume_local_config_before=$(snapshot_local_git_config); then
        resume_target_error='无法记录 resume-publish 本地配置基线'
        return 1
    fi
}

verify_existing_resume_result() {
    local final_head
    local final_branch_head
    local symbolic_head
    local final_status
    local local_tags_now
    local local_config_now
    local publish_count_now

    resume_verify_error=''
    if ! final_head=$(git -C "$repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null) ||
        [[ "$final_head" != "$resume_expected_oid" ]]; then
        resume_verify_error='resume-publish 后 HEAD 与 expected OID 不一致'
        return 1
    fi
    if ! symbolic_head=$(git -C "$repo" symbolic-ref --quiet HEAD 2>/dev/null) ||
        [[ "$symbolic_head" != "$resume_branch_ref" ]]; then
        resume_verify_error='resume-publish 后 symbolic branch 发生变化'
        return 1
    fi
    if ! final_branch_head=$(
        git -C "$repo" rev-parse --verify "$resume_branch_ref^{commit}" 2>/dev/null
    ) || [[ "$final_branch_head" != "$resume_branch_head_before" ]]; then
        resume_verify_error='resume-publish 后本地 branch ref 发生变化'
        return 1
    fi
    if ! publish_count_now=$(
        git -C "$repo" rev-list --count "$resume_publish_range" 2>/dev/null
    ) || [[ "$publish_count_now" != "$resume_publish_commit_count" ]]; then
        resume_verify_error='resume-publish 后原 commit range 发生变化'
        return 1
    fi
    if ! resolve_existing_resume_upstream; then
        resume_verify_error=$existing_upstream_error
        return 1
    fi
    if [[ "$upstream_remote:$upstream_branch_ref" != "$resume_push_target" ]]; then
        resume_verify_error='resume-publish 后 configured upstream 目标发生变化'
        return 1
    fi
    if ! check_normal_remote_state 'resume-publish 后'; then
        resume_verify_error=$normal_remote_error
        return 1
    fi
    if [[ "$normal_local_hash" != "$resume_expected_oid" ||
        "$normal_upstream_hash" != "$resume_expected_oid" ||
        "$remote_branch_oid" != "$resume_expected_oid" ||
        "$normal_ahead" != 0 || "$normal_behind" != 0 ]]; then
        resume_verify_error='resume-publish 后 HEAD、upstream 与远端目标未精确对齐 0/0'
        return 1
    fi
    if ! local_tags_now=$(
        git -C "$repo" for-each-ref --format='%(objectname)%09%(refname)' refs/tags
    ) || [[ "$local_tags_now" != "$resume_local_tags_before" ]]; then
        resume_verify_error='resume-publish 后本地 tag refs 发生变化'
        return 1
    fi
    if ! local_config_now=$(snapshot_local_git_config) ||
        [[ "$local_config_now" != "$resume_local_config_before" ]]; then
        resume_verify_error='resume-publish 后本地 Git 配置发生变化'
        return 1
    fi
    if ! git -C "$repo" diff --cached --quiet; then
        resume_verify_error='resume-publish 后 index 不干净'
        return 1
    fi
    final_status=$(
        GIT_OPTIONAL_LOCKS=0 git -C "$repo" status --porcelain=v1 --untracked-files=all
    )
    if [[ -n "$final_status" ]]; then
        resume_verify_error='resume-publish 后 worktree 不干净'
        return 1
    fi

    summary_final_head=$final_head
    summary_final_remote_oid=$remote_branch_oid
    summary_worktree_state='clean'
    printf 'HEAD: %s\n' "$final_head"
    printf 'remote branch OID: %s\n' "$remote_branch_oid"
    printf 'ahead/behind: %s/%s\n' "$normal_ahead" "$normal_behind"
    printf 'worktree/index: clean\n'
    printf 'local branch, tags, and Git config: unchanged\n'
}

resume_existing_publish() {
    local push_state_error=''

    summary_phase='preflight'
    summary_mode_state='recovering'
    summary_resume_publish_kind='existing_commits'
    summary_recovery_start='local_ahead_commits'
    export GIT_OPTIONAL_LOCKS=0
    print_snapshot
    if ! resolve_existing_resume_target; then
        fail "$resume_target_error"
    fi
    paths=("${input_paths[@]}")
    load_source_reviews head
    summary_branch=$resume_branch
    summary_upstream=$upstream_name
    summary_commit_sha=$resume_expected_oid
    summary_commit_reused=true
    summary_push_target=$resume_push_target

    printf '\n== Resume existing commits ==\n'
    printf 'mode: resume-publish\n'
    printf 'publish kind: existing_commits\n'
    printf 'expected HEAD: %s\n' "$resume_expected_oid"
    printf 'branch: %s\n' "$resume_branch"
    printf 'configured upstream: %s\n' "$upstream_name"
    printf 'push target: %s\n' "$resume_push_target"

    summary_phase='remote_preflight'
    printf '\n== Resume publish 前 fetch 与 fast-forward 检查 ==\n'
    if ! check_normal_remote_state 'resume-publish 前'; then
        fail "$normal_remote_error；未执行 push"
    fi
    if [[ "$normal_local_hash" != "$resume_expected_oid" ]]; then
        fail 'resume-publish 预检后 HEAD 与 expected OID 不一致；未执行 push'
    fi
    if ((normal_ahead < 1)); then
        fail 'resume-publish 要求当前分支至少 ahead configured upstream 1 个 commit；未执行 push'
    fi
    resume_publish_commit_count=$normal_ahead
    resume_publish_range="$normal_upstream_hash..$normal_local_hash"
    summary_publish_ahead=$normal_ahead
    summary_publish_behind=$normal_behind
    summary_publish_commit_count=$resume_publish_commit_count
    summary_publish_range=$resume_publish_range

    printf '\n== Existing commit range 安全检查 ==\n'
    printf 'pre-publish ahead/behind: %s/%s\n' "$normal_ahead" "$normal_behind"
    printf 'commit count: %s\n' "$resume_publish_commit_count"
    printf 'commit range: %s\n' "$resume_publish_range"
    branch_publish_remote=$resume_remote
    load_fixture_exceptions
    if ! validate_existing_publish_range; then
        fail "$existing_range_error；未执行 push"
    fi
    printf 'validated changed paths: %s\n' "$resume_publish_path_count"
    printf 'range safety checks: passed\n'
    load_source_reviews head
    summary_completed_through='preflight'
    summary_remote_conclusion='fast_forward_publish_ready'

    summary_phase='push'
    summary_default_failure_status='failed'
    summary_push_executed=true
    printf '\n== Resume publish push ==\n'
    if ! run_branch_push false "$resume_remote" "HEAD:$upstream_branch_ref"; then
        summary_push_result='uncertain'
        if ! resolve_existing_resume_upstream; then
            push_state_error=$existing_upstream_error
        elif ! check_normal_remote_state 'resume-publish push 失败后'; then
            push_state_error=$normal_remote_error
        elif [[ "$normal_local_hash" == "$resume_expected_oid" &&
            "$normal_upstream_hash" == "$resume_expected_oid" &&
            "$remote_branch_oid" == "$resume_expected_oid" &&
            "$normal_ahead" == 0 && "$normal_behind" == 0 ]]; then
            summary_push_result='confirmed_after_uncertain'
        elif [[ "$normal_local_hash" == "$resume_expected_oid" &&
            "$normal_ahead" -ge 1 && "$normal_behind" == 0 ]]; then
            fail_resume_retryable 'resume-publish push 失败且远端目标仍未包含全部待发布 commits'
        else
            push_state_error='push 失败后的远端状态不满足安全重试或成功条件'
        fi
        if [[ -n "$push_state_error" ]]; then
            fail "resume-publish push 失败且无法确认安全结果: $push_state_error"
        fi
    else
        summary_push_result='succeeded'
    fi
    summary_completed_through='push'

    summary_phase='post_verify'
    summary_post_verify='failed'
    printf '\n== Resume publish 后验证 ==\n'
    if ! verify_existing_resume_result; then
        fail "$resume_verify_error"
    fi
    printf 'post-verify: passed\n'
    summary_post_verify='passed'
    summary_remote_conclusion='published_and_upstream_aligned'
    summary_completed_through='post_verify'
    summary_mode_state='verified'
    summary_status='success'
    summary_next_action='none'
    printf '\nGit Finalizer 完成：既有本地 commit range 已发布并完成远端验证。\n'
}

publish_existing_branch_head() {
    local branch_head
    local reviewed_path reason
    local push_state_error=''

    paths=("${input_paths[@]}")
    existing_publish_commit_output_override=''
    summary_phase='preflight'
    summary_mode_state='preflight'
    summary_commit_reused=true
    summary_commit_sha=$resume_expected_oid
    summary_commit_result='reused'
    export GIT_OPTIONAL_LOCKS=0
    print_snapshot

    if ! resolve_initial_branch_target; then
        fail "$branch_publish_target_error"
    fi
    if ! validate_resume_expected_head; then
        fail "$resume_target_error"
    fi
    if ! check_resume_clean_state; then
        fail "$resume_target_error"
    fi
    summary_worktree_before_state='clean'
    if ! branch_head=$(
        git -C "$repo" rev-parse --verify "$branch_publish_branch_ref^{commit}" 2>/dev/null
    ) || [[ "$branch_head" != "$resume_expected_oid" ]]; then
        fail 'existing-branch publish 的本地 branch ref 与 expected HEAD 不一致'
    fi
    load_source_reviews head
    for reviewed_path in "${!reviewed_source_paths[@]}"; do
        if reason=$(staged_content_reason "${reviewed_source_paths[$reviewed_path]}"); then
            fail "reviewed source 内容扫描阻断: $reason"
        fi
    done
    load_fixture_exceptions
    classify_branch_upstream \
        "$branch_publish_branch" "$branch_publish_remote" "$branch_publish_branch_ref"
    if [[ "$branch_upstream_state" != 'none' ]]; then
        fail 'existing-branch publish 只接受尚未配置 upstream 的本地 branch'
    fi

    publish_existing_head_before=$resume_expected_oid
    publish_existing_index_before=$(git -C "$repo" ls-files --stage) ||
        fail '无法记录 existing-branch publish 前 index'
    publish_existing_status_before=$(
        GIT_OPTIONAL_LOCKS=0 git -C "$repo" status --porcelain=v1 --untracked-files=all
    ) || fail '无法记录 existing-branch publish 前 worktree'
    publish_existing_commit_count_before=$(git -C "$repo" rev-list --count HEAD) ||
        fail '无法记录 existing-branch publish 前 commit count'
    summary_head_before=$publish_existing_head_before
    summary_branch=$branch_publish_branch
    summary_upstream=$branch_publish_remote/$branch_publish_branch
    summary_push_target="$branch_publish_remote:$branch_publish_branch_ref"

    printf '\n== Publish existing clean branch ==\n'
    printf 'mode: publish-existing-branch\n'
    printf 'expected HEAD: %s\n' "$resume_expected_oid"
    printf 'branch: %s\n' "$branch_publish_branch"
    printf 'explicit target: %s/%s\n' \
        "$branch_publish_remote" "$branch_publish_branch"
    printf 'configured upstream: none\n'

    summary_phase='remote_preflight'
    printf '\n== Existing branch remote preflight ==\n'
    if ! capture_initial_branch_remote_baseline; then
        fail "$branch_publish_remote_error；未执行 push"
    fi
    if ! run_git_remote_command 'git fetch <selected remote>' \
        git -C "$repo" fetch --no-tags --no-recurse-submodules "$branch_publish_remote"; then
        fail 'existing-branch publish 前 git fetch 失败；未执行 push'
    fi
    if ! check_initial_branch_remote_unchanged_absent; then
        fail "$branch_publish_remote_error；未执行 push"
    fi
    if ! verify_existing_branch_publish_local_state; then
        fail "$publish_existing_verify_error；未执行 push"
    fi
    classify_branch_upstream \
        "$branch_publish_branch" "$branch_publish_remote" "$branch_publish_branch_ref"
    if [[ "$branch_upstream_state" != 'none' ]]; then
        fail 'remote preflight 后 upstream 不再为空；未执行 push'
    fi
    if ! prepare_existing_branch_publish_range; then
        fail "$existing_range_error；未执行 push"
    fi
    summary_publish_commit_count=$resume_publish_commit_count
