        fail 'commit 前无法记录 HEAD'
fi
expected_commit_tree=$(git -C "$repo" write-tree) || fail '无法记录已验证 index tree'
if ! check_git_operation_state; then
    fail "$git_operation_error；未执行 commit 或 push"
fi
printf '\n== Commit ==\n'
commit_command_failed=0
if ! run_git_mutation 'git commit -m <message>' git -C "$repo" commit -m "$message"; then
    commit_command_failed=1
fi

commit_hash=$(git -C "$repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null) ||
    fail 'git commit 失败，HEAD 无法解析；未执行 fetch 或 push'
[[ "$commit_hash" != "$commit_head_before" ]] || fail 'git commit 未创建 commit；未执行 fetch 或 push'
summary_commit_created=true
summary_commit_sha=$commit_hash
summary_completed_through='commit'
if ((initial_publish == 1 || initial_commit_only == 1)); then
    summary_mode_state='commit_created'
fi
if ((commit_command_failed == 1)); then
    fail_created_commit 'git commit 返回失败但 HEAD 已改变；保留本地 commit，未执行 push'
fi
summary_phase='post_commit_verify'
committed_branch=$(git -C "$repo" symbolic-ref --quiet HEAD) ||
    fail_created_commit 'commit 后 HEAD 不再 attached'
[[ "$committed_branch" == "$commit_branch_before" ]] ||
    fail_created_commit 'commit 后 attached branch 发生变化'
committed_parents=$(git -C "$repo" rev-list --parents -n 1 "$commit_hash") ||
    fail_created_commit '无法读取 commit parents'
[[ "$committed_parents" == "$commit_hash${commit_head_before:+ $commit_head_before}${merge_parent_arg:+ $merge_parent_arg}" ]] ||
    fail_created_commit 'commit parents 与已验证 HEAD 不一致；未执行 push'
commit_message=$(git -C "$repo" log -1 --format=%B)
mapfile -d '' -t committed_paths < <(
    git -C "$repo" diff-tree --root --diff-merges=first-parent --no-commit-id --name-only -r --no-renames -z "$commit_hash"
)
for path in "${committed_paths[@]}"; do
    if [[ -z ${allowed_paths[$path]+present} ]]; then
        fail_created_commit "commit 包含超出显式范围的文件: $(printf '%q' "$path")"
    fi
done

committed_tree=$(git -C "$repo" rev-parse "$commit_hash^{tree}") ||
    fail_created_commit '无法读取 commit tree'
[[ "$committed_tree" == "$expected_commit_tree" ]] ||
    fail_created_commit 'commit tree 与已验证 index tree 不一致；检查 commit hooks，未执行 push'

load_source_reviews head
for path in "${!reviewed_source_paths[@]}"; do
    reviewed_oid=$(git -C "$repo" rev-parse "HEAD:$path") ||
        fail_after_commit '无法读取已审查源码 commit blob'
    if reason=$(staged_content_reason "$reviewed_oid"); then
        fail_after_commit "拒绝敏感 commit 内容: $reason"
    fi
done

if ((initial_publish == 1 || initial_commit_only == 1)) &&
    ! verify_initial_root_commit; then
    if ((initial_publish == 1)); then
        fail_initial_after_commit "$initial_commit_error"
    else
        fail_initial_commit_only_after_commit "$initial_commit_error"
    fi
fi
if ((initial_branch_publish == 1)) && ! verify_initial_branch_commit; then
    fail_initial_branch_after_commit "$branch_publish_verify_error"
fi
if ((initial_publish == 1 && snapshot_seen == 1)); then
    if ! verify_initial_snapshot head; then
        summary_snapshot_verification='failed'
        fail_initial_after_commit 'root commit 与 Snapshot Runner 证据不一致'
    fi
    summary_snapshot_verification='passed'
fi

printf 'commit hash: %s\n' "$commit_hash"
printf 'commit message: %q\n' "$commit_message"
printf 'changed files:\n'
git -C "$repo" diff-tree --root --diff-merges=first-parent --no-commit-id --name-status -r --no-renames "$commit_hash"

if ((commit_only == 1 || initial_commit_only == 1)); then
    if ((initial_commit_only == 1)); then
        skip_reason='initial_commit_only'
        skip_display='--initial-commit-only'
        result_label='Initial-commit-only'
        result_mode='initial-commit-only'
    else
        skip_reason='commit_only'
        skip_display='--mode commit-only'
        result_label='Commit-only'
        result_mode='commit-only'
    fi
    summary_push_result="skipped_by_$skip_reason"
    summary_post_verify="skipped_by_$skip_reason"
    summary_remote_conclusion="skipped_by_$skip_reason"
    summary_mode_state='committed'
    final_status=$(git -C "$repo" status --short)
    if [[ -z "$final_status" ]]; then
        summary_worktree_state='clean'
    else
        summary_worktree_state='dirty'
    fi
    if ((initial_commit_only == 1)); then
        [[ -z "$final_status" ]] ||
            fail_initial_commit_only_after_commit 'root commit 后 worktree 不干净'
        git -C "$repo" diff --cached --quiet ||
            fail_initial_commit_only_after_commit 'root commit 后 index 不干净'
    fi

    printf '\n== %s 结果 ==\n' "$result_label"
    printf 'mode: %s\n' "$result_mode"
    printf 'commit hash: %s\n' "$commit_hash"
    printf 'push: skipped (%s)\n' "$skip_display"
    printf 'remote verification: skipped (%s)\n' "$skip_display"
    printf '$ git status --short\n'
    print_value_or "$final_status" '(clean)'

    summary_completed_through='commit'
    summary_status='success'
    summary_next_action='none'
    printf '\nGit Finalizer 完成：本地 commit 已创建；push 与远端验证因 %s 模式跳过。\n' \
        "$result_mode"
    exit 0
elif ((initial_publish == 1)); then
    summary_phase='post_commit_verify'
    printf '\n== Root commit 后远端空状态复查 ==\n'
    if ! check_initial_remote_empty; then
        fail_initial_after_commit "$initial_remote_error"
    fi
    summary_remote_conclusion='empty_remote_reverified'

    summary_phase='push'
    summary_push_executed=true
    printf '\n== Initial push ==\n'
    if ! run_branch_push true "$initial_remote" "HEAD:$initial_branch_ref"; then
        summary_push_result='uncertain'
        fail_initial_after_commit 'initial push 失败或结果无法确认'
    fi
    summary_push_result='succeeded'
    summary_mode_state='pushed'

    summary_phase='post_verify'
    summary_post_verify='failed'
    printf '\n== Initial push 后验证 ==\n'
    final_head=$(git -C "$repo" rev-parse --verify 'HEAD^{commit}') ||
        fail_initial_after_commit 'push 后无法解析 HEAD'
    final_upstream=$(git -C "$repo" rev-parse --verify '@{upstream}^{commit}') ||
        fail_initial_after_commit 'push 后无法解析 upstream'
    if ! query_initial_published_remote; then
        fail_initial_after_commit "$initial_remote_error"
    fi
    if ! final_counts=$(
        git -C "$repo" rev-list --left-right --count "$final_head...$final_upstream" 2>/dev/null
    ); then
        fail_initial_after_commit 'push 后无法计算 HEAD 与 upstream 的 ahead/behind'
    fi
    final_status=$(git -C "$repo" status --porcelain=v1 --untracked-files=all)

    printf 'HEAD: %s\n' "$final_head"
    printf 'upstream: %s\n' "$final_upstream"
    printf 'remote branch OID: %s\n' "$initial_remote_oid"
    printf 'ahead/behind: %s\n' "$final_counts"
    printf 'worktree: %s\n' "${final_status:-clean}"

    [[ "$final_head" == "$final_upstream" ]] ||
        fail_initial_after_commit 'push 后本地 HEAD 与 upstream 不一致'
    [[ "$final_head" == "$initial_remote_oid" ]] ||
        fail_initial_after_commit 'push 后本地 HEAD 与远端 branch 不一致'
    [[ "$final_counts" == $'0\t0' ]] ||
        fail_initial_after_commit 'push 后本地 HEAD 与 upstream ahead/behind 不是 0/0'
    [[ -z "$final_status" ]] ||
        fail_initial_after_commit 'push 后 worktree 不干净'
    git -C "$repo" diff --cached --quiet ||
        fail_initial_after_commit 'push 后 index 不干净'
    summary_post_verify='passed'
    summary_remote_conclusion='published_and_upstream_aligned'
    summary_mode_state='verified'
elif ((initial_branch_publish == 1)); then
    summary_phase='post_commit_verify'
    printf '\n== Commit 后显式远端目标复查 ==\n'
    if ! check_initial_branch_remote_unchanged_absent; then
        fail_initial_branch_after_commit "$branch_publish_remote_error"
    fi
    summary_remote_conclusion='target_absent_reverified'

    summary_phase='push'
    summary_push_executed=true
    printf '\n== Initial branch push ==\n'
    if ! run_branch_push \
        true "$branch_publish_remote" "HEAD:$branch_publish_branch_ref"; then
        summary_push_result='uncertain'
        if inspect_initial_branch_remote; then
            if ((branch_publish_target_present == 0)) &&
                [[ "$branch_publish_other_refs" == "$branch_publish_remote_refs_before" ]]; then
                summary_remote_conclusion='target_absent_after_failed_push'
            elif ((branch_publish_target_present == 1)) &&
                [[ "$branch_publish_target_oid" == "$commit_hash" ]] &&
                [[ "$branch_publish_other_refs" == "$branch_publish_remote_refs_before" ]]; then
                summary_remote_conclusion='expected_target_present_after_failed_push'
            else
                summary_remote_conclusion='conflicting_or_ambiguous_after_failed_push'
            fi
        else
            summary_remote_conclusion='remote_state_unknown_after_failed_push'
        fi
        fail_initial_branch_after_commit 'initial branch push 失败或结果无法确认'
    fi
    summary_push_result='succeeded'
    summary_mode_state='pushed'

    summary_phase='post_verify'
    summary_post_verify='failed'
    printf '\n== Initial branch push 后验证 ==\n'
    if ! verify_initial_branch_result; then
        fail_initial_branch_after_commit "$branch_publish_verify_error"
    fi
    summary_post_verify='passed'
    summary_remote_conclusion='published_and_upstream_aligned'
    summary_mode_state='verified'
else
    summary_phase='post_commit_verify'
    printf '\n== Commit 后 fetch 与 fast-forward 检查 ==\n'
    if ! resolve_normal_target; then
        fail_after_commit "$normal_target_error"
    fi
    if ! check_normal_remote_state 'commit 后'; then
        fail_after_commit "$normal_remote_error"
    fi

    summary_phase='push'
    summary_push_executed=true
    printf '\n== Push ==\n'
    if ! run_branch_push false "$upstream_remote" "HEAD:$upstream_branch_ref"; then
        summary_push_result='uncertain'
        fail_after_commit 'git push 失败'
    fi
    summary_push_result='succeeded'

    summary_phase='post_verify'
    summary_post_verify='failed'
    printf '\n== Push 后验证 ==\n'
    printf '$ git rev-parse HEAD\n'
    final_head=$(git -C "$repo" rev-parse HEAD)
    printf '%s\n' "$final_head"
    printf '$ git rev-parse @{upstream}\n'
    final_upstream=$(git -C "$repo" rev-parse '@{upstream}^{commit}') ||
        fail_after_commit 'push 后无法解析 upstream'
    printf '%s\n' "$final_upstream"
    if ! query_remote_branch; then
        fail_after_commit "push 后 $remote_query_error"
    fi
    printf 'remote branch OID: %s\n' "$remote_branch_oid"
    if ! final_counts=$(
        git -C "$repo" rev-list --left-right --count "$final_head...$final_upstream" 2>/dev/null
    ); then
        fail_after_commit 'push 后无法计算 HEAD 与 upstream 的 ahead/behind'
    fi
    printf 'ahead/behind: %s\n' "$final_counts"
    printf '$ git status --short\n'
    final_status=$(git -C "$repo" status --short)
    print_value_or "$final_status" '(clean)'

    [[ "$final_head" == "$final_upstream" ]] ||
        fail_after_commit 'push 后本地 HEAD 与 upstream 不一致'
    [[ "$final_head" == "$remote_branch_oid" ]] ||
        fail_after_commit 'push 后本地 HEAD 与远端 branch 不一致'
    [[ "$final_counts" == $'0\t0' ]] ||
        fail_after_commit 'push 后本地 HEAD 与 upstream ahead/behind 不是 0/0'
    summary_post_verify='passed'
fi

summary_completed_through='post_verify'
summary_status='success'
summary_next_action='none'
printf '\nGit Finalizer 完成：commit 与 push 已验证。\n'
