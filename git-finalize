        summary_remote_conclusion='local_branch_already_absent_verified'
        summary_retirement_result='ALREADY_ABSENT_VERIFIED'
        summary_mode_state='verified'
        summary_completed_through='post_verify'
        summary_next_action='none'
        return 0
    fi
    if [[ "$local_oid" != "$retirement_expected_oid" ]]; then
        fail_retirement RETIREMENT_BLOCKED 'live local feature OID 与 expected_local_oid 不一致'
    fi

    if ((dry_run == 1)); then
        if ! check_retirement_local_lifecycle || ! query_retirement_refs; then
            fail_retirement RETIREMENT_BLOCKED \
                "${retirement_local_error:-$retirement_remote_error}"
        fi
        if [[ "$retirement_integration_oid" != "$retirement_integration_oid_before" ]] ||
            ((retirement_feature_present != retirement_feature_present_before)) ||
            { ((retirement_feature_present == 1)) &&
                [[ "$retirement_feature_oid" != "$retirement_feature_oid_before" ]]; }; then
            fail_retirement RETIREMENT_BLOCKED 'dry-run 复查发现 refs 已变化'
        fi
        if ! verify_retirement_local_unchanged; then
            fail_retirement RETIREMENT_BLOCKED "$retirement_verify_error"
        fi
        summary_retirement_local_absent_after=false
        summary_retirement_remote_absent_after=$(
            ((retirement_feature_present == 0)) && printf true || printf false
        )
        summary_retirement_result='RETIREMENT_PREFLIGHT_PASSED'
        summary_remote_conclusion='retirement_preflight_passed'
        summary_post_verify='skipped_by_dry_run'
        summary_mode_state='dry_run_complete'
        summary_completed_through='preflight'
        summary_next_action='run_without_dry_run_after_review'
        return 0
    fi

    if ! check_retirement_local_lifecycle ||
        ! local_oid=$(
            git -C "$repo" show-ref --verify --hash "$retirement_feature_ref" 2>/dev/null
        ); then
        if git -C "$repo" show-ref --verify --quiet "$retirement_feature_ref"; then
            fail_retirement RETIREMENT_BLOCKED "$retirement_local_error"
        fi
        summary_phase='post_verify'
        if ! verify_retirement_local_absent; then
            fail_retirement LOCAL_DELETE_UNVERIFIED "$retirement_verify_error"
        fi
        settle_absent_retirement_plan local
        summary_post_verify='passed'
        summary_remote_conclusion='local_branch_already_absent_verified'
        summary_retirement_result='ALREADY_ABSENT_VERIFIED'
        summary_mode_state='verified'
        summary_completed_through='post_verify'
        summary_next_action='none'
        return 0
    fi
    if [[ "$local_oid" != "$retirement_expected_oid" ]] || ! query_retirement_refs ||
        [[ "$retirement_integration_oid" != "$retirement_integration_oid_before" ]] ||
        ((retirement_feature_present != retirement_feature_present_before)) ||
        { ((retirement_feature_present == 1)) &&
            [[ "$retirement_feature_oid" != "$retirement_feature_oid_before" ]]; }; then
        fail_retirement RETIREMENT_BLOCKED \
            'delete 前 local/remote refs 已变化；expected-OID CAS gate 拒绝继续'
    fi

    summary_phase='local_mutation'
    if ! run_retirement_local_delete; then
        if [[ -n "${retirement_controller_error:-}" ]]; then
            if git -C "$repo" show-ref --verify --quiet "$retirement_feature_ref"; then
                fail_retirement RETIREMENT_BLOCKED "$retirement_controller_error"
            fi
            fail_retirement LOCAL_DELETE_UNVERIFIED "$retirement_controller_error"
        fi
        if git -C "$repo" show-ref --verify --quiet "$retirement_feature_ref"; then
            fail_retirement RETIREMENT_BLOCKED 'lease-bound local update-ref 删除被拒绝'
        fi
    fi

    summary_phase='post_verify'
    summary_post_verify='failed'
    if ! verify_retirement_local_absent; then
        fail_retirement LOCAL_DELETE_UNVERIFIED "$retirement_verify_error"
    fi
    summary_post_verify='passed'
    summary_remote_conclusion='local_branch_retired_verified'
    summary_retirement_result='LOCAL_BRANCH_RETIRED_VERIFIED'
    summary_mode_state='verified'
    summary_completed_through='post_verify'
    summary_next_action='none'
}

sync_remote_endpoint() {
    local name=$1 fetch_url push_url
    sync_error=''
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
        sync_error='sync requires configured remote names'; return 1;
    }
    if ! fetch_url=$(git -C "$repo" remote get-url --all "$name" 2>/dev/null) ||
        ! push_url=$(git -C "$repo" remote get-url --push --all "$name" 2>/dev/null) ||
        [[ -z "$fetch_url" || "$fetch_url" == *$'\n'* || "$push_url" != "$fetch_url" ]]; then
        sync_error='sync remote requires one identical fetch/push endpoint'; return 1
    fi
    sync_endpoint=$fetch_url
}

sync_query_ref() {
    local name=$1 output oid ref extra
    sync_error=''
    if ! output=$(git -C "$repo" ls-remote --quiet --refs "$name" "$sync_branch_ref" 2>/dev/null); then
        sync_error='sync live remote query failed'; return 1
    fi
    if [[ -z "$output" || "$output" == *$'\n'* ]]; then
        sync_error='sync requires one existing source and target branch'; return 1
    fi
    IFS=$'\t' read -r oid ref extra <<<"$output"
    if [[ "$ref" != "$sync_branch_ref" || -n "$extra" ]] ||
        ! validate_retirement_oid "$oid" 'remote branch OID'; then
        sync_error='sync remote branch identity is invalid'; return 1
    fi
    sync_observed_oid=$oid
}

sync_local_fingerprint() {
    git -C "$repo" symbolic-ref --quiet HEAD &&
        git -C "$repo" rev-parse --verify 'HEAD^{commit}' &&
        git -C "$repo" for-each-ref --format='%(refname) %(objectname) %(upstream)' refs/heads refs/tags &&
        git -C "$repo" ls-files --stage
}

sync_check_local_state() {
    local current
    check_resume_clean_state || { sync_error=$resume_target_error; return 1; }
    if ! current=$(sync_local_fingerprint) || [[ "$current" != "$sync_local_before" ]]; then
        sync_error='sync local HEAD, branches, tags, index or upstream changed'; return 1
    fi
    if ! sync_remote_endpoint "$sync_source_remote" ||
        [[ "$sync_endpoint" != "$sync_source_endpoint" ]] ||
        ! sync_remote_endpoint "$remote_arg" || [[ "$sync_endpoint" != "$sync_target_endpoint" ]]; then
        sync_error='sync configured remote endpoint changed'; return 1
    fi
}

sync_check_remote_state() {
    local expected_target=$1
    if ! sync_query_ref "$sync_source_remote"; then return 1; fi
    if [[ "$sync_observed_oid" != "$resume_expected_oid" ]]; then
        sync_error='sync source branch no longer equals the exact published OID'; return 1
    fi
    if ! sync_query_ref "$remote_arg"; then return 1; fi
    if [[ "$sync_observed_oid" != "$expected_target" ]]; then
        sync_error='sync target branch changed; inspect before retrying'; return 1
    fi
}

sync_published_branch_ref() {
    local normalized_branch normalized_ref current_head target_before sync_fetch_remote
    export GIT_OPTIONAL_LOCKS=0
    paths=()
    summary_phase='preflight'
    summary_commit_sha=$resume_expected_oid
    summary_commit_reused=true
    summary_commit_result='reused'
    summary_sync_source_remote=$sync_source_remote
    summary_sync_expected_target_oid=$sync_expected_target_oid
    if ! normalize_heads_ref "$remote_branch_arg" '--remote-branch'; then
        fail "$normalized_ref_error"
    fi
    sync_branch_ref=$normalized_ref
    if ! validate_retirement_oid "$resume_expected_oid" 'published OID' ||
        ! validate_retirement_oid "$sync_expected_target_oid" 'expected target OID'; then
        fail "$retirement_validation_error"
    fi
    [[ "$sync_source_remote" != "$remote_arg" ]] || fail 'sync source and target remote must differ'
    sync_remote_endpoint "$sync_source_remote" || fail "$sync_error"
    sync_source_endpoint=$sync_endpoint
    sync_remote_endpoint "$remote_arg" || fail "$sync_error"
    sync_target_endpoint=$sync_endpoint
    [[ "$sync_source_endpoint" != "$sync_target_endpoint" ]] ||
        fail 'sync source and target endpoints must differ'
    check_resume_clean_state || fail "$resume_target_error"
    sync_local_before=$(sync_local_fingerprint) || fail 'sync requires an attached existing local branch'
    current_head=$(git -C "$repo" rev-parse --verify 'HEAD^{commit}')
    summary_head_before=$current_head
    summary_branch=$(git -C "$repo" branch --show-current)
    summary_upstream=$(git -C "$repo" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || true)
    summary_worktree_before_state='clean'
    summary_push_target="$remote_arg:$sync_branch_ref"
    printf '\n== Sync an exact already-published branch ==\n'
    printf 'source: %s:%s\ntarget: %s:%s\npublished OID: %s\n' \
        "$sync_source_remote" "$sync_branch_ref" "$remote_arg" "$sync_branch_ref" "$resume_expected_oid"
    summary_phase='remote_preflight'
    sync_query_ref "$sync_source_remote" || fail "$sync_error"
    [[ "$sync_observed_oid" == "$resume_expected_oid" ]] ||
        fail 'sync source branch does not equal the exact published OID'
    sync_query_ref "$remote_arg" || fail "$sync_error"
    target_before=$sync_observed_oid
    if [[ "$target_before" != "$resume_expected_oid" ]]; then
        [[ "$target_before" == "$sync_expected_target_oid" ]] ||
            fail 'sync live target differs from expected target OID'
        for sync_fetch_remote in "$sync_source_remote" "$remote_arg"; do
            if ! run_git_remote_command 'git fetch --no-tags --no-write-fetch-head --refmap= <remote> <branch>' \
                git -C "$repo" fetch --no-tags --no-recurse-submodules --no-write-fetch-head --refmap= \
                    "$sync_fetch_remote" "$sync_branch_ref"; then
                fail 'sync exact branch fetch failed; no push attempted'
            fi
        done
        sync_check_remote_state "$target_before" || fail "$sync_error"
        git -C "$repo" merge-base --is-ancestor "$target_before" "$resume_expected_oid" ||
            fail 'sync target is not an ancestor of the published source; no force or merge is allowed'
        resume_publish_range="$target_before..$resume_expected_oid"
        resume_publish_commit_count=$(git -C "$repo" rev-list --count "$resume_publish_range")
        summary_publish_range=$resume_publish_range
        summary_publish_commit_count=$resume_publish_commit_count
        existing_publish_commit_output_override=''
        branch_publish_remote=$remote_arg
        normal_upstream_hash=$target_before
        load_fixture_exceptions
        validate_existing_publish_range || fail "$existing_range_error; no sync push attempted"
        sync_check_local_state || fail "$sync_error"
        sync_check_remote_state "$target_before" || fail "$sync_error"
        summary_completed_through='preflight'
        summary_remote_conclusion='published_source_fast_forward_ready'
        if ((dry_run == 1)); then
            sync_check_local_state || fail "$sync_error"
            summary_head_after=$current_head
            summary_head_unchanged=true
            summary_index_unchanged=true
            summary_worktree_unchanged=true
            summary_worktree_state='clean'
            summary_final_head=$current_head
            printf 'transaction: non-force push %s:%s -> %s; verify both live OIDs; preserve local HEAD/upstream\n' \
                "$resume_expected_oid" "$sync_branch_ref" "$remote_arg"
            summary_push_result='skipped_by_dry_run'
            summary_post_verify='skipped_by_dry_run'
            summary_status='success'
            summary_next_action='run_without_dry_run_after_review'
            return 0
        fi
        summary_phase='push'
        summary_default_failure_status='failed'
        summary_push_executed=true
        if run_branch_push false "$remote_arg" "$resume_expected_oid:$sync_branch_ref"; then
            summary_push_result='succeeded'
        else
            summary_push_result='uncertain'
            # Observe an uncertain remote mutation before deciding whether retry is safe.
            if ! sync_check_remote_state "$resume_expected_oid"; then
                fail "$sync_error; sync push outcome is unverified"
            fi
            summary_push_result='confirmed_after_uncertain'
        fi
    else
        ((fixture_exceptions_seen == 0)) || fail 'already-aligned sync does not consume fixture exceptions'
        summary_push_result='not_needed_already_aligned'
    fi
    summary_phase='post_verify'
    summary_post_verify='failed'
    sync_check_remote_state "$resume_expected_oid" || fail "$sync_error"
    sync_check_local_state || fail "$sync_error"
    summary_head_after=$current_head
    summary_head_unchanged=true
    summary_index_unchanged=true
    summary_worktree_unchanged=true
    summary_worktree_state='clean'
    summary_final_head=$current_head
    summary_final_remote_oid=$resume_expected_oid
    summary_post_verify='passed'
    summary_completed_through='post_verify'
    summary_remote_conclusion='source_and_target_exactly_aligned'
    summary_status='success'
    summary_next_action='none'
    printf 'post-verify: both live branch OIDs match; local HEAD/index/branches/tags/upstream unchanged\n'
}

